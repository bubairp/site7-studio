{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}

{% set headingAndContent = block.headingAndContent.one() %}
{% set imageTitleLink = block.imageTitleLink ?? [] %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}

{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.contentdata ?? '' %}

{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
{% set themeSwitche = null %}
{% if blockStyle is defined and blockStyle|length %}
	{% set blockStyleData = blockStyle.one() %}
	{% if blockStyleData.background is defined %}
		{% set backgroundEntry = blockStyleData.background.one() %}
		{% set themeSwitche = backgroundEntry.themeDark ?? null %}
	{% endif %}
{% endif %}

{% if imageTitleLink | length %}
	{{ bsResponsive(blockStyle, scopedSel) }}

	{% set isLogoTitleDisplay = block.logoTitleDisplay ?? false %}
	{% set displayMode = block.displayMode.value ?? 'sliderView' %}

	{% set columnPerRow = block.columnPerRow.value ?? 'md-2' %}
	{% set sliderSlidesMap = {
		'md-6': 2,
		'md-4': 3,
		'md-3': 4,
		'md-2': 6
	} %}
	{% set maxSlides = sliderSlidesMap[columnPerRow] ?? 5 %}

	{% if displayMode == 'Slider View' or displayMode == 'sliderView' %}
		<div class="py-10 md:py-12 lg:py-16 {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
			<div class="{{ containerWidth }}">
				{% if headingAndContent %}
					{% if headingAndContent.heading|length or headingAndContent.Description|length %}
						{% include "_components/header-content-block" %}
					{% endif %}
				{% endif %}

				<div class="swiper" data-swiper-options='{"slidesPerView": 2,"spaceBetween": 16,"loop": true,"autoplay": {"delay": 3000, "disableOnInteraction": false},"breakpoints": {"640": {"slidesPerView": {{ maxSlides > 3 ? 3 : maxSlides }}, "spaceBetween": 20},"1024": {"slidesPerView": {{ maxSlides > 4 ? 4 : maxSlides }}, "spaceBetween": 24},"1280": {"slidesPerView": {{ maxSlides }}, "spaceBetween": 24}}}'>
					<div class="swiper-wrapper">
						{% for index, item in imageTitleLink %}
							<div class="swiper-slide h-auto">
								<div class="group flex flex-col items-center justify-center h-full p-5 text-center tw-card">
									{% set hasLink = item.linkUrl is defined and item.linkUrl is not empty %}
									{% set hasImage = item.image is defined and item.image | length %}
									<div class="flex items-center justify-center w-full h-16 transition-all duration-300 filter grayscale opacity-60 group-hover:opacity-100 group-hover:grayscale-0 dark:brightness-150">
										{% if hasLink %}
											<a href="{{ item.linkUrl }}" target="_blank" class="block w-full h-full flex items-center justify-center">
										{% endif %}
										{% if hasImage %}
											{% if item.image.0.extension == "svg" %}
												{{ images.singleImg(item.image.0, 150, {}, 'max-h-12 w-auto object-contain transition-transform group-hover:scale-105 duration-300', { alt: 'logo' }) }}
											{% else %}
												{{ images.singleImg(item.image.0, 196, {'ratio': 2.578}, 'max-h-12 w-auto object-contain transition-transform group-hover:scale-105 duration-300') }}
											{% endif %}
										{% endif %}
										{% if hasLink %}
											</a>
										{% endif %}
									</div>
									{% if isLogoTitleDisplay and item.title is not empty %}
										<div class="pt-3 text-xs font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-wider transition-colors group-hover:text-primary">{{ item.title }}</div>
									{% endif %}
								</div>
							</div>
						{% endfor %}
					</div>
				</div>


			</div>
		</div>
	{% endif %}

	{% if displayMode == 'List View' or displayMode == 'listView' %}
		<div class="py-10 md:py-12 lg:py-16 {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
			<div class="{{ containerWidth }}">
				{% if headingAndContent %}
					{% if headingAndContent.heading|length or headingAndContent.Description|length %}
						{% include "_components/header-content-block" %}
					{% endif %}
				{% endif %}

				<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
					{% for index, item in imageTitleLink %}
						<div class="group flex flex-col items-center justify-center h-full p-5 text-center tw-card">
							{% set hasLink = item.linkUrl is defined and item.linkUrl is not empty %}
							{% set hasImage = item.image is defined and item.image | length %}
							<div class="flex items-center justify-center w-full h-16 transition-all duration-300 filter grayscale opacity-60 group-hover:opacity-100 group-hover:grayscale-0 dark:brightness-150">
								{% if hasLink %}
									<a href="{{ item.linkUrl }}" target="_blank" class="block w-full h-full flex items-center justify-center">
								{% endif %}
								{% if hasImage %}
									{% if item.image.0.extension == "svg" %}
										{{ images.singleImg(item.image.0, 150, {}, 'max-h-12 w-auto object-contain transition-transform group-hover:scale-105 duration-300', { alt: 'logo' }) }}
									{% else %}
										{{ images.singleImg(item.image.0, 196, {'ratio': 2.578}, 'max-h-12 w-auto object-contain transition-transform group-hover:scale-105 duration-300') }}
									{% endif %}
								{% endif %}
								{% if hasLink %}
									</a>
								{% endif %}
							</div>
							{% if isLogoTitleDisplay and item.title is not empty %}
								<div class="pt-3 text-xs font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-wider transition-colors group-hover:text-primary">{{ item.title }}</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			</div>
		</div>
	{% endif %}

	{% if displayMode == 'Grid View' or displayMode == 'gridView' %}
		{% set columnClassMap = {
			'md-6': 'md:grid-cols-2',
			'md-4': 'md:grid-cols-3',
			'md-3': 'md:grid-cols-4',
			'md-2': 'md:grid-cols-6'
		} %}
		{% set rowColsClass = columnClassMap[columnPerRow] ?? 'md:grid-cols-6' %}

		<div class="py-10 md:py-12 lg:py-16 {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
			<div class="{{ containerWidth }}">
				{% if headingAndContent %}
					{% if headingAndContent.heading|length or headingAndContent.Description|length %}
						{% include "_components/header-content-block" %}
					{% endif %}
				{% endif %}

				<div class="grid grid-cols-2 sm:grid-cols-3 {{ rowColsClass }} gap-4">
					{% for index, item in imageTitleLink %}
						<div class="group flex flex-col items-center justify-center h-full p-5 text-center tw-card">
							{% set hasLink = item.linkUrl is defined and item.linkUrl is not empty %}
							{% set hasImage = item.image is defined and item.image | length %}
							<div class="flex items-center justify-center w-full h-16 transition-all duration-300 filter grayscale opacity-60 group-hover:opacity-100 group-hover:grayscale-0 dark:brightness-150">
								{% if hasLink %}
									<a href="{{ item.linkUrl }}" target="_blank" class="block w-full h-full flex items-center justify-center">
								{% endif %}
								{% if hasImage %}
									{% if item.image.0.extension == "svg" %}
										{{ images.singleImg(item.image.0, 150, {}, 'max-h-12 w-auto object-contain transition-transform group-hover:scale-105 duration-300', { alt: 'logo' }) }}
									{% else %}
										{{ images.singleImg(item.image.0, 196, {'ratio': 2.578}, 'max-h-12 w-auto object-contain transition-transform group-hover:scale-105 duration-300') }}
									{% endif %}
								{% endif %}
								{% if hasLink %}
									</a>
								{% endif %}
							</div>
							{% if isLogoTitleDisplay and item.title is not empty %}
								<div class="pt-3 text-xs font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-wider transition-colors group-hover:text-primary">{{ item.title }}</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			</div>
		</div>
	{% endif %}
{% endif %}
