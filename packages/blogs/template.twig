{% import "_macros/images" as images %}
{% import "_macros/utils" as utils %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}

{% set generalEntry = craft.entries()
    .section('general')
    .type('general')
    .with(['button', 'background', 'spacing'])
    .one() 
%}

{% set searchParams = craft.app.request.getParam('search')|trim %}
{% set categoryParam = craft.app.request.getParam('category') %}
{% set selectedCategory = categoryParam ? categoryParam : null %}

{% set shortDescriptionLength = getenv('DISPLAY_SHORT_DESCRIPTION_LENGTH') %}

{% set headingAndContent = block.headingAndContent.one() %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}
{# {% set serviceStyles = block.serviceStyle.one() %} #}
{% set containerWidth = 'container mx-auto px-4' %}
{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.contentdata ?? '' %}
{% set paginationData = block.paginations.one() ?? '' %}
{% set relationQuery = block['selectBlogs'] ?? null %}
{% if relationQuery and relationQuery.count() %}
	{% set selectBlogs = relationQuery %}
{% else %}
	{% set selectBlogs = craft.entries.section('blogs') %}
{% endif %}

{% set selectBlogs = selectBlogs.with(['image', 'tags', 'blogCategories']) %}

{% set blockCssClasses = '' %}
{% set themeSwitche = '' %}

{# {% if searchParams %}
	{% set selectBlogs = block.selectBlogs.search(searchParams).search('title: ' ~ searchParams ~ ' OR shortDescription: ' ~ searchParams ~ ' OR tags: ' ~ searchParams) ?? [] %}
{% endif %} #}

{% if searchParams %}
	{% set term = searchParams|replace({'"':' '})|trim %}
	{% if term|length %}
		{% set selectBlogs = selectBlogs.search('*' ~ term ~ '*').orderBy('score') %}
	{% endif %}
{% endif %}


{% if selectedCategory %}
	{% set category = craft.entries().section('blogCategories').slug(selectedCategory).one() %}
	{% if category %}
		{% set selectBlogs = selectBlogs.relatedTo(category) %}
	{% endif %}
{% endif %}

{% if selectBlogs %}

	{% block structured_data %}
		{# Render schema only on the listing entry type and not on partial loads #}
		{% if entry is defined
				and entry.type is defined
				and entry.type.handle == 'standardPages'
				and (craft.app.request.getParam('partial') is empty)
		%}

			{# Pick the list we actually rendered on the page:
												- when paginated gridView: 'entries' is defined
												- otherwise fall back to 'selectBlogs' #}

			{% set posts = (selectBlogs is defined and selectBlogs|length) ? selectBlogs|slice(0, 2) : [] %}

			{# Build ItemList elements #}
			{% set listItems = [] %}
			{% for p in posts %}
				{% set listItems = listItems|merge([{
				"@type": "ListItem",
				"position": loop.index,
				"item": { "@id": p.url ~ "#post", "url": p.url }
			}]) %}
			{% endfor %}

			{# WebPage / CollectionPage + link to list and breadcrumb #}
			{% set webPage = {
			"@type": ["WebPage","CollectionPage"],
			"@id": entry.url ~ "#webpage",
			"url": entry.url,
			"name": entry.title,
			"mainEntity": { "@id": entry.url ~ "#list" },
			"breadcrumb": { "@id": entry.url ~ "#breadcrumb" }
			} %}

			{# ItemList describing the current page of posts #}
			{% set itemList = {
			"@type": "ItemList",
			"@id": entry.url ~ "#list",
			"name": "Blog posts",
			"numberOfItems": posts|length,
			"itemListElement": listItems
			} %}

			{# Breadcrumbs for rich results #}
			{% set breadcrumb = {
			"@type": "BreadcrumbList",
			"@id": entry.url ~ "#breadcrumb",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl() },
				{ "@type": "ListItem", "position": 2, "name": entry.title, "item": entry.url }
			]
			} %}

			<script type="application/ld+json">
				{{ {
				"@context": "https://schema.org",
				"@graph": [ webPage, itemList, breadcrumb ]
			}|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
			</script>
		{% endif %}
	{% endblock %}

	{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
	{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
	{% set themeSwitche = null %}

	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% if blockStyleData.background is defined %}
			{% set backgroundEntry = blockStyleData.background.one() %}
			{% set themeSwitche = backgroundEntry.themeDark ?? null %}
		{% endif %}
	{% endif %}

	{{ bsResponsive(blockStyle, scopedSel) }}
	<div class="py-10 md:py-12 lg:py-16 {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
		<div class="{{ containerWidth }}">
			{% if headingAndContent %}
				{% if headingAndContent.heading|length or headingAndContent.Description|length %}
					{% include "_components/header-content-block" %}
				{% endif %}
			{% endif %}

			{% if block.displayBlogFilter %}
				{% include "_components/_blog/searchBlog.twig" %}
			{% endif %}
			{% if selectBlogs|length %}

				{% set displayView = block.displayView.value ?? '' %}
				{% if displayView == 'gridView' %}

					{% set showNav = paginationData.displayPagination ?? false %}
					{% if showNav %}
						{% set perPage = (paginationData.records_per_page ?? 10) %}
						{% set navStyle = paginationData.paginationDisplayStyle ?? 'pagination' %}
						{% set query = selectBlogs.limit(perPage) %}
						{% paginate query as pageInfo, pageEntries %}
							{% set entries = pageEntries %}
						{% else %}
							{% set entries = selectBlogs %}
						{% endif %}

						{# {% set rowColsClass = columnClassMap[blogPerRow] ?? '3' %} #}

						{% if showNav and craft.app.request.getParam('partial') %}
							{% if showNav and craft.app.request.getParam('partial') %}
								<div class="js-chunk" data-next-url="{{ pageInfo.nextUrl ?? '' }}">
									{% for blog in pageEntries %}
										<article class="masonry-grid-item flex flex-col">
											{% include "_components/_blog/blogCard.twig" with { blog: blog } %}
										</article>
									{% endfor %}
								</div>
								{% exit %}
							{% endif %}
							{% exit %}
						{% endif %}

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-{{ block.blogPerRow.value }} gap-8 lg:gap-10" id="js-list">
							{% for blog in entries %}
								<article class="masonry-grid-item flex flex-col">
									{% include "_components/_blog/blogCard.twig" with { blog: blog } %}
								</article>
							{% endfor %}
						</div>

						{% if showNav %}
							{% if navStyle == 'loadMore' %}
								{% include "_components/loadMore" with {
							pageInfo: pageInfo,
							targetId: 'js-list',           
							partialQueryString: 'partial=1'
							} only %}
							{% else %}
								{% include "_components/pagination" with { pageInfo: pageInfo } only %}
							{% endif %}
						{% endif %}
					{% endif %}

					{% if displayView == 'sliderView' %}
						<div class="swiper" data-swiper-options='{{ utils.swiperConfig(block.blogPerRow.value, 32, true) }}'>
							<div class="swiper-wrapper pb-4">
								{% for blog in selectBlogs %}
									<div class="swiper-slide h-auto">
										{% include "_components/_blog/blogCard.twig" with { blog: blog } %}
									</div>
								{% endfor %}
							</div>
						</div>
					{% endif %}
				{% else %}
					<div class="text-center py-12 px-4 tw-card border-dashed bg-gray-50 dark:bg-gray-800/50 shadow-none">
						<div class="bg-gray-200 dark:bg-gray-700 rounded-full inline-flex items-center justify-center mb-4 shadow-sm w-20 h-20">
							<i class="ti ti-article-off text-3xl text-gray-500 dark:text-gray-400"></i>
						</div>
						<h2 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">{{ 'No blogs found.'|t }}</h2>
						<p class="mb-6 text-gray-500 dark:text-gray-400">{{ 'Try changing your search or filters.'|t }}</p>
						<a href="{{ siteUrl(craft.app.request.pathInfo) }}" class="tw-btn tw-btn-primary">{{ 'Clear Filters'|t }}</a>
					</div>
				{% endif %}
			</div>
		</div>
	{% endif %}
