{% import '_components/ctaButton' as buttons %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}
{% import "_macros/images" as images %}

{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid ?? '' %}
{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}

{% set heroBannerSliderItemHeading = block.heading %}
{% set heroBannerSliderItemDisplayTitle = block.displayTitle %}
{% set heroBannerSliderItemSubtitle = block.subtitle %}
{% set heroBannerSliderItemSwitchOffDes = block.switchOffDes %}
{% set heroBannerSliderItemDescription = block.description %}
{% set heroBannerSliderItemImageVideo = block.imageVideo %}
{% set heroBannerSliderItemImage = block.image.one() %}
{% set heroBannerSliderItemColorData = block.colorLibrary.one() %}
{% set heroBannerSliderItemColor = heroBannerSliderItemColorData.plainText ?? null %}
{% set heroBannerSliderItemColorCode = heroBannerSliderItemColorData.colorcode ?? null %}
{% set heroBannerSliderItemButton = block.button %}
{% set heroBannerSliderItemStyles = heroBannerSliderItemColorCode ? 'background-color: ' ~ heroBannerSliderItemColorCode ~ ' !important;' : '' %}
{% set heroBannerSliderItemStyles = heroBannerSliderItemImage ? heroBannerSliderItemStyles ~ 'background-image: url(\'' ~ images.bgImageUrl(heroBannerSliderItemImage)|trim ~ '\'); background-size: cover; ' : heroBannerSliderItemStyles %}
{% set heroBannerSliderItemDisplayCheckList = block.displayCheckList ?? null %}
{% set heroBannerSliderItemCheckListShow = block.checkListShowTable ?? null %}
{% set heroBannerSliderItemIntroduction = block.introduction ?? null %}

{% set themeSwitche = heroBannerSliderItemColorData.themeDark ?? true %}

{{ bsResponsive(blockStyle, scopedSel) }}
<section class="w-full py-10 md:py-12 lg:py-16 {{ blockType }}{{ block.uid }}-style {{ bsClasses(blockStyle) }}" style="{{ bsStyle(blockStyle) }}">
	<div class="container mx-auto">
		<div
			class="relative overflow-hidden rounded-2xl md:rounded-3xl shadow-sm hover:shadow-lg transition-shadow duration-300 {{ themeSwitche ? 'bg-dark text-white' : 'bg-secondary text-gray-900' }}" style="{{ heroBannerSliderItemStyles }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">

			{# Overlay for better text contrast if a background image is present #}
			{% if heroBannerSliderItemImage %}
				<div class="absolute inset-0 {{ themeSwitche ? 'bg-dark/60 mix-blend-multiply' : 'bg-white/60 mix-blend-screen' }} pointer-events-none"></div>
			{% endif %}

			<div
				class="relative z-10 px-6 py-12 md:p-16 xl:p-20 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

				{# Left Content: Heading & Description #}
				<div class="w-full lg:w-1/2 flex flex-col justify-center text-center lg:text-left">
					<h1 class="font-bold tracking-tight mb-4 block-heading-title">
						{{ heroBannerSliderItemHeading }}
					</h1>

					{% if heroBannerSliderItemSwitchOffDes and heroBannerSliderItemDescription %}
						<div class="block-description {{ themeSwitche ? 'text-gray-200' : 'text-gray-700' }}">
							{{ heroBannerSliderItemDescription }}
						</div>
					{% endif %}

					<div class="flex flex-wrap items-center justify-center lg:justify-start gap-4">
						{{ buttons.renderButton(heroBannerSliderItemButton) }}
					</div>
				</div>

				{# Right Content: Checklist #}
				{% if heroBannerSliderItemDisplayCheckList and heroBannerSliderItemCheckListShow|length > 0 %}
					<div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
						<ul class="flex flex-col gap-4 list-none m-0 p-0 w-full max-w-md">
							{% for checkListShow in heroBannerSliderItemCheckListShow %}
								<li class="flex items-center p-4 rounded-xl transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:transform-none bg-black/5 dark:bg-white/10 border border-black/5 dark:border-white/10 hover:bg-black/10 dark:hover:bg-white/20">
									<span class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-primary/10 dark:bg-primary/20 text-primary mr-4" aria-hidden="true">
										{% if checkListShow.iconClass %}
											<i class="{{ checkListShow.iconClass }} text-xl"></i>
										{% else %}
											<i class="ti ti-check text-xl"></i>
										{% endif %}
									</span>
									<span class="text-lg font-medium">
										{{ checkListShow.title }}
									</span>
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

			</div>
		</div>
	</div>
</section>
