{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}
{% set headingAndContent = block.headingAndContent.one() %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}
{% set containerWidth = 'container' %}
{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.contentdata ?? '' %}
{% set paginationData = block.paginations.one() ?? '' %}

{% set relationQuery = block['selectPortfolios'] ?? null %}
{% if relationQuery and relationQuery.count() %}
	{% set selectPortfolios = relationQuery.with(['image', 'tags', 'portfolioCategories']) %}
{% else %}
	{% set selectPortfolios = craft.entries.section('portfolios').with(['image', 'tags', 'portfolioCategories']) %}
{% endif %}

{% set blockCssClasses = '' %}
{% set themeSwitche = '' %}

{% if selectPortfolios %}
	{% block structured_data %}
		{% if entry is defined
				and entry.type is defined
				and entry.type.handle == 'standardPages'
				and (craft.app.request.getParam('partial') is empty)
		%}
			{% set posts = selectPortfolios|slice(0, 2) %}

			{% set listItems = [] %}
			{% for p in posts %}
				{% set listItems = listItems|merge([{
					"@type": "ListItem",
					"position": loop.index,
					"item": { "@id": p.url ~ "#post", "url": p.url }
				}]) %}
			{% endfor %}

			{% set webPage = {
				"@type": ["WebPage","CollectionPage"],
				"@id": entry.url ~ "#webpage",
				"url": entry.url,
				"name": entry.title,
				"mainEntity": { "@id": entry.url ~ "#list" },
				"breadcrumb": { "@id": entry.url ~ "#breadcrumb" }
			} %}

			{% set itemList = {
				"@type": "ItemList",
				"@id": entry.url ~ "#list",
				"name": "Portfolio posts",
				"numberOfItems": posts|length,
				"itemListElement": listItems
			} %}

			{% set breadcrumb = {
				"@type": "BreadcrumbList",
				"@id": entry.url ~ "#breadcrumb",
				"itemListElement": [
					{ "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl() },
					{ "@type": "ListItem", "position": 2, "name": entry.title, "item": entry.url }
				]
			} %}

			<script type="application/ld+json">
				{{ {
					"@context": "https://schema.org",
					"@graph": [ webPage, itemList, breadcrumb ]
				}|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
			</script>
		{% endif %}
	{% endblock %}

	{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
	{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% if blockStyleData.background is defined %}
			{% set backgroundEntry = blockStyleData.background.one() %}
			{% set themeSwitche = backgroundEntry.themeDark ?? null %}
		{% endif %}
	{% endif %}

	{{ bsResponsive(blockStyle, scopedSel) }}
	<div class="py-10 md:py-12 lg:py-16 {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
		<div class="{{ containerWidth }}">
			{% if headingAndContent %}
				{% if headingAndContent.heading|length or headingAndContent.Description|length %}
					{% include "_components/header-content-block" %}
				{% endif %}
			{% endif %}

			{% set displayView = block.displayView.value ?? '' %}
			{% if selectPortfolios.all() | length %}
				{% if displayView == 'gridView' or displayView == 'default' or displayView == '' %}

				{% set showNav = paginationData.displayPagination ?? false %}
				{% if showNav %}
					{% set perPage = (paginationData.records_per_page ?? 10) %}
					{% set navStyle = paginationData.paginationDisplayStyle ?? 'pagination' %}
					{% set query = selectPortfolios.limit(perPage) %}
					{% paginate query as pageInfo, pageEntries %}
					{% set entries = pageEntries %}
				{% else %}
					{% set entries = selectPortfolios.all() %}
				{% endif %}

				{% if showNav and craft.app.request.getParam('partial') %}
					<div class="js-chunk" data-next-url="{{ pageInfo.nextUrl ?? '' }}">
						{% for portfolio in pageEntries %}
							{% set cats = portfolio.portfolioCategories.all() %}
							{% set catTitles = [] %}
							{% for cat in cats %}
								{% set catTitles = catTitles|merge([cat.title]) %}
							{% endfor %}
							<article class="masonry-grid-item shuffle-item" data-groups='{{ catTitles|json_encode|raw }}'>
								{% include "_components/_portfolios/portfolioCard.twig" with { portfolio: portfolio } %}
							</article>
						{% endfor %}
					</div>
					{% exit %}
				{% endif %}

				{% set portfolio_categories = craft.categories().group('portfolioCategories').all() %}
				<div class="masonry-filterable">
					<ul class="masonry-filters flex flex-wrap justify-center items-center gap-2 pb-6 mb-4 list-none p-0">
						<li class="nav-item m-0">
							<a class="nav-link active inline-block px-5 py-2 text-sm font-semibold rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors border border-slate-200 dark:border-slate-700 [&.active]:bg-primary [&.active]:text-white [&.active]:border-primary no-underline" href="#" data-group="all">All</a>
						</li>
						{% for portfolio_category in portfolio_categories %}
							<li class="nav-item m-0">
								<a class="nav-link inline-block px-5 py-2 text-sm font-semibold rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors border border-slate-200 dark:border-slate-700 [&.active]:bg-primary [&.active]:text-white [&.active]:border-primary no-underline" href="#" data-group="{{ portfolio_category.title }}">{{ portfolio_category.title }}</a>
							</li>
						{% endfor %}
					</ul>
					<div class="masonry-grid" data-columns="{{ block.portfolioPerRow.value }}" id="js-list">
						{% for portfolio in entries %}
							{% set cats = portfolio.portfolioCategories.all() %}
							{% set catTitles = [] %}
							{% for cat in cats %}
								{% set catTitles = catTitles|merge([cat.title]) %}
							{% endfor %}
							<article class="masonry-grid-item flex flex-col" data-groups='{{ catTitles|json_encode|raw }}'>
								{% include "_components/_portfolios/portfolioCard.twig" with { portfolio: portfolio } %}
							</article>
						{% endfor %}
					</div>
				</div>

				{% if showNav %}
					{% if navStyle == 'loadMore' %}
						{% include "_components/loadMore" with {
							pageInfo: pageInfo,
							targetId: 'js-list',
							partialQueryString: 'partial=1'
						} only %}
					{% else %}
						{% include "_components/pagination" with { pageInfo: pageInfo } only %}
					{% endif %}
				{% endif %}

			{% endif %}

			{% if displayView == 'sliderView' %}
				<div class="swiper" data-swiper-options='{{ utils.swiperConfig(block.portfolioPerRow.value) }}'>
					<div class="swiper-wrapper pb-4">
						{% for portfolio in selectPortfolios.all() %}
							<div class="swiper-slide h-auto">
								{% include "_components/_portfolios/portfolioCard.twig" with { portfolio: portfolio } %}
							</div>
						{% endfor %}
					</div>
					<!-- Pagination (bullets) -->
					<div class="swiper-pagination relative bottom-0 mt-2 pt-6"></div>
				</div>
			{% endif %}
		{% else %}
			<div class="text-center py-12 px-4 tw-card border-dashed bg-gray-50 dark:bg-gray-800/50 shadow-none">
				<div class="bg-gray-200 dark:bg-gray-700 rounded-full inline-flex items-center justify-center mb-4 shadow-sm w-20 h-20">
					<i class="ti ti-photo-off text-3xl text-gray-500 dark:text-gray-400"></i>
				</div>
				<h2 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">{{ 'No portfolios found.'|t }}</h2>
				<p class="mb-6 text-gray-500 dark:text-gray-400">{{ 'Try changing your search or filters.'|t }}</p>
				<a href="{{ siteUrl(craft.app.request.pathInfo) }}" class="tw-btn tw-btn-primary">{{ 'Clear Filters'|t }}</a>
			</div>
		{% endif %}
		</div>
	</div>
{% endif %}
