{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "craftcms/ckeditor": "^4.2.0",
    "craftcms/cms": "^5.0.0",
    "craftcms/guest-entries": "^4.0.1",
    "doublesecretagency/craft-cpjs": "^3.0.0",
    "ether/seo": "^v5.0.0-rc5",
    "leowebguy/device-detect": "^3.0",
    "nystudio107/craft-code-field": "5.0.0",
    "nystudio107/craft-cookies": "^5.0.0",
    "nystudio107/craft-vite": "^5.0",
    "razorpay/razorpay": "^2.9",
    "remoteprogrammer/ai-chat": "*",
    "remoteprogrammer/htmlsitemap": "^2.0",
    "remoteprogrammer/payment-gateway": "*",
    "remoteprogrammer/simple-rp-menu": "^1.0.2",
    "ryssbowh/craft-prefetch": "3.0.0",
    "site7/studio": "*",
    "spicyweb/craft-embedded-assets": "^5.1",
    "stripe/stripe-php": "^19.3",
    "towardstudio/asset-locations": "^3.0",
    "vandres/craft-matrix-extended": "v3.5.0",
    "verbb/expanded-singles": "^3.0",
    "verbb/field-manager": "^4.0.2",
    "verbb/image-resizer": "^4.0",
    "vlucas/phpdotenv": "^5.4.0",
    "xpertbot/craft-wheelform": "^4.0"
  },
  "require-dev": {
    "codeception/codeception": "^5.0",
    "codeception/module-asserts": "^3.0",
    "craftcms/generator": "^2.0.0",
    "phpunit/phpunit": "^10.3",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    },
    {
      "type": "vcs",
      "url": "https://github.com/rpqa99/craft5-simple-menu.git"
    },
    {
      "type": "path",
      "url": "plugins/htmlsitemap",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "plugins/payment-gateway"
    },
    {
      "type": "path",
      "url": "plugins/ai-chat",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "plugins/site7-studio",
      "options": {
        "symlink": true
      }
    }
  ]
}
