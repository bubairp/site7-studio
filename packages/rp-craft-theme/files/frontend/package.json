{
  "name": "boikatha-frontend",
  "version": "1.0.0",
  "description": "Frontend assets compiled with Vite",
  "author": "RP",
  "scripts": {
    "clean": "../craft clear-caches/all && ../craft cache/flush-all",
    "clean:dist": "rm -rf ../web/themes/front/*",
    "dev": "vite",
    "build": "npm run clean:dist && vite build",
    "preview": "vite preview",
    "lint:js": "eslint \"src/**/*.js\"",
    "lint:js:fix": "eslint \"src/**/*.js\" --fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "dependencies": {
    "imagesloaded": "^5.0.0",
    "jarallax": "^2.2.1",
    "lazysizes": "^5.3.2",
    "lenis": "^1.3.23",
    "lightgallery": "^2.7.2",
    "parallax-js": "^3.1.0",
    "sass": "^1.32.11",
    "shufflejs": "^6.1.1",
    "simplebar": "^6.2.7",
    "smooth-scroll": "^16.1.3",
    "swiper": "^11.0.4"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.14.0",
    "@tailwindcss/vite": "^4.3.0",
    "alpinejs": "^3.14.0",
    "eslint": "^9.9.1",
    "postcss": "^8.5.15",
    "stylelint": "^16.9.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "tailwindcss": "^4.3.0",
    "vite": "^5.2.11"
  }
}
