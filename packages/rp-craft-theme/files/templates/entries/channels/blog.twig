{% extends "_layouts/entry" %}

{% block structured_data %}
	{% if blog %}
		{% set feature = blog.image|length ? blog.image.one() : null %}
		{% set logo    = generalEntry.logo|length ? generalEntry.logo.one() : null %}

		{% set data = {
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": blog.url
		},
		"headline": blog.title,
		"datePublished": blog.postDate|date('c'),
		"dateModified": (blog.dateUpdated is defined and blog.dateUpdated ? blog.dateUpdated|date('c') : blog.postDate|date('c')),
		"author": {
			"@type": "Person",
			"name": blog.authorName ?? 'Admin'
		},
		"publisher": {
			"@type": "Organization",
			"name": generalEntry.companyName ?? 'Site Name'
		}
		} %}

		{% if feature %}
			{% set data = data|merge({
			"image": [ feature.url ]
		}) %}
		{% endif %}

		{% if logo %}
			{% set publisher = data.publisher|merge({
					"logo": {
					"@type": "ImageObject",
					"url": logo.url
					}
				}) %}
			{% set data = data|merge({ "publisher": publisher }) %}
		{% endif %}
		<script type="application/ld+json">
			{{ data|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
		</script>
	{% endif %}
{% endblock %}

{% set blog = craft.entries()
    .section('blogs')
    .slug(craft.app.request.segment(2))
    .one() %}

{% block content %}

	{% set title = entry.title ?? '' %}
	{% set heading = entry.heading ?? '' %}
	{% set headingTags = entry.headingTags ?? 'h2' %}
	{% set align = entry.align ?? 'left' %}
	{% set contentData = entry.contentdata ?? '' %}
	{% set blockStyle = entry.blockStyle ?? [] %}
	{% set blockType = entry.type.handle ?? '' %}
	{% set blockTypeUid = block.uid  ?? '' %}
	{% set containerWidth = "container" %}
	{% set themeSwitche = "" %}

	{% set pageStyle = entry.pageStyle.one() %}
	{% from '_macros/page-style' import psClasses, psStyle, psResponsive %}
	{% set bodyClass = "site-bg-dark" %}
{% import "_macros/images" as images %}

	{% if blog %}


		{% set themeSwitche = pageStyle.themeColor ?? null %}

		<div class="{{ psClasses(entry.pageStyle) }} entry-{{ entry.id }}-style" style="{{ psStyle(entry.pageStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">
			{{ psResponsive(entry.pageStyle, '.entry-' ~ entry.id ~ '-style') }}
			{% cache using key 'bhd-' ~ blog.id ~ '-' ~ blog.dateUpdated.timestamp %}
			<div class="py-10 md:py-12 lg:py-16 standard-txt overflow-hidden">
				<div class="{{ (pageStyle ? pageStyle.SingleMatrixContainerWidth.value : 'container')|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					<h1 class="text-4xl font-light text-center pb-2 lg:pb-4 block-heading-title">{{ blog.title }}</h1>
					<div class="flex flex-wrap items-center justify-center -mt-2">
						{% set displayDate = blog.date ?? blog.postDate %}
						{% if displayDate %}
							<span class="text-sm tw-text-muted mt-2">{{ displayDate|date('M d, Y') }}</span>
						{% endif %}
						{% set blogCats = blog.blogCategories.all() %}
						{% if blogCats|length %}
							<span class="text-xs opacity-20 mt-2 mx-4">|</span>
							{% for cat in blogCats %}
								<a class="tw-badge bg-primary-subtle text-primary border-0 text-xs mt-2 mx-1" href="/blogs?category={{ cat.slug }}">{{ cat.title }}</a>
							{% endfor %}
						{% endif %}
						{% if blog.tags|length %}
							<span class="text-xs opacity-20 mt-2 mx-4">|</span>
							{% set tags = blog.tags.all() %}
							{% if tags %}
								{% for tag in tags %}
									<a class="tw-badge text-nav text-xs border border-gray-200 mt-2 mx-1">{{ tag.title }}</a>
								{% endfor %}
							{% endif %}
						{% endif %}
					</div>
				</div>
			</div>
			{% endcache %}
			{% include "_includes/page-banner/blog-banner.twig" %}

			{% include "_components/breadcrumbs" %}

			{% include "_includes/matrix-container" with {
				entry: blog,
				cache_key: 'entry-' ~ blog.id
				} 
			%}
			<div class="xl:pt-2 pb-4 md:mb-2 lg:mb-6 xl:mb-12 standard-txt overflow-hidden">
				<div class="{{ (pageStyle ? pageStyle.SingleMatrixContainerWidth.value : 'container')|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					{% if generalEntry.displayBlogReview is defined and generalEntry.displayBlogReview|length %}
						{% set activeUserReply = generalEntry.activeUserReplyBlog %}
						<div class="pb-12">
							{% include "_components/comments" with { commentHandler: 'blogReview', activeUserReply: activeUserReply, pageStyle: pageStyle } %}
						</div>
					{% endif  %}
					<div>
						<div class="border-t border-b border-gray-200 py-4 flex justify-end">
							<a href="/blogs" class="tw-btn tw-btn-sm text-sm lg:order-3 flex sm:inline-flex btn-{{ pageStyle ? pageStyle.buttonColor.value : 'primary' }}">
								<i class="ti ti-chevron-left text-2xl me-2 -ms-1"></i>Back to list</a>
						</div>
					</div>
				</div>
			</div>
			{% cache %}
			<div class="w-full overflow-hidden pt-4" style="background-color: {{ generalEntry.blogBackgroundColor.one().colorcode ?? '' }}">
				<div class="{{ generalEntry.blogRelatedContainerWidth.value|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					<div class="pb-12">
						{% include "_components/_blog/relatedBlogsCarousel" with { blog: blog } %}
					</div>
				</div>
			</div>
			{% endcache %}
		</div>

	{% endif %}
{% endblock %}
