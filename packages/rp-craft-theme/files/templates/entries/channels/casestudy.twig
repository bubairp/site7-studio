{% extends "_layouts/entry" %}

{% set casestudy = craft.entries()
    .section('casestudies')
    .slug(craft.app.request.segment(2))
    .one() %}

{% block structured_data %}
	{% if casestudy %}
		{% set feature = casestudy.featureImage|length ? casestudy.featureImage.one() : null %}
		{% set logo    = generalEntry.logo|length ? generalEntry.logo.one() : null %}

		{% set data = {
		"@context": "https://schema.org",
		"@type": "Article",
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": casestudy.url
		},
		"headline": casestudy.title,
		"datePublished": casestudy.postDate|date('c'),
		"dateModified": (casestudy.dateUpdated is defined and casestudy.dateUpdated ? casestudy.dateUpdated|date('c') : casestudy.postDate|date('c')),
		"author": {
			"@type": "Person",
			"name": casestudy.authorName ?? 'Admin'
		},
		"publisher": {
			"@type": "Organization",
			"name": generalEntry.companyName ?? 'Site Name'
		}
		} %}

		{% if feature %}
			{% set data = data|merge({
			"image": [ feature.url ]
		}) %}
		{% endif %}

		{% if logo %}
			{% set publisher = data.publisher|merge({
			"logo": {
			"@type": "ImageObject",
			"url": logo.url
			}
		}) %}
			{% set data = data|merge({ "publisher": publisher }) %}
		{% endif %}
		<script type="application/ld+json">
			{{ data|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
		</script>

	{% endif %}
{% endblock %}

{% block content %}

	{% set containerWidth = 'container' %}
	{% set blockTypeUid = '' %}
	{% set blockCssClasses = '' %}
	{% set bodyClass = "site-bg-dark" %}
	{% import "_macros/images" as images %}

	{% set pageStyle = entry.pageStyle.one() %}
	{% from '_macros/page-style' import psClasses, psStyle, psResponsive %}

	{% if casestudy %}


		{% set themeSwitche = pageStyle.themeColor ?? null %}

		<div class="{{ psClasses(entry.pageStyle) }} entry-{{ entry.id }}-style" style="{{ psStyle(entry.pageStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">{{ psResponsive(entry.pageStyle, '.entry-' ~ entry.id ~ '-style') }}<section class="py-10 md:py-12 lg:py-16 standard-txt overflow-hidden">
				<div class="{{ (pageStyle ? pageStyle.SingleMatrixContainerWidth.value : 'container')|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					<h1 class="text-5xl font-light text-center pb-2 lg:pb-4 block-heading-title">{{ casestudy.title }}</h1>
					<div class="flex flex-wrap items-center justify-center -mt-2">
						{% if casestudy.tags|length %}
							<span class="text-base text-dark me-2 font-bold">Skills:</span>
							{% set tags = casestudy.tags.all() %}
							{% if tags %}
								{% for tag in tags %}
									<a class="tw-badge text-nav text-xs border border-gray-200 me-2 my-1">{{ tag.title }}</a>
								{% endfor %}
							{% endif %}
						{% endif %}
					</div>
				</div>
			</section>

			{% include "_includes/page-banner/casestudy-banner.twig" %}

			{% include "_components/breadcrumbs" %}

			{% cache using key 'ch-' ~ casestudy.id ~ '-' ~ casestudy.dateUpdated.timestamp %}
			<div class="py-4 lg:pt-6 xl:pt-12 lg:pb-1 xl:pb-2 standard-txt">
				<div class="{{ (pageStyle ? pageStyle.SingleMatrixContainerWidth.value : 'container')|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					<div class="flex items-center no-underline pb-4">
						<h6 class="mb-0 tw-text-muted">
							<span class="text-dark uppercase">Industry:</span>{{ casestudy.industry }}</h6>
					</div>
					<div class="flex flex-wrap items-center justify-start -mt-2">
						{% if casestudy.tags|length %}
							<span class="text-base text-dark me-2 font-bold">Skills:</span>
							{% set tags = casestudy.tags.all() %}
							{% if tags %}
								{% for tag in tags %}
									<a class="tw-badge text-nav text-xs border border-gray-200 me-2 my-1">{{ tag.title }}</a>
								{% endfor %}
							{% endif %}
						{% endif %}
					</div>
				</div>
			</div>
			{% endcache %}

			{% include "_includes/matrix-container" with {
            entry: casestudy,
            cache_key: 'entry-' ~ casestudy.id
            } 
        %}
			{% cache %}
			<div class="xl:pt-2 pb-12 md:mb-2 lg:mb-6 xl:mb-12">
				<div class="{{ (pageStyle ? pageStyle.SingleMatrixContainerWidth.value : 'container')|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					<div>
						<div class="border-t border-b border-gray-200 py-4 flex justify-end">
							<a href="/casestudy" class="tw-btn tw-btn-sm text-sm lg:order-3 flex sm:inline-flex btn-{{ pageStyle ? pageStyle.buttonColor.value : 'primary' }}">
								<i class="ti ti-chevron-left text-2xl me-2 -ms-1"></i>Back to list</a>
						</div>
					</div>
				</div>
			</div>

			<div class="w-full overflow-hidden pt-4" style="background-color: {{ generalEntry.caseStudyBackgroundColor.one().colorcode ?? '' }}">
				<div class="{{ generalEntry.caseRelatedContainerWidth.value|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					<div class="pb-12">
						{% include "_components/_casestudies/relatedCaseStudyCarousel.twig" with { casestudy: casestudy } %}
					</div>
				</div>
			</div>
			{% endcache %}
		</div>

	{% endif %}
{% endblock %}
