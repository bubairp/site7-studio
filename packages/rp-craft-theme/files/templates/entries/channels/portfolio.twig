{% extends "_layouts/entry" %}
{% import "_macros/images" as images %}

{% set featureItems = entry.featureItemTable ?? [] %}
{% set portfolio = craft.entries()
    .section('portfolios')
    .slug(craft.app.request.segment(2))
    .one() %}

{% block structured_data %}
	{% if portfolio %}

		{% set feature = portfolio.featureImage|length ? portfolio.featureImage.one() : null %}
		{% set logo    = generalEntry.logo|length ? generalEntry.logo.one() : null %}

		{# Base object #}
		{% set data = {
        "@context": "https://schema.org",
        "@type": "Article",
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": portfolio.url
        },
        "headline": portfolio.title,
        "datePublished": portfolio.postDate|date('c'),
        "dateModified": (portfolio.dateUpdated is defined and portfolio.dateUpdated ? portfolio.dateUpdated|date('c') : portfolio.postDate|date('c')),
        "author": {
            "@type": "Person",
            "name": portfolio.authorName ?? 'Admin'
        },
        "publisher": {
            "@type": "Organization",
            "name": generalEntry.companyName ?? 'Site Name'
        }
        } %}

		{% if feature %}
			{% set data = data|merge({ "image": [ feature.url ] }) %}
		{% endif %}

		{% if logo %}
			{% set data = data|merge({
            "publisher": data.publisher|merge({
            "logo": {
                "@type": "ImageObject",
                "url": logo.url
            }
            })
        }) %}
		{% endif %}

		<script type="application/ld+json">
			{{ data|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
		</script>

	{% endif %}
{% endblock %}

{% block content %}

	{% set containerWidth = 'container' %}
	{% set blockTypeUid = '' %}
	{% set blockCssClasses = '' %}

	{% set pageStyle = entry.pageStyle.one() %}
	{% from '_macros/page-style' import psClasses, psStyle, psResponsive %}

	{% if portfolio %}


		{% set themeSwitche = pageStyle.themeColor ?? null %}

		<div class="{{ psClasses(entry.pageStyle) }} entry-{{ entry.id }}-style" style="{{ psStyle(entry.pageStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">{{ psResponsive(entry.pageStyle, '.entry-' ~ entry.id ~ '-style') }}
			{% cache using key 'phd-' ~ portfolio.id ~ '-' ~ portfolio.dateUpdated.timestamp %}
			<div class="py-10 md:py-12 lg:py-16 standard-txt">
				<div class="{{ (pageStyle ? pageStyle.SingleMatrixContainerWidth.value : 'container')|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">

					{% set clientLogos = portfolio.clientLogo.all() %}
						{% if clientLogos|length %}
							<div>
								{{ images.singleImg(clientLogos|first, 200, {'ratio': 3.5}, 'block mb-2 sm:mb-4') }}</div>
						{% endif %}
						<div class="pb-4 md:pb-6 lg:pb-12">
							<h1 class="text-6xl font-light mb-0">{{ portfolio.title }}</h1>
							<div>
								{% if portfolio.tags|length %}
									{% set tags = portfolio.tags.all() %}
									{% if tags %}
										{% for tag in tags %}
											<a class="tw-badge text-nav text-xs border border-gray-200 mt-2 me-1">{{ tag.title }}</a>
										{% endfor %}
									{% endif %}
								{% endif %}
							</div>
						</div>

					{% include "_includes/page-banner/portfolio-banner.twig" %}


					<div class="border-b border-gray-200 py-4 lg:py-6">
						<div>
							<p class="text-dark tw-text-lead mb-2 lg:mb-0 xl:mb-6 2xl:mb-12">{{ portfolio.shortDescription }}</p>
						</div>
						<div>
							<ul class="list-none p-0 m-0 mb-12">
								{% for row in featureItems %}
									{% if row.item is defined or row.col1 is defined %}
										<li class="mb-2">
											{{ row.item ?? row.col1 ?? '' }}:
											<span class="text-dark font-semibold ms-2">{{ (row.quantity ?? row.col2 ?? '')|raw }}</span>
										</li>
									{% endif %}
								{% endfor %}
							</ul>
						</div>
					</div>

					<div class="flex flex-wrap items-center justify-center -mt-2">
						{% if portfolio.date|length %}
							<span class="text-sm tw-text-muted mt-2">{{ portfolio.date|date('M d, Y') }}</span>
						{% endif %}
					</div>
				</div>
			</div>
			{% endcache %}

			{% include "_includes/matrix-container" with {
            entry: portfolio,
            cache_key: 'entry-' ~ portfolio.id
            } 
        %}

		</div>
		{# <div class="container mx-auto xl:pt-2 pb-12 md:mb-2 lg:mb-6 xl:mb-12">
																		            <div class="row justify-center">
																		                <div class="col-lg-12 col-xl-12">
																		                    <div class="border-top border-b border-gray-200 py-4 flex justify-end">
																		                        <a href="/portfolio" class="tw-btn tw-btn-primary tw-btn-sm fs-sm order-lg-3 flex sm:inline-flex">
																		                            <i class="ti ti-chevron-left fs-xl me-2 ms-n1"></i>Back to list</a>
																		                    </div>
																		                </div>
																		            </div>
																		        </div> #}

	{% endif %}
{% endblock %}
