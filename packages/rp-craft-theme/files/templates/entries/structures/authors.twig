{% extends "_layouts/matrix-content" %}
{% import "_macros/images" as images %}

{# Fetch author based on entry or URL segment #}
{% set author = entry ?? craft.entries().section('authors').slug(craft.app.request.segment(2)).one() %}

{% block before_content %}
	{% if author %}
		{# hideSectionLink ensures we don't link to a non-existent /authors index page #}
		{% include "_components/breadcrumbs" with { 
			element: author, 
			hideSectionLink: true 
		} %}
	{% endif %}
{% endblock %}

{% block content_title %}
	{% if author %}
		{% include "_includes/page-banner/author-banner.twig" %}
	{% endif %}
{% endblock %}

{% block before_content_matrix %}
	{% if author %}
		{# Biography Section #}
		{% if author.editorFull %}
			<section class="author-biography-section bg-white py-10 md:py-12 lg:py-16">
				<div class="container mx-auto lg:py-2">
					<h2 class="bio-title">{{ 'Biography'|t }}</h2>
					<div class="bio-content">{{ author.editorFull|raw }}</div>
				</div>
			</section>
		{% endif %}


		{# Matrix Container Content (Timeline, Awards, etc.) #}
		<div class="author-dynamic-content">
			{% include "_includes/matrix-container" with {
                entry: author,
                cache_key: 'author-matrix-v2-' ~ author.id
            } %}
		</div>
	{% endif %}
{% endblock %}

{% block content_matrix %}
	{# Handled in before_content_matrix to maintain Figma order #}
{% endblock %}
