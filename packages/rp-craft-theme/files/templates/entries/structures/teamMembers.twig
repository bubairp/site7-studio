{% extends "_layouts/entry" %}
{% import "_macros/images" as images %}
{% set teamMember = craft.entries()
    .section('teamMembers')
    .slug(craft.app.request.segment(2))
    .one() %}

{% set pageStyle = entry.pageStyle.one() %}

{% block content %}
	{% if teamMember %}


		{% set themeSwitche = pageStyle.themeColor ?? null %}
		{% from '_macros/page-style' import psClasses, psStyle, psResponsive %}

		{% include "_includes/page-banner/team-banner.twig" %}


		<div class="{{ psClasses(entry.pageStyle) }} entry-{{ entry.id }}-style" style="{{ psStyle(entry.pageStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">{{ psResponsive(entry.pageStyle, '.entry-' ~ entry.id ~ '-style') }}
			{% cache using key 'tmh-' ~ teamMember.id ~ '-' ~ teamMember.dateUpdated.timestamp %}
			{% include "_components/breadcrumbs" %}
			<div class="py-10 md:py-12 lg:py-16 standard-txt overflow-hidden">
				<div class="{{ (pageStyle ? pageStyle.SingleMatrixContainerWidth.value : 'container')|replace({'container-small': 'max-w-4xl mx-auto px-4', 'container': 'container mx-auto px-4'}) }}">
					<div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 lg:gap-16 items-start">
						<div class="md:col-span-4 lg:col-span-4">
							<div class="sticky top-24">
								<div class="relative rounded-2xl md:rounded-3xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-800 bg-gray-100 dark:bg-gray-800 aspect-[4/5]">
									{% if teamMember.image|length %}
										{{ images.singleImg(teamMember.image.one(), 800, {'ratio': 0.8}, 'w-full h-full object-cover transition-transform duration-700 hover:scale-105', { alt: teamMember.title }) }}
									{% else %}
										<div class="w-full h-full flex items-center justify-center text-gray-400">
											<i class="ti ti-user text-6xl"></i>
										</div>
									{% endif %}
								</div>
							</div>
						</div>
						<div class="md:col-span-8 lg:col-span-8 flex flex-col justify-center">
							<h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-2">{{ teamMember.title }}</h1>

							{% if teamMember.plainTextRole|length or teamMember.plainText|length %}
								<p class="text-lg md:text-xl font-medium text-primary mb-8 flex flex-wrap items-center gap-2">
									{% if teamMember.plainTextRole|length %}
										<span>{{ teamMember.plainTextRole }}</span>
									{% endif %}
									{% if teamMember.plainTextRole|length and teamMember.plainText|length %}
										<span class="text-gray-300 dark:text-gray-600 text-sm hidden sm:inline-block">|</span>
									{% endif %}
									{% if teamMember.plainText|length %}
										<span class="text-gray-600 dark:text-gray-400">{{ teamMember.plainText }}</span>
									{% endif %}
								</p>
							{% endif %}

							{% if teamMember.plainTextPhone|length or teamMember.email|length %}
								<div class="flex flex-col sm:flex-row gap-3 mb-10">
									{% if teamMember.plainTextPhone|length %}
										<a href="tel:{{ teamMember.plainTextPhone }}" class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-primary transition-colors bg-gray-50 dark:bg-gray-800/50 px-3 py-2 rounded-lg border border-gray-100 dark:border-gray-800">
											<i class="ti ti-phone text-primary"></i>
											<span class="font-medium">{{ teamMember.plainTextPhone }}</span>
										</a>
									{% endif %}
									{% if teamMember.email|length %}
										<a href="mailto:{{ teamMember.email }}" class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-primary transition-colors bg-gray-50 dark:bg-gray-800/50 px-3 py-2 rounded-lg border border-gray-100 dark:border-gray-800">
											<i class="ti ti-mail text-primary"></i>
											<span class="font-medium">{{ teamMember.email }}</span>
										</a>
									{% endif %}
								</div>
							{% endif %}

							{% if teamMember.description|length %}
								<div class="tw-rich-text text-gray-600 dark:text-gray-400 mb-10">
									{{ teamMember.description }}
								</div>
							{% endif %}

							{% set socialMedia = teamMember.socialMedia.all() %}
							{% if socialMedia|length %}
								<div class="flex flex-wrap items-center gap-3 pt-8 border-t border-gray-100 dark:border-gray-800">
									<span class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mr-2">Connect:</span>
									{% for social in socialMedia %}
										{% set platformName = social.linkUrl|replace({'https://': '', 'http://': '', 'www.': ''})|split('.')|first|capitalize %}
										<a href="{{ social.linkUrl }}" class="w-10 h-10 rounded-full flex items-center justify-center bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 {{ social.elementClass }}" aria-label="{{ platformName }} profile for {{ teamMember.title }}" target="_blank" rel="noopener noreferrer">
											{% if social.iconClass|length %}
												<i class="{{ social.iconClass }} text-lg"></i>
											{% elseif social.iconImage|length %}
												{{ images.singleImg(social.iconImage.one(), 32, {}, 'w-5 h-5 object-contain') }}
											{% endif %}
										</a>
									{% endfor %}
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>

			{% include "_includes/matrix-container" with {
                entry: teamMember,
                cache_key: 'entry-' ~ teamMember.id
                }
            %}
			{% endcache %}
		</div>
	{% endif %}
{% endblock %}
