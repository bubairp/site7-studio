{% extends "_layouts/matrix-content" %}
{% import "_macros/images" as images %}

{% set form_id = entry.selectForm.id  %}

{% block before_content_matrix %}
	{% set pageStyle = entry.pageStyle.one() %}
	{% set themeSwitche = pageStyle.themeColor ?? null %}
	{% from '_macros/page-style' import psClasses, psStyle, psResponsive %}

	{# Contact Content Section #}
	<section class="contact-content-section py-10 md:py-12 lg:py-16 {{ psClasses(entry.pageStyle) }} entry-{{ entry.id }}-style" style="{{ psStyle(entry.pageStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">
		{{ psResponsive(entry.pageStyle, '.entry-' ~ entry.id ~ '-style') }}
		<div class="container mx-auto">
			<div
				class="grid grid-cols-12 gap-6">
				{# Left Column: Info Cards #}
				<div class="col-span-12 lg:col-span-4">
					<div
						class="flex flex-col gap-6">
						{# Address Card #}
						{% if entry.showAddress and generalEntry.Description|length %}
							<div class="tw-card p-6">
								<div class="flex gap-4">
									<div class="w-12 h-12 shrink-0 rounded-full flex items-center justify-center bg-[linear-gradient(135deg,#d80101_0%,#ffc44e_100%)] text-white">
										<i class="ti ti-map-pin text-2xl"></i>
									</div>
									<div>
										<h4 class="text-base font-bold mb-0">{{ 'Address'|t }}</h4>
										<div class="mb-0 tw-text-muted text-sm">
											{{ generalEntry.Description|raw }}
										</div>
									</div>
								</div>
							</div>
						{% endif %}

						{# Email Card #}
						{% if entry.showEmail and generalEntry.email|length %}
							<div class="tw-card p-6">
								<div class="flex gap-4">
									<div class="w-12 h-12 shrink-0 rounded-full flex items-center justify-center bg-[linear-gradient(135deg,#d80101_0%,#ffc44e_100%)] text-white">
										<i class="ti ti-mail text-2xl"></i>
									</div>
									<div>
										<h4 class="text-base font-bold mb-0">{{ 'Email'|t }}</h4>
										<p class="mb-0 tw-text-muted">
											<a class="tw-text-muted no-underline" href="mailto:{{ generalEntry.email }}">{{ generalEntry.email }}</a>
										</p>
									</div>
								</div>
							</div>
						{% endif %}

						{# Phone Card #}
						{% if entry.showPhone and generalEntry.phoneNumber|length %}
							<div class="tw-card p-6">
								<div class="flex gap-4">
									<div class="w-12 h-12 shrink-0 rounded-full flex items-center justify-center bg-[linear-gradient(135deg,#d80101_0%,#ffc44e_100%)] text-white">
										<i class="ti ti-phone text-2xl"></i>
									</div>
									<div>
										<h4 class="text-base font-bold mb-0">{{ 'Phone'|t }}</h4>
										<p class="mb-0 tw-text-muted">
											<a class="tw-text-muted no-underline" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
										</p>
									</div>
								</div>
							</div>
						{% endif %}

						{# Timing Card #}
						{% if entry.showTiming and generalEntry.timing|length %}
							<div class="tw-card p-6">
								<div class="flex gap-4">
									<div class="w-12 h-12 shrink-0 rounded-full flex items-center justify-center bg-[linear-gradient(135deg,#d80101_0%,#ffc44e_100%)] text-white">
										<i class="ti ti-clock text-2xl"></i>
									</div>
									<div>
										<h4 class="text-base font-bold mb-0">{{ 'Office Hours'|t }}</h4>
										<div class="mb-0 tw-text-muted text-sm">
											{% for row in generalEntry.timing %}
												<div>{{ row.day }}:
													{{ row.startTime|date('h:i A') }}
													-
													{{ row.endTime|date('h:i A') }}</div>
											{% endfor %}
										</div>
									</div>
								</div>
							</div>
						{% endif %}

						{# Social Media Card #}
						<div class="tw-card bg-[linear-gradient(143deg,#d80101_0%,#019245_100%)] p-6 text-white border-0 hover:shadow-2xl">
							<h4 class="text-base font-bold text-white  mb-4">{{ 'Social Media'|t }}</h4>
							<div class="flex flex-col gap-2">
								{% set socialMedia = generalEntry.socialMedia.all() %}
								{% for social in socialMedia %}
									{% set platform = social.title|lower %}
									{% set iconClass = 'ti ti-brand-' ~ platform %}
									{% if platform == 'youtube' %}
										{% set iconClass = 'ti ti-brand-youtube' %}
									{% endif %}

									<a href="{{ social.linkUrl }}" class="transition-opacity duration-300 ease-in-out hover:opacity-80 text-white no-underline flex items-center gap-4" target="_blank" rel="noopener">
										<div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
											<i class="{{ iconClass }} text-xl"></i>
										</div>
										<span>{{ social.title }}</span>
									</a>
								{% endfor %}
							</div>
						</div>
					</div>
				</div>

				{# Right Column: Form #}
				<div class="col-span-12 lg:col-span-8">
					<div class="tw-card p-6 lg:p-12">
						<h4 class=" mb-6">{{ 'Send Us a Message'|t }}</h4>
						{% if form_id %}
							{% include "_forms/contact" %}
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block content_matrix %}
	{# Matrix content skipped here to match Figma layout order #}
{% endblock %}

{% block before_end_body_tag %}
	{{ parent() }}
	{{ craft.vite.script('src/js/pages/contact.js') }}
{% endblock %}
