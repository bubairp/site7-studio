{% extends "_layouts/matrix-content" %}

{% block structured_data %}

    {% set googleLocalBusinessData = craft.entries()
						.section('googleStructureData')
						.one()
    %}

    {% if googleLocalBusinessData is not empty %}
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "{{ googleLocalBusinessData.businessType }}",
                "image": [
                    "{{ googleLocalBusinessData.imageUrl }}"
                ],
                "name": "{{ googleLocalBusinessData.businessName }}",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "{{ googleLocalBusinessData.streetAddress is not empty ? googleLocalBusinessData.streetAddress : '' }}",
                    "addressLocality": "{{ googleLocalBusinessData.addressLocality is not empty ? googleLocalBusinessData.addressLocality : '' }}",
                    "addressRegion": "{{ googleLocalBusinessData.addressRegion is not empty ? googleLocalBusinessData.addressRegion : '' }}",
                    "postalCode": "{{ googleLocalBusinessData.postalCode is not empty ? googleLocalBusinessData.postalCode : '' }}",
                    "addressCountry": "{{ googleLocalBusinessData.addressCountry is not empty ? googleLocalBusinessData.addressCountry : '' }}"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": "{{ googleLocalBusinessData.latitude is not empty ? googleLocalBusinessData.latitude : '' }}",
                    "longitude": "{{ googleLocalBusinessData.longitude is not empty ? googleLocalBusinessData.longitude : '' }}"
                },
                "telephone": "{{ googleLocalBusinessData.telephone is not empty ? googleLocalBusinessData.telephone : '' }}"
            }
        </script>
    {% endif %}

{% endblock %}

{% import "_macros/images" as images %}
{% set bodyClasses = 'home' %}

{% block header_banner %}
	{# Key the cache on the home entry's dateUpdated so adding/swapping a hero image
	   and saving the page reliably busts it (a bare {% cache %} can serve a stale
	   slider — including a placeholder transform captured before the new image). #}
	{% cache using key 'home-hero-' ~ entry.id ~ '-' ~ entry.dateUpdated.timestamp %}
	{% set heroBannerSliders = entry.heroBannerSlider.all() %}
	{% if heroBannerSliders | length  >0 %}<div class="header-banner">
			{% include "_includes/hero-banner/index" %}
		</div>
	{% endif %}
	{% endcache %}

{% endblock %}

{% block before_end_body_tag %}
    {{ parent() }}
    {{ craft.vite.script('src/js/pages/home.js') }}
{% endblock %}
