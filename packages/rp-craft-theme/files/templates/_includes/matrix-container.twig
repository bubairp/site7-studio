{% import '_macros/visibility.twig' as visibility %}

{# Uses "is defined", not the ?? operator, to distinguish "matrixContainer
   was never passed to this include" from "matrixContainer was explicitly
   passed as null/empty" - ?? treats both the same, which previously made a
   caller that explicitly passes an empty field (e.g. entry.site7Components
   on an entry with no content in it) silently fall back to entry.matrixContent
   and render it a second time, instead of correctly rendering nothing. #}
{% set matrixContentField = matrixContainer is defined ? matrixContainer : (entry is defined and entry ? entry.matrixContent : null) %}
{% if matrixContentField %}
	{% set matrixContainerData = matrixContentField
        .with([
            'blockStyle',
            'headingAndContent',
            'authorSpotlight:selectAuthor.image',
            'authorSpotlight:selectAuthor.featureImage',
            'authorSpotlight:headingAndContent',
            'services:selectServices.image',
            'teams:selectTeamMembers.image',
            'testimonials:selectTestimonials.image'
        ])
        .all()
    %}
{% else %}
	{% set matrixContainerData = [] %}
{% endif %}
{% if matrixContainerData is defined and matrixContainerData|length %}
	<div class="matrix-container">
		{% for index, itemField in matrixContainerData %}
			{% set blockStyle = itemField.blockStyle.one() ?? null %}
			{% set customClasses = blockStyle.cssClasses ?? '' %}
			<div class="{{ itemField.type.handle }} entry-type {{ visibility.classes(blockStyle, itemField) }} {{ customClasses }}" id="entry-block-{{ id_prefix ?? '' }}{{ index }}">
				{# Listing blocks read request params (search / category) and paginate, so their
				   output depends on the query string. The {% cache %} tag is scoped to the path
				   only, which would serve the same cached grid for every search/filter. Render
				   them fresh; cache everything else, keyed on the block + style + entry so that
				   editing the page (e.g. swapping a matrix block image) busts the cache. #}
				{% set dynamicBlocks = ['products', 'blogs', 'casestudies', 'portfolios'] %}
				{% set item_cache_key = 'entry-type-' ~ index ~ '-' ~ cache_key ~ '-' ~ itemField.id ~ '-' ~ itemField.dateUpdated.timestamp ~ (blockStyle ? '-' ~ blockStyle.dateUpdated.timestamp : '') %}
				{% if itemField.type.handle in dynamicBlocks %}
					{% include "_blocks/" ~ itemField.type.handle with { block: itemField } %}
				{% else %}
					{% cache using key item_cache_key %}
						{% include "_blocks/" ~ itemField.type.handle with { block: itemField } %}
					{% endcache %}
				{% endif %}
			</div>
		{% endfor %}
	</div>
{% endif %}
