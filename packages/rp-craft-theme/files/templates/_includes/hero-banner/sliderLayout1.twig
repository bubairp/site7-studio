{% import '_components/ctaButton' as buttons %}
{% import "_macros/images" as images %}

{% if heroBannerSliders | length  >0 %}<section
		class="relative top-0 inset-s-0 py-0 w-full h-full" data-theme="light">
		<!-- Background image slider -->
		<div class="swiper swiper-scale-effect min-h-screen" data-swiper-options='{ "effect": "fade", "speed": 800, "autoplay": {"delay": 7000,"disableOnInteraction": false }, "pagination": {"el": ".swiper-pagination","clickable": true }}'>
			<div class="swiper-wrapper">
				{% for heroBannerSlider in heroBannerSliders %}

					{% set heroBannerSliderHeading = heroBannerSlider.heading %}
					{% set heroBannerSliderDisplayTitle = heroBannerSlider.displayTitle %}
					{% set heroBannerSliderSubtitle = heroBannerSlider.subtitle %}
					{% set heroBannerSliderSwitchOffDes = heroBannerSlider.switchOffDes %}
					{% set heroBannerSliderDescription = heroBannerSlider.description %}
					{% set heroBannerSliderImageVideo = heroBannerSlider.imageVideo %}

					{% set heroBannerSliderImageVideoMob = heroBannerSlider.bgImageVideoMobile %}

					{% set heroBannerThemeDark = heroBannerSlider.themeDark ?? false %}
					{% set textClass = heroBannerThemeDark ? 'text-white' : 'text-black' %}
					{% set subtitleBgClass = heroBannerThemeDark ? 'bg-white/20' : 'bg-black/10' %}

					{% set heroBannerSliderImage = heroBannerSlider.image.one() %}
					{% set heroBannerSliderColorData = heroBannerSlider.colorLibrary.one() %}
					{% set heroBannerSliderColor = heroBannerSliderColorData.plainText ?? null %}
					{% set heroBannerSliderColorCode = heroBannerSliderColorData.colorcode ?? null %}
					{% set heroBannerSliderButton = heroBannerSlider.button %}
					{% set heroBannerSliderStyles = heroBannerSliderColorCode ? 'background-color: ' ~ heroBannerSliderColorCode ~ ' !important;' : '' %}
					{% set heroBannerSliderStyles = (heroBannerSliderImage and heroBannerSliderImage.url) ? heroBannerSliderStyles ~ 'background-image: url(\'' ~ images.bgImageUrl(heroBannerSliderImage)|trim ~ '\'); background-size: cover; ' : heroBannerSliderStyles %}
					{% set heroBannerSliderDisplayCheckList = heroBannerSlider.displayCheckList ?? null %}
					{% set heroBannerSliderCheckListShow = heroBannerSlider.checkListShowTable ?? null %}
					{% set heroBannerSliderIntroduction = heroBannerSlider.introduction ?? null %}

					<div class="swiper-slide h-auto lg:h-full bg-white">
						<div class="grid grid-cols-1 lg:grid-cols-2 h-full w-full">
							
							<!-- Left Column: Content -->
							<div class="{% if not heroBannerSliderColorCode %}bg-white {% endif %}flex flex-col justify-center px-8 lg:px-16 xl:px-24 py-16 lg:py-0 relative z-10 order-2 lg:order-1" {% if heroBannerSliderColorCode %}style="background-color: {{ heroBannerSliderColorCode }};"{% endif %}>
								<div class="w-full max-w-xl mx-auto lg:mx-0 text-center lg:text-left">
									{% if heroBannerSliderDisplayTitle %}
										<span class="inline-flex items-center px-4 py-1 tw-text-md font-semibold rounded-full {{ subtitleBgClass }} {{ textClass }} border-none">{{ heroBannerSliderSubtitle }}</span>
									{% endif %}
									
									{% set bannerHeadingTag = loop.first ? 'h1' : 'h2' %}
									<{{ bannerHeadingTag }} class="text-3xl md:text-4xl lg:text-5xl font-bold {{ textClass }} uppercase py-3 my-2">{{heroBannerSliderHeading}}</{{ bannerHeadingTag }}>
									
									{% if heroBannerSliderSwitchOffDes %}
										<div class="text-lg pb-2 lg:pb-4 {{ textClass }}">{{ heroBannerSliderDescription }}</div>
									{% endif %}
									
									{% if heroBannerSliderDisplayCheckList is defined and heroBannerSliderDisplayCheckList and heroBannerSliderCheckListShow | length > 0 %}
										<ul class="list-none table text-left mx-auto lg:mx-0 mb-0">
											{% for checkListShow in heroBannerSliderCheckListShow %}
												<li class="flex mb-2 {{ textClass }}">
													{% if checkListShow.iconClass is defined and checkListShow.iconClass %}
														<i class="{{ checkListShow.iconClass }} text-primary text-2xl -mt-1 me-2"></i>
													{% endif %}
													{% if checkListShow.title is defined and checkListShow.title %}
														{{ checkListShow.title }}
													{% endif %}
												</li>
											{% endfor %}
										</ul>
									{% endif %}

									<div class="flex flex-wrap justify-center lg:justify-start gap-3 mt-6">
										{{ buttons.renderButton(heroBannerSliderButton) }}
									</div>
								</div>
							</div>

							<!-- Right Column: Media -->
							<div class="relative w-full h-[50vh] lg:h-full lg:min-h-screen order-1 lg:order-2 bg-neutral-900">
								{% set desktopMedia = heroBannerSliderImageVideo.one() ?? null %}
								{% set mobileMedia = heroBannerSliderImageVideoMob.one() ?? null %}
								
								{% set displayDesktopClass = mobileMedia ? 'hidden lg:block' : 'block' %}
								{% set displayMobileClass = 'block lg:hidden' %}

								<!-- Desktop Media -->
								{% if desktopMedia %}
									<div class="{{ displayDesktopClass }} absolute inset-0 w-full h-full">
										{% if desktopMedia.kind == 'video' %}
											<video class="w-full h-full object-cover pointer-events-none" autoplay loop muted="muted" playsinline>
												<source src="{{ desktopMedia.url }}" type="{{ desktopMedia.mimeType }}">
											</video>
										{% elseif desktopMedia.kind == 'json' %}
											{% set embedded = craft.embeddedAssets.get(desktopMedia) %}
											{% if embedded %}
												<div class="w-full h-full pointer-events-none overflow-hidden [&>iframe]:absolute [&>iframe]:top-1/2 [&>iframe]:left-1/2 [&>iframe]:-translate-x-1/2 [&>iframe]:-translate-y-1/2 [&>iframe]:w-[max(100vw,177.77vh)] [&>iframe]:h-[max(100vh,56.25vw)] [&>iframe]:max-w-none">{{ embedded.getIframeCode(['autoplay=1', 'loop=1', 'muted=1', 'mute=1', 'controls=0', 'background=1'])|raw }}</div>
											{% endif %}
										{% else %}
											<div class="w-full h-full bg-cover bg-center" style="background-image: url('{{ images.bgImageUrl(desktopMedia)|trim }}');"></div>
										{% endif %}
									</div>
								{% endif %}

								<!-- Mobile Media -->
								{% if mobileMedia %}
									<div class="{{ displayMobileClass }} absolute inset-0 w-full h-full">
										{% if mobileMedia.kind == 'video' %}
											<video class="w-full h-full object-cover pointer-events-none" autoplay loop muted="muted" playsinline>
												<source src="{{ mobileMedia.url }}" type="{{ mobileMedia.mimeType }}">
											</video>
										{% elseif mobileMedia.kind == 'json' %}
											{% set embedded = craft.embeddedAssets.get(mobileMedia) %}
											{% if embedded %}
												<div class="w-full h-full pointer-events-none overflow-hidden [&>iframe]:absolute [&>iframe]:top-1/2 [&>iframe]:left-1/2 [&>iframe]:-translate-x-1/2 [&>iframe]:-translate-y-1/2 [&>iframe]:w-[max(100vw,177.77vh)] [&>iframe]:h-[max(100vh,56.25vw)] [&>iframe]:max-w-none">{{ embedded.getIframeCode(['autoplay=1', 'loop=1', 'muted=1', 'mute=1', 'controls=0', 'background=1'])|raw }}</div>
											{% endif %}
										{% else %}
											<div class="w-full h-full bg-cover bg-center" style="background-image: url('{{ images.bgImageUrl(mobileMedia, 768)|trim }}');"></div>
										{% endif %}
									</div>
								{% endif %}
							</div>
							
						</div>
					</div>

				{% endfor %}
			</div>
			{% set firstSlideDark = heroBannerSliders[0].themeDark ?? false %}
			<div class="swiper-pagination swiper-pagination-overlay mb-6" style="--swiper-bullet-bg: {{ firstSlideDark ? 'rgba(255,255,255,0.4)' : 'rgba(0,0,0,0.4)' }}; --swiper-bullet-active-bg: {{ firstSlideDark ? '#ffffff' : '#000000' }};"></div>
		</div>

	</section>

{% endif %}
