{% import '_components/ctaButton' as buttons %}
{% import "_macros/images" as images %}

{% if heroBannerSliders | length  >0 %}
	<style>
		.hero-slider-3 .swiper-wrapper {
			align-items: stretch !important;
		}
		.hero-slider-3 .swiper-slide {
			height: auto !important;
			display: flex !important;
			flex-direction: column !important;
		}
		.hero-slider-3 .tw-bg-neutral {
			flex: 1 1 auto !important;
			width: 100% !important;
		}
	</style>
	<section
		class="relative top-0 inset-s-0 py-0 w-full h-full hero-slider-3">
		<div class="swiper" data-swiper-options='{"speed": 800,"autoplay": {"delay": 7000,"disableOnInteraction": false},"pagination": {"el": ".swiper-pagination","clickable": true}}'>
			<div class="swiper-wrapper">

				{% for heroBannerSlider in heroBannerSliders %}
					{% set heroBannerSliderHeading = heroBannerSlider.heading %}
					{% set heroBannerSliderDisplayTitle = heroBannerSlider.displayTitle %}
					{% set heroBannerSliderSubtitle = heroBannerSlider.subtitle %}
					{% set heroBannerSliderSwitchOffDes = heroBannerSlider.switchOffDes %}
					{% set heroBannerSliderDescription = heroBannerSlider.description %}
					{% set heroBannerSliderImageVideo = heroBannerSlider.imageVideo %}
					{% set heroBannerSliderImage = heroBannerSlider.image.one() %}
					{% set heroBannerSliderColorData = heroBannerSlider.colorLibrary.one() %}
					{% set heroBannerSliderColor = heroBannerSliderColorData.plainText ?? null %}
					{% set heroBannerSliderColorCode = heroBannerSliderColorData.colorcode ?? null %}
					{% set heroBannerSliderButton = heroBannerSlider.button %}
					{% set heroBannerSliderStyles = heroBannerSliderColorCode ? 'background-color: ' ~ heroBannerSliderColorCode ~ ' !important;' : '' %}
					{% set heroBannerSliderStyles = (heroBannerSliderImage and heroBannerSliderImage.url) ? heroBannerSliderStyles ~ 'background-image: url(\'' ~ images.bgImageUrl(heroBannerSliderImage)|trim ~ '\'); background-size: cover; ' : heroBannerSliderStyles %}

					{% set heroBannerThemeDark = heroBannerSlider.themeDark ?? false %}
					{% set textClass = heroBannerThemeDark ? 'text-white' : 'text-black' %}
					{% set heroBannerSliderDisplayCheckList = heroBannerSlider.displayCheckList ?? null %}
					{% set heroBannerSliderCheckListShow = heroBannerSlider.checkListShowTable ?? null %}
					{% set heroBannerSliderIntroduction = heroBannerSlider.introduction ?? null %}


					<div class="swiper-slide h-auto flex flex-col">
						<div class="tw-bg-neutral relative overflow-hidden py-10 md:py-12 lg:py-20 px-3 sm:px-4 xl:px-12 w-full flex-grow" style="background-color: {{ heroBannerSliderColorCode }} !important;" data-theme="{{ heroBannerThemeDark ? 'dark' : 'light' }}">
							
							{% set heroBannerSliderMedia = heroBannerSliderImageVideo.one() ?? null %}
							{% if heroBannerSliderMedia %}
								{% if heroBannerSliderMedia.kind == 'video' %}
									<video class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none" autoplay loop muted="muted" playsinline>
										<source src="{{ heroBannerSliderMedia.url }}" type="{{ heroBannerSliderMedia.mimeType }}">
									</video>
								{% elseif heroBannerSliderMedia.kind == 'json' %}
									{% set embedded = craft.embeddedAssets.get(heroBannerSliderMedia) %}
									{% if embedded %}
										<div class="absolute inset-0 w-full h-full z-0 pointer-events-none overflow-hidden [&>iframe]:absolute [&>iframe]:top-1/2 [&>iframe]:left-1/2 [&>iframe]:-translate-x-1/2 [&>iframe]:-translate-y-1/2 [&>iframe]:w-[max(100vw,177.77vh)] [&>iframe]:h-[max(100vh,56.25vw)] [&>iframe]:max-w-none">{{ embedded.getIframeCode(['autoplay=1', 'loop=1', 'muted=1', 'mute=1', 'controls=0', 'background=1'])|raw }}</div>
									{% endif %}
								{% else %}
									<div class="absolute inset-0 w-full h-full bg-cover bg-center z-0 pointer-events-none" style="background-image: url('{{ images.bgImageUrl(heroBannerSliderMedia)|trim }}');"></div>
								{% endif %}
							{% endif %}

							<!-- Cinematic Vignette Overlay -->
							<div class="absolute inset-0 w-full h-full bg-gradient-to-r from-black/80 via-black/30 to-black/80 z-0"></div>
							<div class="absolute inset-0 w-full h-full bg-gradient-to-b from-black/50 via-transparent to-black/60 z-0"></div>
							
							<div class="container mx-auto px-4 relative z-20 xl:pt-8 2xl:pt-12 sm:pb-2 {{ textClass }} drop-shadow-md">
								<div class="grid grid-cols-12 gap-4 md:pt-4 lg:pt-12">
									<div class="col-span-12 lg:col-span-6 2xl:col-span-5 lg:pb-12 xl:mb-12">
										{% set bannerHeadingTag = loop.first ? 'h1' : 'h2' %}
										<{{bannerHeadingTag}} class="text-3xl md:text-4xl lg:text-5xl font-light text-center lg:text-left 2xl:mb-12">{{heroBannerSliderHeading}}</{{bannerHeadingTag}}>
									</div>
									<div class="col-span-12 lg:col-span-5 lg:col-start-8 flex flex-col pt-2 md:pt-4">
										<div class="tw-text-base-content text-xl text-center lg:text-left pb-2 md:pb-0 mb-4">
											{% if heroBannerSliderSwitchOffDes %}
												<div class="tw-text-base-content text-xl pb-2 md:pb-0 mb-3">{{ heroBannerSliderDescription }}</div>
											{% endif %}
										</div>
										<div class="flex flex-wrap flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pb-3 sm:pb-12">{{ buttons.renderButton(heroBannerSliderButton) }}</div>
										{% if heroBannerSliderDisplayCheckList is defined and heroBannerSliderDisplayCheckList  and heroBannerSliderCheckListShow | length >0 %}
											<ul class="list-none xl:flex text-center lg:text-left mt-auto mb-0 sm:mb-2 flex-wrap">
												{% for checkListShow in heroBannerSliderCheckListShow %}
													<li class="inline-flex items-center tw-text-base-content whitespace-nowrap pt-1 w-full md:w-1/2">
														{% if checkListShow.iconClass is defined and checkListShow.iconClass %}
															<i class="text-primary text-xl me-2 {{ checkListShow.iconClass }}"></i>
														{% endif %}
														{% if checkListShow.title is defined and checkListShow.title %}
															{{ checkListShow.title }}
														{% endif %}
													</li>
												{% endfor %}
											</ul>
										{% endif %}
									</div>
								</div>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
			<!-- Pagination -->
			<div class="swiper-pagination swiper-pagination-overlay mb-6" style="--swiper-bullet-bg: rgba(255,255,255,0.4); --swiper-bullet-active-bg: #ffffff;"></div>
		</div>
	</section>

{% endif %}
