{% import "_macros/images" as images %}
{% import '_macros/utils' as utils %}
<!-- Footer-->
<div class="footer-main {{ footerClasses }} relative py-10 md:py-12 lg:py-16 bg-white dark:bg-dark text-gray-900 dark:text-white border-t border-gray-100 dark:border-gray-800 transition-colors duration-300" {% if themeSwitche %} data-theme="dark" {% endif %}>
	<div class="hidden dark:block absolute top-0 left-0 w-full h-full bg-white/5 pointer-events-none"></div>
	<div
		class="{{ footerContainerWidth }} relative pt-4 pb-2">
		<!-- Columns with links -->
		<div class="grid grid-cols-1 md:grid-cols-12 gap-0 md:gap-8 lg:gap-12 {{ footerVerticalAlign }}" id="links">
			<div class="md:col-span-3 xl:col-span-2" x-data="{ open: false }">
				{% set col1MenuHandle = footer.footerMenuCol1 ?? 'footerMenuCol1' %}
				{% set col1MenuObj = craft.simplerpmenu.getMenu(col1MenuHandle) %}
				<button @click="open = !open" :aria-expanded="open.toString()" class="w-full flex items-center justify-between text-base md:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white md:cursor-default md:pointer-events-none py-4 md:py-0 md:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 md:border-none text-left">
					<span>{{ col1MenuObj ? col1MenuObj.name|t : 'Useful links'|t }}</span>
					<i :class="{'rotate-180': open}" class="ti ti-chevron-down w-5 h-5 flex items-center justify-center transition-transform md:hidden text-slate-500" aria-hidden="true"></i>
				</button>
				<div :class="{'hidden': !open}" class="hidden md:block pt-4 pb-6 md:p-0 mb-4 md:mb-0">
					{{ craft.simplerpmenu.getRpMenuHTML(col1MenuHandle,{ 'menu-id': 'footerMenuCol1','menu-class':'','ul-class':'flex flex-col text-sm pb-2 md:pb-0 p-0 gap-1','li-class':'list-none', 'link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block'}) }}
				</div>
			</div>
			<div class="md:col-span-3 xl:col-span-2" x-data="{ open: false }">
				{% set col2MenuHandle = footer.footerMenuCol2 ?? 'footerMenuCol2' %}
				{% set col2MenuObj = craft.simplerpmenu.getMenu(col2MenuHandle) %}
				<button @click="open = !open" :aria-expanded="open.toString()" class="w-full flex items-center justify-between text-base md:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white md:cursor-default md:pointer-events-none py-4 md:py-0 md:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 md:border-none text-left">
					<span>{{ col2MenuObj ? col2MenuObj.name|t : 'Decors'|t }}</span>
					<i :class="{'rotate-180': open}" class="ti ti-chevron-down w-5 h-5 flex items-center justify-center transition-transform md:hidden text-slate-500" aria-hidden="true"></i>
				</button>
				<div :class="{'hidden': !open}" class="hidden md:block pt-4 pb-6 md:p-0 mb-4 md:mb-0">
					{{ craft.simplerpmenu.getRpMenuHTML(col2MenuHandle,{ 'menu-id': 'footerMenuCol2','menu-class':'','ul-class':'flex flex-col text-sm pb-2 md:pb-0 p-0 gap-1','li-class':'list-none', 'link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block'}) }}
				</div>
			</div>
			<div class="md:col-span-3 xl:col-span-2" x-data="{ open: false }">
				{% set col3MenuHandle = footer.footerMenuCol3 ?? 'footerMenuCol3' %}
				{% set col3MenuObj = craft.simplerpmenu.getMenu(col3MenuHandle) %}
				<button @click="open = !open" :aria-expanded="open.toString()" class="w-full flex items-center justify-between text-base md:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white md:cursor-default md:pointer-events-none py-4 md:py-0 md:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 md:border-none text-left">
					<span>{{ col3MenuObj ? col3MenuObj.name|t : 'Categories'|t }}</span>
					<i :class="{'rotate-180': open}" class="ti ti-chevron-down w-5 h-5 flex items-center justify-center transition-transform md:hidden text-slate-500" aria-hidden="true"></i>
				</button>
				<div :class="{'hidden': !open}" class="hidden md:block pt-4 pb-6 md:p-0 mb-4 md:mb-0">
					{{ craft.simplerpmenu.getRpMenuHTML(col3MenuHandle,{ 'menu-id': 'footerMenuCol3','menu-class':'','ul-class':'flex flex-col text-sm pb-2 md:pb-0 p-0 gap-1','li-class':'list-none', 'link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block'}) }}
				</div>
			</div>
			<div class="md:col-span-3">
				<div x-data="{ open: false }" class="w-full">
					<button @click="open = !open" :aria-expanded="open.toString()" class="w-full flex items-center justify-between text-base md:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white md:cursor-default md:pointer-events-none py-4 md:py-0 md:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 md:border-none text-left">
						<span>{{ 'Address'|t }}</span>
						<i :class="{'rotate-180': open}" class="ti ti-chevron-down w-5 h-5 flex items-center justify-center transition-transform md:hidden text-slate-500" aria-hidden="true"></i>
					</button>
					<div :class="{'hidden': !open}" class="hidden md:block pt-4 pb-6 md:p-0 mb-4 md:mb-0">
						<ul class="flex flex-col text-sm pb-6 p-0 gap-1">
							{% if generalEntry.Description %}
								<li class="last-0 list-none mb-2 text-slate-600 dark:text-slate-400 leading-relaxed">{{ generalEntry.Description }}</li>
							{% endif %}
							<li class="list-none">
								<a class="text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 no-underline transition-all duration-300 hover:translate-x-1 inline-block" href="mailto:{{generalEntry.email}}">{{generalEntry.email}}</a>
							</li>
							{% if generalEntry.phoneNumber %}
								<li class="list-none">
									<a class="text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 no-underline transition-all duration-300 hover:translate-x-1 inline-block" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
								</li>
							{% endif %}
						</ul>
						{% if footerDisplayOfficeTiming and officeTiming and officeTiming|length >0 %}<h3 class="mb-5 text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Office Timing</h3>
								<ul class="list-none mb-0 pb-3 md:pb-0 p-0 flex flex-col">
									{% for officeTime in officeTiming %}
										<li class="flex justify-between items-center text-sm mb-2 pb-2 border-b border-dashed border-slate-200 dark:border-slate-700 last:border-0 last:pb-0 last:mb-0">
											<span class="font-medium text-slate-700 dark:text-slate-300">{{officeTime.day}}</span>
											<span class="text-slate-500 dark:text-slate-400">
												{{ utils.formatTime24Hour(officeTime.startTime) }} - {{ utils.formatTime24Hour(officeTime.endTime) }}
											</span>
										</li>
									{% endfor %}
								</ul>
						{% endif %}
					</div>
				</div>
			</div>
			<div class="md:col-span-12 xl:col-span-3">
				{% if footerDisplayDownloadApp %}
					<div class="pt-8 md:pt-4 xl:pt-0 mb-8 md:mb-12 xl:mb-0">
						<h3 class="mb-4 md:mb-5 text-base md:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white pb-1">Download our app</h3>
						<div class="flex flex-wrap gap-4 xl:block xxl:tw-flex">
							{% if appLinksEntry is defined %}
								{% include '_components/ctaLinksImage' %}
							{% endif %}
						</div>
					</div>
				{% endif %}

				{# Legacy subscribe section removed in favor of full-width newsletter #}
			</div>
		</div>

		<!-- Nav + Switcher -->
		<div
			class="sm:flex items-center justify-between border-0 border-b border-dashed border-slate-200 dark:border-slate-800 mt-6 pt-6 md:pt-12 pb-6 sm:pb-8">
			<!-- Nav -->
			<nav class="flex mb-4 sm:mb-0 justify-center sm:justify-start">{{ craft.simplerpmenu.getRpMenuHTML('footermenu',{ 'menu-id': 'footermenu','menu-class':'','ul-class':'flex flex-wrap justify-center sm:justify-start mb-0 p-0','li-class':'list-none','link-class':'text-slate-600 dark:text-slate-400 hover:text-primary text-sm font-medium ps-0 pe-2 py-2 sm:me-4 no-underline transition-colors'}) }}</nav>

			<p class="text-[13px] text-center sm:text-right text-slate-500 dark:text-slate-400 mb-3 sm:mb-4">&copy; {{ now|date('Y') }} {{ siteName }} - All Rights Reserved</p>
		</div>

		<!-- Logo + Socials + Cards -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between pt-8 sm:pt-10 gap-6 sm:gap-0">
			<div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-12">
				<a class="inline-flex items-center transition-transform duration-300 hover:scale-105" href="/" style="text-decoration: none !important;">
					{% set siteFooterLogo = generalEntry.footerLogo.0 ?? generalEntry.logo.0 ?? null %}
					{% if footerDisplayLogo and siteFooterLogo %}
						<img src="{{ siteFooterLogo.url }}" alt="logo" class="max-h-12 md:max-h-16">
					{% endif %}
				</a>
				<div class="flex">
					{% if footerDisplaySocial %}
						{% include '_components/social' %}
					{% endif %}
				</div>
			</div>
			<div class="flex justify-start sm:justify-end">
				{{ images.singleImg(generalEntry.acceptedCards.0, 187, {ratio: 6.678}, '') }}
			</div>
		</div>
