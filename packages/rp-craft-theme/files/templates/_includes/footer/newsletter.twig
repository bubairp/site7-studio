<section
	class="newsletter-section bg-primary relative overflow-hidden py-12 md:py-16 text-white">
	{# Background decorations #}
	<div class="absolute bg-white/5 blur-3xl rounded-full w-[384px] h-[384px] top-1/2 left-[-192px] -translate-y-1/2 z-10 pointer-events-none"></div>
	<div class="absolute inset-0 bg-no-repeat pointer-events-none z-10 newsletter-pattern"></div>

	<div
		class="newsletter-container relative z-20 text-center container max-w-[960px] mx-auto px-4">
		{# Badge #}
		<div class="newsletter-badge inline-flex items-center justify-center rounded-full gap-1 py-2 px-4 bg-white/10 text-white mb-4">
			<i class="ti ti-mail"></i>
			<span class="text-sm font-semibold">{{ 'Newsletter'|t }}</span>
		</div>

		{# Heading #}
		<h2 class="newsletter-title text-white mx-auto text-3xl md:text-5xl font-bold mb-4 max-w-[800px] leading-tight">{{ 'Subscribe for new book updates'|t }}</h2>

		{# Description #}
		<p class="text-base md:text-lg text-white/90 mb-10">{{ 'Get new book reviews and suggestions in your email every week'|t }}</p>

		{# Form Response Wrapper #}
		<div id="newsletter-response-wrapper" class="hidden rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 mb-6 mx-auto max-w-2xl">
			<div class="flex flex-col items-center text-center py-8 px-6">
				<h3 class="font-bold text-white text-xl mb-2">{{ 'Thank you!'|t }}</h3>
				<p class="text-white/80 m-0" id="newsletter-response-message"></p>
			</div>
		</div>

		{% set form = wheelform.form({ 
			id: 2,
			submitButton: false
		}) %}
		{% if form %}
			{{ form.open("", {
				'class': 'needs-validation newsletter-form-container mt-4 mb-4 w-full max-w-2xl mx-auto',
				'data-ajax': 'true',
				'data-success-wrapper': 'newsletter-response-wrapper',
				'data-success-message-id': 'newsletter-response-message',
				'data-loading-text': 'Loading...'|t,
				'data-recaptcha-key': getenv('RECAPTCHA_SITE_KEY')
			}, "POST") }}
			{{ wheelform.getRecaptchaV3() }}
			<div class="newsletter-form-group flex flex-col md:flex-row items-center gap-2 p-2 bg-white rounded-2xl shadow-2xl w-full">
				<div class="w-full flex-1">
					{% for field in form.fields %}
						{% if field.type == 'honeypot' or field.name == 'rp_field' %}
							<div style="display:none;">
								<input type="text" name="{{ field.name }}" value="" autocomplete="off" tabindex="-1">
							</div>
						{% elseif field.type != 'hidden' %}
							<input type="email" name="{{ field.name }}" class="w-full h-14 px-4 bg-gray-100 rounded-xl text-gray-900 placeholder:text-gray-500 border-none focus:outline-hidden focus:ring-0" placeholder="{{ 'Enter your email address'|t }}" aria-label="{{ field.label }}" required>
						{% endif %}
					{% endfor %}
				</div>

				<button class="tw-btn tw-btn-primary tw-btn-lg wf-submit-btn w-full md:w-auto border-none" type="submit">
					<span class="button-text font-semibold text-base">{{ 'Subscribe'|t }}</span>
					<svg class="hidden tw-loading animate-spin ms-2 w-5 h-5 text-white" role="status" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
				</button>
			</div>
			<div class="wf-error tw-text-error text-left mt-2 px-3" data-field="email" style="display: none;"></div>
		</form>
	{% else %}
		<p class="text-warning mt-4 text-center">Newsletter form is not configured correctly (Form ID 2 not found).</p>
	{% endif %}

	{# Disclaimer #}
	<p class="text-sm text-white/70 text-center mt-4">{{ 'We will never share your email. You can unsubscribe at any time.'|t }}</p>

	{# Stats #}
	<div class="newsletter-stats border-0 border-t border-solid border-white/20 mt-10 pt-10 max-w-3xl mx-auto">
		<div class="flex flex-col md:flex-row divide-y md:divide-y-0 md:divide-x divide-white/20 w-full bg-transparent text-white">
			<div class="flex flex-col flex-1 items-center py-4 md:py-0">
				<div class="font-bold text-3xl md:text-4xl">{{ '5000+'|t }}</div>
				<div class="opacity-80 text-white/80 text-sm md:text-base mt-1">{{ 'Subscribers'|t }}</div>
			</div>
			<div class="flex flex-col flex-1 items-center py-4 md:py-0">
				<div class="font-bold text-3xl md:text-4xl">{{ 'Weekly'|t }}</div>
				<div class="opacity-80 text-white/80 text-sm md:text-base mt-1">{{ 'New Reviews'|t }}</div>
			</div>
			<div class="flex flex-col flex-1 items-center py-4 md:py-0">
				<div class="font-bold text-3xl md:text-4xl">{{ '100%'|t }}</div>
				<div class="opacity-80 text-white/80 text-sm md:text-base mt-1">{{ 'Free'|t }}</div>
			</div>
		</div>
	</div>
</div>

<style>
	.wf-error:not(:empty) {
		display: block !important;
	}
	.newsletter-form-container.was-validated .newsletter-form-group:has(:invalid) ~ .wf-error {
		display: block !important;
	}
</style>
</section>
