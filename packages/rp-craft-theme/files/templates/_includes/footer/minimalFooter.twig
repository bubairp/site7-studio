{% import "_macros/images" as images %}
{% import '_macros/utils' as utils %}
<!-- Footer-->
<div class="footer-main {{ footerClasses }} relative pb-4 pt-3 lg:py-4 xl:py-20 bg-white dark:bg-slate-900 text-slate-900 dark:text-white" {% if themeSwitche %} data-theme="dark" {% endif %}>
	<div class="{{ footerContainerWidth }}">
		<div class="border-0 border-b border-dashed border-slate-200 dark:border-slate-800 text-center pb-6 md:pb-8">
			{% set siteFooterLogo = generalEntry.footerLogo.0 ?? generalEntry.logo.0 ?? null %}
			{% if footerDisplayLogo and siteFooterLogo %}
				<a class="inline-flex py-0 mb-6 md:mb-8 transition-transform duration-300 hover:scale-105" href="/" style="text-decoration: none !important;">
					<img src="{{ siteFooterLogo.url }}" alt="logo" class="max-h-12 md:max-h-16">
				</a>
			{% endif %}
			{% set footerMenu = footer.footerMenu ?? 'footerMenu' %}
			{{ craft.simplerpmenu.getRpMenuHTML(footerMenu,{ 'menu-id': 'footerMenu','menu-class':'','ul-class':'flex flex-wrap justify-center gap-3 sm:gap-6 md:gap-8 p-0 mb-0','li-class':'list-none','link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-2 px-1 sm:px-2 transition-all duration-300 hover:-translate-y-0.5 no-underline'}) }}
			{% if footer.description %}
				<div class="text-sm md:text-base text-slate-500 dark:text-slate-400 mt-5 md:mt-6 px-4 md:px-0 max-w-2xl mx-auto leading-relaxed">{{ footer.description }}</div>
			{% endif %}
		</div>

		<div class="flex flex-col sm:flex-row items-center justify-between pt-6 md:pt-8 gap-4 sm:gap-0">
			<div class="flex justify-center gap-4 sm:order-2">
				{% if footerDisplaySocial %}
					{% include '_components/social' %}
				{% endif %}
			</div>

			<p class="text-[13px] md:text-sm text-slate-500 dark:text-slate-400 sm:order-1 justify-center mb-0 text-center sm:text-left">&copy; {{ now|date('Y') }} {{ siteName }} - All Rights Reserved</p>
		</div>
	</div>
</div>
