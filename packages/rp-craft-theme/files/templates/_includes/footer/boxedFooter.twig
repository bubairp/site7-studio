{% import "_macros/images" as images %}
{% import '_macros/utils' as utils %}
{% import '_components/ctaButton' as buttons %}
<!-- Footer --><style>
	.last-0 > *:last-child {
		margin-bottom: 0;
	}
</style><div class="w-full md:px-20 pt-4 pb-2 md:pb-20 sm:pt-20">
	<div class="footer-main rounded-3xl relative overflow-hidden w-full px-3 sm:px-4 xl:px-20 mx-auto py-12 bg-white dark:bg-slate-900 text-slate-900 dark:text-white {{ footerClasses }}" style="max-width: 1660px;" {% if themeSwitche %} data-theme="dark" {% endif %}>
		<div class="container relative z-2 md:pt-3 lg:pt-4 xl:pt-5 pb-2">
			<div class="flex flex-col sm:flex-row flex-wrap gap-0 sm:gap-6 md:gap-8 lg:gap-12 pb-2">
				<div class="w-full lg:w-1/3 xxl:tw-w-1/4">
					<div class="py-0 me-0 pb-1">
						{% set siteFooterLogo = generalEntry.footerLogo.0 ?? generalEntry.logo.0 ?? null %}
						{% if footerDisplayLogo and siteFooterLogo %}
							<a class="inline-block mb-8 transition-transform duration-300 hover:scale-105" href="/" style="text-decoration: none !important;">
								<img src="{{ siteFooterLogo.url }}" alt="logo" class="max-h-12 md:max-h-16">
							</a>
						{% endif %}
					</div>
					{% if footer.description %}
						<div class="text-sm mb-6 text-slate-500 dark:text-slate-400 leading-relaxed">{{ footer.description }}</div>
					{% endif %}
					{% if footerDisplaySubscribe %}
						<div class="flex flex-col sm:flex-row rounded-full overflow-hidden border border-slate-200 dark:border-slate-800 shadow-sm">
							<input class="w-full px-5 py-2.5 bg-transparent outline-hidden text-sm placeholder-slate-400" type="text" placeholder="Email address">
							<button class="px-6 py-2.5 bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition-colors uppercase tracking-wider" type="button">Subscribe</button>
						</div>
					{% endif %}
				</div>
				<div class="w-full sm:w-1/4 lg:w-2/12 lg:ms-auto mb-4 md:mb-0" x-data="{ open: false }">
					{% set col1MenuHandle = footer.footerMenuCol1 ?? 'footerMenuCol1' %}
					{% set col1MenuObj = craft.simplerpmenu.getMenu(col1MenuHandle) %}
					<button @click="open = !open" class="w-full flex items-center justify-between text-base sm:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white sm:cursor-default sm:pointer-events-none py-4 sm:py-0 sm:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 sm:border-none text-left">
						<span>{{ col1MenuObj ? col1MenuObj.name|t : 'Page links'|t }}</span>
						<svg :class="{'rotate-180': open}" class="w-5 h-5 transition-transform sm:hidden text-slate-500" fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
					</button>
					<div :class="{'hidden': !open}" class="hidden sm:block pt-4 pb-6 sm:p-0">
						{{ craft.simplerpmenu.getRpMenuHTML(col1MenuHandle,{ 'menu-id': 'footerMenuCol1','menu-class':'','ul-class':'flex flex-col text-sm p-0 gap-1','li-class':'list-none', 'link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block'}) }}
					</div>
				</div>
				<div class="w-full sm:w-1/4 lg:w-2/12 mb-4 md:mb-0" x-data="{ open: false }">
					{% set col2MenuHandle = footer.footerMenuCol2 ?? 'footerMenuCol2' %}
					{% set col2MenuObj = craft.simplerpmenu.getMenu(col2MenuHandle) %}
					<button @click="open = !open" class="w-full flex items-center justify-between text-base sm:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white sm:cursor-default sm:pointer-events-none py-4 sm:py-0 sm:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 sm:border-none text-left">
						<span>{{ col2MenuObj ? col2MenuObj.name|t : 'Useful links'|t }}</span>
						<svg :class="{'rotate-180': open}" class="w-5 h-5 transition-transform sm:hidden text-slate-500" fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
					</button>
					<div :class="{'hidden': !open}" class="hidden sm:block pt-4 pb-6 sm:p-0">
						{{ craft.simplerpmenu.getRpMenuHTML(col2MenuHandle,{ 'menu-id': 'footerMenuCol2','menu-class':'','ul-class':'flex flex-col text-sm p-0 gap-1','li-class':'list-none', 'link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block'}) }}
					</div>
				</div>
				<div class="w-full sm:w-1/4 lg:w-3/12 xl:w-2/12">
					{% if footerDisplayContactInfo %}
						<div class="w-full" x-data="{ open: false }">
							<button @click="open = !open" class="w-full flex items-center justify-between text-base sm:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white sm:cursor-default sm:pointer-events-none py-4 sm:py-0 sm:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 sm:border-none text-left">
								<span>{{ 'Contact Info'|t }}</span>
								<svg :class="{'rotate-180': open}" class="w-5 h-5 transition-transform sm:hidden text-slate-500" fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
							</button>
							<div :class="{'hidden': !open}" class="hidden sm:block pt-4 pb-6 sm:p-0 mb-6 md:mb-0">
								<ul class="flex flex-col text-sm p-0 gap-1">
									{% if generalEntry.Description %}
										<li class="last-0 list-none mb-3 text-slate-600 dark:text-slate-400 leading-relaxed">{{ generalEntry.Description }}</li>
									{% endif %}
									{% if generalEntry.email %}
										<li class="list-none">
											<a class="text-slate-600 dark:text-slate-400 hover:text-primary font-medium px-0 py-1 no-underline transition-all duration-300 hover:translate-x-1 inline-block" href="mailto:{{ generalEntry.email }}" style="text-decoration: none !important;">{{ generalEntry.email }}</a>
										</li>
									{% endif %}
									{% if generalEntry.phoneNumber %}
										<li class="list-none">
											<a class="text-slate-600 dark:text-slate-400 hover:text-primary font-medium px-0 py-1 no-underline transition-all duration-300 hover:translate-x-1 inline-block" href="tel:{{ generalEntry.phoneNumber }}" style="text-decoration: none !important;">{{ generalEntry.phoneNumber }}</a>
										</li>
									{% endif %}
								</ul>
							</div>
						</div>
					{% endif %}
				</div>
			</div>
			<div class="sm:flex flex-col-reverse sm:flex-row items-center justify-between pt-4 md:pt-20 mt-2 md:mt-0 lg:mt-2 xl:mt-4 pb-8 sm:pb-0">
				<p class="text-[13px] text-center sm:text-left text-slate-500 dark:text-slate-400 mb-0 pt-4 sm:pt-0">&copy; {{ now|date('Y') }} {{ siteName }} - All Rights Reserved</p>
				<div class="flex justify-center mb-4 sm:mb-0 md:-me-2">
					{% if footerDisplaySocial %}
						{% include '_components/social' %}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>
