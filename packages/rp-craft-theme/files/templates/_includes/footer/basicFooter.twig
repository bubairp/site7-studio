{% import "_macros/images" as images %}
{% import '_macros/utils' as utils %}
{% import '_components/ctaButton' as buttons %}
<!-- Footer --><style>
	.last-0 > *:last-child {
		margin-bottom: 0;
	}
</style>
<div class="footer-main {{ footerClasses }} relative pb-4 md:pt-3 lg:py-4 xl:py-16 bg-white dark:bg-dark text-gray-900 dark:text-white border-t border-gray-100 dark:border-gray-800 transition-colors duration-300" {% if themeSwitche %} data-theme="dark" {% endif %}>
	<div class="hidden dark:block absolute top-0 left-0 w-full h-full bg-white/5 pointer-events-none"></div>
	<div class="{{ footerContainerWidth }}">
		<div class="border-0 border-b border-solid border-slate-200 dark:border-slate-800">
			<div class="flex flex-col md:flex-row gap-0 md:gap-8 lg:gap-12 pb-4 md:pb-8 sm:pt-2 {{ footerVerticalAlign }}">
				<div class="w-full md:w-1/3 lg:w-1/4">
					{% set siteFooterLogo = generalEntry.footerLogo.one() ?? generalEntry.logo.one() ?? null %}
					{% if footerDisplayLogo and siteFooterLogo %}
						<a class="inline-block mb-4 md:mb-8 transition-transform duration-300 hover:scale-105" href="/" style="text-decoration: none !important;">
							<img src="{{ siteFooterLogo.url }}" alt="logo" class="max-h-12 md:max-h-16">
						</a>
					{% endif %}
					{% if footer.description %}
						<div class="text-sm mb-6 text-slate-500 dark:text-slate-400 leading-relaxed">{{ footer.description }}</div>
					{% endif %}
					<!-- CTA Button -->
					{% if footerDisplayCTA is defined and footerButton is defined and footerDisplayCTA  and footerButton %}
						{% set customClasses = "tw-btn-sm text-sm mb-3" %}
						{{ buttons.renderButton(footerButton, {}, customClasses) }}
					{% endif %}

					{% if footerDisplayOfficeTiming and officeTiming and officeTiming|length >0 %}<div class="mt-3">
							<h3 class="mb-5 text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Office Timing</h3>
							<ul class="list-none mb-0 pb-3 md:pb-0 p-0 flex flex-col">
								{% for officeTime in officeTiming %}
									<li class="flex justify-between items-center text-sm mb-2 pb-2 border-b border-dashed border-slate-200 dark:border-slate-700 last:border-0 last:pb-0 last:mb-0">
										<span class="font-medium text-slate-700 dark:text-slate-300">{{officeTime.day}}</span>
										<span class="text-slate-500 dark:text-slate-400">
											{{ utils.formatTime24Hour(officeTime.startTime) }} - {{ utils.formatTime24Hour(officeTime.endTime) }}
										</span>
									</li>
								{% endfor %}
							</ul>
						</div>
					{% endif %}
				</div>
				<div class="w-full md:w-10/12 lg:w-8/12 lg:ms-auto">
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-0 sm:gap-6 md:gap-8">
						<div class="mb-0 md:mb-0 w-full" x-data="{ open: false }">
							{% set col1MenuHandle = footer.footerMenuCol1 ?? 'footerMenuCol1' %}
							{% set col1MenuObj = craft.simplerpmenu.getMenu(col1MenuHandle) %}
							<button @click="open = !open" class="w-full flex items-center justify-between text-base sm:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white sm:cursor-default sm:pointer-events-none py-4 sm:py-0 sm:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 sm:border-none text-left">
								<span>{{ col1MenuObj ? col1MenuObj.name|t : 'Categories'|t }}</span>
								<svg :class="{'rotate-180': open}" class="w-5 h-5 transition-transform sm:hidden text-slate-500" fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
							</button>
							<div :class="{'hidden': !open}" class="hidden sm:block pt-4 pb-6 sm:p-0">
								{{ craft.simplerpmenu.getRpMenuHTML(col1MenuHandle,{ 'menu-id': 'footerMenuCol1','menu-class':'','ul-class':'flex flex-col text-sm p-0 gap-1','li-class':'list-none', 'link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block'}) }}
							</div>
						</div>
						<div class="mb-0 md:mb-0 w-full" x-data="{ open: false }">
							{% set col2MenuHandle = footer.footerMenuCol2 ?? 'footerMenuCol2' %}
							{% set col2MenuObj = craft.simplerpmenu.getMenu(col2MenuHandle) %}
							<button @click="open = !open" class="w-full flex items-center justify-between text-base sm:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white sm:cursor-default sm:pointer-events-none py-4 sm:py-0 sm:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 sm:border-none text-left">
								<span>{{ col2MenuObj ? col2MenuObj.name|t : 'Quick Links'|t }}</span>
								<svg :class="{'rotate-180': open}" class="w-5 h-5 transition-transform sm:hidden text-slate-500" fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
							</button>
							<div :class="{'hidden': !open}" class="hidden sm:block pt-4 pb-6 sm:p-0">
								{{ craft.simplerpmenu.getRpMenuHTML(col2MenuHandle,{ 'menu-id': 'footerMenuCol2','menu-class':'','ul-class':'flex flex-col text-sm p-0 gap-1','li-class':'list-none', 'link-class':'text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block'}) }}
							</div>
						</div>

						<div class="w-full">
							{% if footerDisplayContactInfo %}
								<div class="w-full" x-data="{ open: false }">
									<button @click="open = !open" class="w-full flex items-center justify-between text-base sm:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white sm:cursor-default sm:pointer-events-none py-4 sm:py-0 sm:mb-5 bg-transparent border-b border-dashed border-slate-200 dark:border-slate-800 sm:border-none text-left">
										<span>{{ 'Contact Info'|t }}</span>
										<svg :class="{'rotate-180': open}" class="w-5 h-5 transition-transform sm:hidden text-slate-500" fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
									</button>
									<div :class="{'hidden': !open}" class="hidden sm:block pt-4 pb-6 sm:p-0 mb-6 md:mb-0">
										<ul class="flex flex-col text-sm p-0 gap-1">
											{% if generalEntry.Description %}
												<li class="last-0 list-none mb-2 text-slate-600 dark:text-slate-400 leading-relaxed">{{ generalEntry.Description }}</li>
											{% endif %}
											{% if generalEntry.email %}
												<li class="list-none">
													<a class="text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block" href="mailto:{{ generalEntry.email }}" style="text-decoration: none !important;">{{ generalEntry.email }}</a>
												</li>
											{% endif %}
											{% if generalEntry.phoneNumber %}
												<li class="list-none">
													<a class="text-slate-600 dark:text-slate-400 hover:text-primary font-medium py-1 transition-all duration-300 hover:translate-x-1 no-underline inline-block" href="tel:{{ generalEntry.phoneNumber }}" style="text-decoration: none !important;">{{ generalEntry.phoneNumber }}</a>
												</li>
											{% endif %}
										</ul>
									</div>
								</div>
							{% endif %}
							<div class="pt-6 md:pt-0 mt-0 md:mt-8">
								<h3 class="mb-4 md:mb-5 text-base md:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">{{ 'Follow Us'|t }}</h3>
								{% if footerDisplaySocial %}
									<div class="flex">{% include '_components/social' %}</div>
								{% endif %}
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="flex flex-col sm:flex-row items-center pb-3 md:pb-4 gap-2 sm:gap-3">
				{% set cardImg = generalEntry.acceptedCards.one() ?? null %}
				{% if cardImg %}
					<div class="text-sm text-slate-700 dark:text-slate-300 mb-0">Cards Accepted</div>
					{% set imgWidth = cardImg.width ?: 187 %}
					{% set imgHeight = cardImg.height ?: 28 %}
					{{ images.singleImg(cardImg, imgWidth, {ratio: (imgWidth / imgHeight)}, '') }}
				{% endif %}
			</div>
		</div>
		<div class="pt-6 mt-2 sm:mt-0 text-center">
			<p class="text-[13px] text-slate-500 dark:text-slate-100 mb-0">&copy; {{ now|date('Y') }} {{ siteName }} - All Rights Reserved</p>
		</div>
	</div>
</div>
