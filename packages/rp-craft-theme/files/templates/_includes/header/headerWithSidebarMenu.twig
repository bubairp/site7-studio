{% import "_macros/images" as images %}
{% import '_components/ctaButton' as buttons %}

<div x-data="sidebarMenu">
	<div class="headerMain {{ headerClasses }} {{ headerPositioning }} sticky w-full z-[1030] bg-white/95 dark:bg-dark/95 backdrop-blur-xl transition-all duration-300" {% if themeSwitche %} data-theme="dark" {% else %} data-theme="light" {% endif %}>
		{% if headerDisplayThinbar %}
			<div class="header-top bg-primary py-1 text-white">
				<div class="container text-center text-sm">{{ generalEntry.headerNotification }}</div>
			</div>
		{% endif %}
		<!-- Navbar -->
		<div class="header-main flex flex-wrap bg-transparent py-2 lg:py-3">
			<div class="{{ headerContainerWidth }} mx-auto h-full flex items-center justify-between px-4">
				<div class="logo shrink-0">
					<a href="/" class="menu-brand lg:pe-3 shrink-0 lg:flex-1 lg:flex">
						<span class="logo text-primary shrink-0 lg:me-2">
							<img src="{{ generalEntry.logo.0.url }}" alt="logo" class="w-auto h-10 lg:h-auto lg:max-h-none">
						</span>
					</a>
				</div>
				<div
					class="flex items-center gap-4">
					<!-- Phone -->
					{% if headerDisplayPhone %}
						<div class="hidden md:block">
							<a class="nav-link font-normal px-0 py-1" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
						</div>
					{% endif %}

					<button @click="sidebarOpen = true" id="sidebarMenuToggle" :aria-expanded="sidebarOpen ? 'true' : 'false'" class="flex items-center justify-center w-10 h-10 rounded-full border-none bg-transparent hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer transition-colors" type="button" aria-label="Toggle navigation">
						<span class="hamburger-icon">
							<span class="bar bar-1"></span>
							<span class="bar bar-2"></span>
							<span class="bar bar-3"></span>
						</span>
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Sidebar Overlay - OUTSIDE headerMain to escape containing block -->
	<div x-show="sidebarOpen" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 z-[1040] bg-black/60" x-cloak @click="sidebarOpen = false"></div>

	<!-- Sidebar Panel - OUTSIDE headerMain to escape containing block -->
	<div x-show="sidebarOpen" x-transition:enter="transition-transform ease-out duration-300" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition-transform ease-in duration-200" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" class="fixed top-0 right-0 w-80 max-w-[85vw] z-[1050] flex flex-col transform h-[100dvh] bg-[#1e2939] text-white shadow-[-10px_0_40px_rgba(0,0,0,0.3)]" id="offcanvasRight" data-lenis-prevent x-cloak>
		<div class="flex justify-between items-center py-3 px-5 border-b border-white/10">

			<a class="menu-brand lg:pe-3 shrink-0 lg:flex-1 lg:flex" href="/">
				<span class="logo text-primary shrink-0 lg:me-2">
					<img src="{{ generalEntry.logo.0.url }}" alt="logo" class="w-auto h-10 lg:h-auto lg:max-h-none">
				</span>
			</a>


			<button type="button" @click="sidebarOpen = false" class="group flex items-center justify-center w-10 h-10 rounded-full border-none bg-transparent text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-300 cursor-pointer" aria-label="Close">
				<i class="ti ti-x text-xl transform group-hover:rotate-90 transition-transform duration-300"></i>
			</button>
		</div>
		<div class="py-4 px-5 flex-1 overflow-y-auto" id="sidebarNav">{{ craft.simplerpmenu.getRpMenuHTML('headerMenu',{
			'menu-id': 'headerMenu',
			'menu-class':'sidebar-rp-menu sidebar-menu ms-auto',
			'ul-class':'menu-ul flex flex-col p-0 m-0',
			'li-class':'',
			'sub-menu-ul-class':'sub-menu-ul dropdown-menu',
			'link-class':'nav-link', })
		}}
			<!-- Phone -->
			{% if headerDisplayPhone %}
				<div class="mt-6 flex items-center text-[#d1d5db]">
					<i class="ti ti-phone me-3 text-xl text-primary"></i>
					<a class="nav-link font-normal px-0 py-1 hover:text-white transition-colors" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
				</div>
			{% endif %}

			<!-- Email -->
			{% if headerDisplayEmail %}
				<div class="mt-3 flex items-center text-[#d1d5db]">
					<i class="ti ti-mail me-3 text-xl text-primary"></i>
					<a class="nav-link font-normal px-0 py-1 hover:text-white transition-colors" href="mailto:{{ generalEntry.email }}">{{ generalEntry.email }}</a>
				</div>
			{% endif %}

			<!-- Social -->
			{% if headerDisplaySocial %}
				<div class="social-items mt-6 pt-6 flex justify-start border-t border-white/10">
					{% include '_components/social' with { sizeClass: 'w-8 h-8', iconSize: 16 } %}
				</div>
			{% endif %}
		</div>
	</div>


</div>
<div class="header-height min-h-[var(--header-height,100px)]"></div>
