{% set profileImg = author.image ? author.image.one() : null %}
{% set featureImg = author.featureImage ? author.featureImage.one() : null %}
{% set infoItems = author.authorInfoItems ? author.authorInfoItems.all() : [] %}

<div class="author-detail-header relative overflow-hidden py-10 md:py-12 lg:py-16 text-center md:text-left bg-gradient-to-br from-[#2f2f2f] via-[#575757] to-[#585858]">
	{% if featureImg %}
		{% import "_macros/images" as images %}{{ images.singleImg(featureImg, 1920, {}, 'author-bg-blur absolute inset-0 w-full h-full object-cover blur-[20px] brightness-60 opacity-40 z-0', {}) }}
	{% endif %}

	<div class="container mx-auto relative z-10 lg:py-2">
		<div
			class="grid grid-cols-12 items-center gap-y-6 lg:gap-x-12">
			{# Left: Profile Portrait #}
			<div class="col-span-12 md:col-span-3 lg:col-span-4 text-center md:text-left">
				<div class="author-portrait-wrapper inline-block">
					{% if profileImg %}
						{{ images.singleImg(profileImg, 450, {'ratio': 1}, 'author-portrait rounded-lg w-full shadow-[0_25px_50px_rgba(0,0,0,0.4)] transition-transform duration-300 ease-out') }}
					{% else %}
						<div class="author-portrait bg-white p-6 shadow-[0_25px_50px_rgba(0,0,0,0.4)] transition-transform duration-300 ease-out rounded-2xl flex items-center justify-center" style="aspect-ratio: 1; min-width: 250px;">
							<i class="ti ti-user text-4xl tw-text-muted"></i>
						</div>
					{% endif %}
				</div>
			</div>

			{# Right: Metadata #}
			<div class="col-span-12 md:col-span-9 lg:col-span-8">
				<div class="author-bio text-white mb-6">
					<h1 class="text-white author-name mb-2">{{ author.title }}</h1>
					{% if author.shortDescription %}
						{{ author.shortDescription }}
					{% endif %}
				</div>
				{# Stats Grid from Figma #}
				{% if infoItems|length %}
					<div class="author-info grid grid-cols-12 gap-4">
						{% for item in infoItems %}
							<div class="col-span-6 lg:col-span-3">
								<div class="tw-card author-info-card text-white h-full mb-4 md:mb-0 bg-white/15 backdrop-blur-md border !border-white/10 transition-all duration-300 ease-out">
									<div class="tw-card-body p-4">
										<div class="card-icon text-white mb-4">
											{% if item.iconImage ? item.iconImage|length : false %}
												{{ images.singleImg(item.iconImage ? item.iconImage.one() : null, 32, {}, 'max-w-full h-auto brightness-0 invert', { width: 32, height: 32 }) }}
											{% elseif item.iconClass|length %}
												<i class="{{ item.iconClass }} text-2xl"></i>
											{% else %}
												<i class="ti ti-award text-2xl"></i>
											{% endif %}
										</div>
										<h6 class="tw-card-title mb-2 text-white">{{ item.title }}</h6>
										{% if item.description %}
											<p class="tw-card-text text-xs opacity-75 text-white mb-0">{{ item.description }}</p>
										{% endif %}
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</div>
