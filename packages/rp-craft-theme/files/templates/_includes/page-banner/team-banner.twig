{% import "_macros/images" as images %}
{% if teamMember.featureImage|length %}
	<div class="jarallax bg-dark py-10 md:py-12 lg:py-16" data-jarallax data-speed="0.6">
		<span class="absolute top-0 start-0 w-full h-full bg-dark opacity-50"></span>
		{% set image = teamMember.featureImage.one() %}
		{% if image %}
			<div class="jarallax-img" style="background-image: url('{{ images.bgImageUrl(image)|trim }}');"></div>
		{% endif %}

		<div class="relative text-center z-20 px-4 sm:py-12 lg:my-12">
			{% if teamMember.bannerTitle|length %}
				<h2 class="text-4xl font-bold text-white my-12">{{ teamMember.bannerTitle }}</h2>
			{% endif %}
		</div>
	</div>
{% endif %}
