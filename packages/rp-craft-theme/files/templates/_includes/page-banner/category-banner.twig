<section
	class="relative overflow-hidden py-10 md:py-12 lg:py-16 text-white" style="background: linear-gradient(90deg, rgba(216, 1, 1, 0.99) 0%, rgba(208, 41, 11, 0.99) 7.1429%, rgba(200, 59, 19, 0.99) 14.286%, rgba(192, 72, 26, 0.99) 21.429%, rgba(183, 83, 31, 0.99) 28.571%, rgba(174, 92, 36, 0.99) 35.714%, rgba(164, 100, 40, 0.99) 42.857%, rgba(154, 108, 44, 0.99) 50%, rgba(143, 114, 48, 0.99) 57.143%, rgba(131, 120, 52, 0.99) 64.286%, rgba(118, 126, 56, 0.99) 71.429%, rgba(102, 132, 59, 0.99) 78.571%, rgba(84, 137, 62, 0.99) 85.714%, rgba(59, 141, 66, 0.99) 92.857%, rgba(1, 146, 69, 0.99) 100%);">
	{# Background pattern/image overlay #}
	{% set bannerImg = category.featureImage.one() ?? null %}
	{% if bannerImg %}
		{% import "_macros/images" as images %}{{ images.singleImg(bannerImg, 1920, {}, 'absolute top-0 left-0 w-full h-full object-cover opacity-10 pointer-events-none z-1', {}) }}
	{% endif %}

	<div class="container mx-auto relative z-2">
		<div
			class="flex items-center gap-4 md:gap-6">
			{# Category Icon #}
			{% set iconType = category.iconImageOrClass.value ?? 'iconImage' %}
			{% set iconImage = category.image.one() %}
			{% set iconClass = category.plainText ?? category.iconClass ?? 'ti ti-book' %}

			<div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center text-[1.75rem] text-white shrink-0 shadow-sm">
				{% if iconType == 'iconImage' and iconImage %}
					{{ images.singleImg(iconImage, 32, {}, 'max-w-full h-auto') }}
				{% else %}
					<i class="{{ iconClass }}"></i>
				{% endif %}
			</div>

			{# Titles #}
			<div>
				<h1 class="text-4xl font-bold category-title text-white mb-0">{{ category.title }}</h1>
				{% if category.shortDescription %}
					<div class="category-shortDescription last-0">{{ category.shortDescription }}</div>
				{% endif %}
			</div>
		</div>
	</div>
</section>
