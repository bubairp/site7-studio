{% set entry = craft.entries().section('pageNotFound').one() %}

{% extends "_layouts/matrix-content" %}

{% block content %}
	<div class="bg-gray-50 dark:bg-gray-900 py-20 flex items-center justify-center min-h-[60vh] px-4">
		<div class="container mx-auto max-w-2xl text-center">
			<div class="tw-card p-10 md:p-16">
				<h1 class="text-7xl font-black text-primary mb-4">{{ entry.title }}</h1>
				<h2 class="text-2xl md:text-3xl font-bold mb-6 text-gray-900 dark:text-white">Page Not Found</h2>
				{% if entry.Description|length %}
					<div class="text-lg mb-8 tw-text-muted">{{ entry.Description }}</div>
				{% endif %}
				<a href="/" class="tw-btn tw-btn-lg tw-btn-primary shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300">Go back to Homepage</a>
			</div>
		</div>
	</div>
{% endblock %}
