{% import "_macros/images" as images %}

{% set image = block.image is defined ? block.image.one() : null %}
{% set linkUrl = block.linkUrl ?? '' %}
{% set title = block.title ?? '' %}

{% if image or title|length %}
	<div class="py-10 md:py-12 lg:py-16">
		<div class="container mx-auto px-4">
			<div class="group flex flex-col items-center justify-center p-5 text-center">
				{% if linkUrl|length %}
					<a href="{{ linkUrl }}" target="_blank" class="flex flex-col items-center justify-center">
				{% endif %}
				{% if image %}
					{% if image.extension == "svg" %}
						{{ images.singleImg(image, 150, {}, 'max-h-24 w-auto object-contain transition-transform group-hover:scale-105 duration-300', { alt: title ?: 'logo' }) }}
					{% else %}
						{{ images.singleImg(image, 392, {}, 'max-h-24 w-auto object-contain transition-transform group-hover:scale-105 duration-300') }}
					{% endif %}
				{% endif %}
				{% if title|length %}
					<div class="pt-3 text-sm font-semibold transition-colors group-hover:text-primary">{{ title }}</div>
				{% endif %}
				{% if linkUrl|length %}
					</a>
				{% endif %}
			</div>
		</div>
	</div>
{% endif %}
