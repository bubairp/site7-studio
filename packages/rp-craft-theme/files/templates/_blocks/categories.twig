{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}

{% set headingAndContent = block.headingAndContent.one() %}
{% set selectedCategories = block.productCategory.all() %}
{% set categories = selectedCategories|length ? selectedCategories : craft.entries.section('productCategory').level(1).all() %}
{% set customItems = block.customItems.all() ?? [] %}

{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid ?? '' %}
{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
{% set themeSwitche = null %}
{% if blockStyle is defined and blockStyle|length %}
	{% set blockStyleData = blockStyle.one() %}
	{% if blockStyleData.background is defined %}
		{% set backgroundEntry = blockStyleData.background.one() %}
		{% set themeSwitche = backgroundEntry.themeDark ?? null %}
	{% endif %}
{% endif %}

{# Display View and Grid Logic #}
{% set dvField = block.displayView|default(null) %}
{% set displayView = (dvField and dvField is not iterable) ? (dvField.value ?? dvField) : 'gridView' %}

{% set rItemsField = block['itemsPerRow']|default(null) %}
{% set rawItems = (rItemsField and rItemsField is not iterable) ? (rItemsField.value ?? rItemsField) : 'default' %}

{% set rowColsClass = 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6' %}
{% if rawItems != 'default' %}
	{% set itemsPerRow = rawItems|number %}
	{% set rowColsClass = 'grid-cols-1 sm:grid-cols-2 md:grid-cols-' ~ itemsPerRow %}
{% endif %}

{{ bsResponsive(blockStyle, scopedSel) }}
<section class="py-10 md:py-12 lg:py-16 {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
	<div class="{{ containerWidth }}">
		{% if headingAndContent %}
			{% include "_components/header-content-block" %}
		{% endif %}

		{% if displayView == 'sliderView' %}
			<div class="swiper" data-swiper-options='{"slidesPerView": 2,"spaceBetween": 16,"pagination": {"el": ".swiper-pagination","clickable": true},"breakpoints": {"576": { "slidesPerView": 2, "spaceBetween": 24 },"992": { "slidesPerView": 4 },"1200": { "slidesPerView": 6 }}}'>
				<div class="swiper-wrapper" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">
					{% for category in categories %}
						<div class="swiper-slide h-auto">
							{% set title = category.title %}
							{% set url = category.url %}
							{% set iconType = category.iconImageOrClass.value ?? 'iconImage' %}
							{% set iconImage = category.image.one() %}
							{% set iconClass = category.plainText ?? category.iconClass ?? 'ti ti-book' %}
							{% set colorData = category.colorLibrary.one() %}
							{% set color = colorData.colorcode ?? 'var(--primary)' %}
							{% set categoriesToRelate = [category]|merge(category.getDescendants().all()) %}
							{% set productCount = craft.entries.section('products').relatedTo(categoriesToRelate).count() %}
							{% set subText = productCount ~ '+ Books' %}

							<a href="{{ url }}" class="tw-card group flex flex-col h-full text-center p-3 lg:p-6 no-underline relative overflow-hidden block">
								<div class="absolute top-0 right-0 -mt-4 -mr-4 opacity-20" style="width: 120px; height: 120px; border-radius: 50%; background: {{ color }}; filter: blur(30px);"></div>
								<div class="category-icon-wrapper mx-auto mb-3 flex items-center justify-center rounded-lg shadow-sm" style="width: 64px; height: 64px; background: {{ color }}; background: linear-gradient(135deg, {{ color }} 0%, color-mix(in srgb, {{ color }} 80%, white) 100%);">
									{% if iconType == 'iconImage' and iconImage %}
										{{ images.singleImg(iconImage, 32, {}, 'max-w-full h-auto') }}
									{% else %}
										<i class="{{ iconClass }} text-3xl text-white"></i>
									{% endif %}
								</div>
								<h3 class="text-base mb-1 text-gray-900 font-bold">{{ title }}</h3>
								<p class="text-xs opacity-80 mb-0">{{ subText }}</p>
							</a>
						</div>
					{% endfor %}
					{% for item in customItems %}
						<div class="swiper-slide h-auto">
							{% set title = item.plainText %}
							{% set link = item.linkUrl %}
							{% set url = link ? link.url : null %}
							{% set iconImage = item.image.one() %}
							{% set color = 'var(--primary)' %}
							{% set subText = item.badgeText ?? '' %}

							<a {% if url %} href="{{ url }}" {% endif %} class="tw-card group flex flex-col h-full text-center p-3 lg:p-6 no-underline relative overflow-hidden block">
								<div class="absolute top-0 right-0 -mt-4 -mr-4 opacity-20" style="width: 120px; height: 120px; border-radius: 50%; background: {{ color }}; filter: blur(30px);"></div>
								<div class="category-icon-wrapper mx-auto mb-3 flex items-center justify-center rounded-lg shadow-sm" style="width: 64px; height: 64px; background: {{ color }}; background: linear-gradient(135deg, {{ color }} 0%, color-mix(in srgb, {{ color }} 80%, white) 100%);">
									{% if iconImage %}
										{{ images.singleImg(iconImage, 32, {}, 'max-w-full h-auto') }}
									{% else %}
										<i class="ti ti-book text-3xl text-white"></i>
									{% endif %}
								</div>
								<h3 class="text-base mb-1 text-gray-900 font-bold">{{ title }}</h3>
								{% if subText %}
									<p class="text-xs opacity-80 mb-0">{{ subText }}</p>
								{% endif %}
							</a>
						</div>
					{% endfor %}
				</div>
				<div class="swiper-pagination relative bottom-0 mt-2 pt-4"></div>
			</div>
		{% else %}
			<div class="grid {{ rowColsClass }} gap-3 lg:gap-4 mt-2" data-theme="{{ themeSwitche ? 'dark' : 'light' }}">
				{% for category in categories %}
					<div>
						{% set iconType = category.iconImageOrClass.value ?? 'iconImage' %}
						{% set iconImage = category.image.one() %}
						{% set iconClass = category.plainText ?? category.iconClass ?? 'ti ti-book' %}
						{% set colorData = category.colorLibrary.one() %}
						{% set color = colorData.colorcode ?? 'var(--primary)' %}
						{% set categoriesToRelate = [category]|merge(category.getDescendants().all()) %}
						{% set productCount = craft.entries.section('products').relatedTo(categoriesToRelate).count() %}

						<a href="{{ category.url }}" class="tw-card group flex flex-col h-full text-center p-3 lg:p-6 no-underline relative overflow-hidden block">
							<div class="absolute top-0 right-0 -mt-4 -mr-4 opacity-20" style="width: 120px; height: 120px; border-radius: 50%; background: {{ color }}; filter: blur(30px);"></div>
							<div class="category-icon-wrapper mx-auto mb-3 flex items-center justify-center rounded-lg shadow-sm" style="width: 64px; height: 64px; background: {{ color }}; background: linear-gradient(135deg, {{ color }} 0%, color-mix(in srgb, {{ color }} 80%, white) 100%);">
								{% if iconType == 'iconImage' and iconImage %}
									{{ images.singleImg(iconImage, 32, {}, 'max-w-full h-auto') }}
								{% else %}
									<i class="{{ iconClass }} text-3xl text-white"></i>
								{% endif %}
							</div>
							<h3 class="text-base mb-1 text-gray-900 font-bold">{{ category.title }}</h3>
							<p class="text-xs opacity-80 mb-0">{{ productCount }}+ Books</p>
						</a>
					</div>
				{% endfor %}
				{% for item in customItems %}
					<div>
						{% set color = 'var(--primary)' %}
						{% set iconImage = item.image.one() %}
						{% set link = item.linkUrl %}
						{% set url = link ? link.url : null %}
						<a {% if url %} href="{{ url }}" {% endif %} class="tw-card group flex flex-col h-full text-center p-3 lg:p-6 no-underline relative overflow-hidden block">
							<div class="absolute top-0 right-0 -mt-4 -mr-4 opacity-20" style="width: 120px; height: 120px; border-radius: 50%; background: {{ color }}; filter: blur(30px);"></div>
							<div class="category-icon-wrapper mx-auto mb-3 flex items-center justify-center rounded-lg shadow-sm" style="width: 64px; height: 64px; background: {{ color }}; background: linear-gradient(135deg, {{ color }} 0%, color-mix(in srgb, {{ color }} 80%, white) 100%);">
								{% if iconImage %}
									{{ images.singleImg(iconImage, 32, {}, 'max-w-full h-auto') }}
								{% else %}
									<i class="ti ti-book text-3xl text-white"></i>
								{% endif %}
							</div>
							<h3 class="text-base mb-1 text-gray-900 font-bold">{{ item.plainText }}</h3>
							{% if item.badgeText %}
								<p class="text-xs opacity-80 mb-0">{{ item.badgeText }}</p>
							{% endif %}
						</a>
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
