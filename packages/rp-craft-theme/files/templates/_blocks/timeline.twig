{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}

{% set headingAndContent = block.headingAndContent.one() %}
{% set timelineItems = block.timelineItems.all() ?? block.processItems.all() ?? [] %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? 'timeline' %}
{% set blockTypeUid = block.uid  ?? '' %}

{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
{% set themeSwitche = null %}

{% if blockStyle is defined and blockStyle|length %}
	{% set blockStyleData = blockStyle.one() %}
	{% if blockStyleData.background is defined %}
		{% set backgroundEntry = blockStyleData.background.one() %}
		{% set themeSwitche = backgroundEntry.themeDark ?? null %}
	{% endif %}
{% endif %}

{{ bsResponsive(blockStyle, scopedSel) }}
<section class="py-10 md:py-12 lg:py-16 {{ blockType }}{{ blockTypeUid }}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
	<div class="{{ containerWidth }}">
		{% if headingAndContent %}
			{% if headingAndContent.heading|length or headingAndContent.Description|length %}
				{% include "_components/header-content-block" %}
			{% endif %}
		{% endif %}

		<div
			class="flex flex-col gap-y-8 lg:gap-y-12 relative mt-8">
			{# Optional vertical line for timeline aesthetic #}
			<div class="hidden sm:block absolute left-[60px] top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700 z-0"></div>

			{% for item in timelineItems %}
				{% set year = item.duration %}
				{% set eventHeading = item.plainText %}
				{% set eventDescription = item.Description %}
				{% set isImportant = item.isImportant ?? false %}
				{% set isLinkEnabled = item.switchOff ?? false %}
				{% set itemUrl = item.linkUrl.url ?? '#' %}
				{% set itemImage = item.image.one() %}
				<div>
					<div
						class="timeline-item flex flex-col sm:flex-row gap-6 lg:gap-8 items-start relative z-10 {% if isImportant %}is-important{% endif %}">
						{# Year Box #}
						<div class="timeline-year-box bg-primary flex-shrink-0 flex items-center justify-center rounded-xl px-6 py-3 text-white font-bold shadow-md w-full sm:w-[120px]">{{ year }}</div>

						{# Event Box #}
						{% if isLinkEnabled %}
							<a href="{{ itemUrl }}" class="no-underline grow group w-full">
							{% else %}
								<div class="grow w-full">
								{% endif %}

								<div class="tw-card p-6 md:p-8 h-full flex flex-col timeline-event-card">
									{% if itemImage %}
										<div class="mb-6 rounded-xl overflow-hidden shadow-sm self-start w-full max-w-[300px]">{{ images.singleImg(itemImage, 600, {'ratio': 1.5}, 'w-full h-auto object-cover rounded-xl') }}</div>
									{% endif %}

									<h4 class="text-xl md:text-2xl mb-2 text-gray-900 dark:text-white font-bold">{{ eventHeading }}</h4>

									{% if eventDescription %}
										<div class="mt-2 text-gray-600 dark:text-gray-300 font-light leading-relaxed tw-rich-text">{{ eventDescription|raw }}</div>
									{% endif %}
								</div>

								{% if isLinkEnabled %}
								</a>
						{% else %}
							</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
