{% import "_macros/images" as images %}

{% set itemMarginClasses = isAltStyle ? 'mb-0 sm:mb-1 last:mb-0 bg-transparent rounded-none' : (isAlt2Style ? 'mb-2 sm:mb-3 last:mb-0 bg-transparent rounded-lg overflow-hidden' : 'mb-4 last:mb-0 bg-gray-100 rounded-lg overflow-hidden') %}
{% set buttonPaddingClasses = isAltStyle ? 'py-3 px-0 text-xl sm:text-2xl' : (isAlt2Style ? 'py-[0.9rem] px-[1.3rem] text-lg' : 'py-4 px-5 text-base') %}
{% set bodyPaddingClasses = isAltStyle ? 'py-0 px-0' : (isAlt2Style ? 'py-3 px-[1.3rem]' : 'py-4 px-5') %}
{% set arrowClasses = isArrowTextReverse ? 'flex-row-reverse justify-end gap-4' : 'justify-between' %}

<div class="tw-accordion-item tw-accordion-toggle-item {{ itemMarginClasses }} {{ cardFullBorderStyleAccordion }} {{ accordionItemTopBorderClass }}">
	<button type="button" class="flex w-full items-center text-left border-0 transition-colors font-semibold tw-accordion-button tw-accordion-heading-title {{ buttonPaddingClasses }} {{ arrowClasses }} {{ accordionItemClass }}" :class="activeAccordion === {{ index }} ? 'is-open text-primary' : 'text-gray-800'" @click="activeAccordion = activeAccordion === {{ index }} ? null : {{ index }}">
		<span>{{ item.plainText }}</span>
		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 shrink-0" :class="{ '-rotate-180': activeAccordion === {{ index }} }">
			<path d="M6 9l6 6 6-6"/>
		</svg>
	</button>
	<div x-show="activeAccordion === {{ index }}" x-collapse>
		<div class="{{ bodyPaddingClasses }} tw-accordion-body tw-accordion-content-style text-left overflow-hidden">{{ item.Description }}</div>
	</div>
</div>
