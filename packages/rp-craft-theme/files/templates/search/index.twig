{% extends "_layouts/entry" %}

{% set searchQuery = craft.app.request.getParam('term') %}

{# Ensure we only search entries, excluding globals or matrix blocks #}
{% set entries = [] %}
{% set pageInfo = null %}

{% if searchQuery %}
	{% set query = craft.entries()
		.search(searchQuery)
		.orderBy('score')
		.section('and, not themeSettings, not header, not footer')
		.limit(10) %}

	{% paginate query as pageInfo, entries %}{% endif %}

	{% block content %}
		<div class="container mx-auto py-12 ">
			<div class="lg:pt-2 pb-2">
				<div class="max-w-4xl mx-auto text-center mb-6">
					<h1 class="text-3xl font-bold mb-2">Search</h1>

					<form action="" class="mt-6 mb-6 mx-auto max-w-xl">
						<div class="flex items-stretch shadow-sm rounded-xl overflow-hidden border border-gray-200 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all">
							<span class="flex items-center justify-center px-4 bg-white text-gray-400">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewbox="0 0 16 16">
									<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
								</svg>
							</span>
							<input type="search" name="term" class="flex-1 py-3 px-2 border-0 outline-none bg-white text-gray-900 placeholder:text-gray-400" placeholder="Search for articles, pages, or content..." value="{{ searchQuery }}" aria-label="Search">
							<button class="px-6 py-3 bg-primary text-white font-semibold hover:bg-primary/90 transition-colors border-0" type="submit">Search</button>
						</div>
					</form>

					<p class="text-gray-500">
						{% if searchQuery %}
							Found
							<strong>{{ pageInfo ? pageInfo.total : 0 }}</strong>
							result{{ pageInfo and pageInfo.total == 1 ? '' : 's' }}
							for
							<strong>"{{ searchQuery }}"</strong>
						{% else %}
							What are you looking for today?
						{% endif %}
					</p>
				</div>
			</div>

			<div class="lg:pb-2">
				<div class="max-w-4xl mx-auto">
					{% if searchQuery %}
						{% if entries|length %}
							<div class="grid gap-6 mb-6">
								{% for entry in entries %}
									<div class="tw-card relative transition-all">
										<div class="tw-card-body p-6 md:p-10">
											<div class="flex items-center mb-4 gap-3">
												<span class="tw-badge bg-primary text-white rounded-full px-4 py-1.5 font-normal">{{ entry.section.name|default('Page') }}</span>
												<small class="text-gray-500">{{ entry.postDate|date("M j, Y") }}</small>
											</div>
											<h3 class="text-xl font-bold mb-4">
												{% if entry.url %}
													<a href="{{ entry.url }}" class="text-primary no-underline after:absolute after:inset-0 after:z-10 after:content-['']">{{ entry.title }}</a>
												{% else %}
													<span class="text-primary">{{ entry.title }}</span>
												{% endif %}
											</h3>
											{% if entry['summary'] is defined and entry.summary %}
												<p class="tw-card-text text-gray-600 mb-0 leading-relaxed">{{ entry.summary|striptags|truncate(200) }}</p>
											{% elseif entry['description'] is defined and entry.description %}
												<p class="tw-card-text text-gray-600 mb-0 leading-relaxed">{{ entry.description|striptags|truncate(200) }}</p>
											{% endif %}
											{% if entry.url %}
												<small class="text-gray-400 mt-6 flex items-center">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-link-45deg mr-2" viewbox="0 0 16 16">
														<path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z"/>
														<path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z"/>
													</svg>{{ entry.url }}</small>
											{% endif %}
										</div>
									</div>
								{% endfor %}
							</div>

							{# Pagination #}
							{% if pageInfo and pageInfo.totalPages >1 %}<nav aria-label="Search results pages" class="pagination-nav mt-12">
									<ul class="flex flex-wrap gap-1.5 py-2.5 justify-center items-center list-none m-0 p-0 max-sm:gap-1">

										{% set linkBaseClasses = 'inline-flex items-center justify-center w-11 h-11 p-0 text-[0.95rem] font-semibold border rounded-xl transition-all duration-300 ease-out no-underline shadow-sm max-sm:w-[38px] max-sm:h-[38px] max-sm:text-[0.85rem] max-sm:rounded-lg' %}
										{% set linkNormalClasses = 'text-gray-800 bg-white border-gray-200 hover:text-primary hover:border-primary hover:shadow-md hover:-translate-y-0.5' %}
										{% set linkActiveClasses = 'text-white bg-primary border-primary shadow-lg' %}
										{% set linkDisabledClasses = 'opacity-50 text-gray-500 bg-gray-50 border-gray-200 cursor-not-allowed pointer-events-none' %}

										<li class="m-0 list-none">
										{% if pageInfo.prevUrl %}
												<a class="{{ linkBaseClasses }} {{ linkNormalClasses }}" href="{{ pageInfo.prevUrl }}" aria-label="Previous">
													<span aria-hidden="true">&laquo;</span>
													<span class="sr-only">Previous</span>
												</a>
										{% else %}
												<span class="{{ linkBaseClasses }} {{ linkDisabledClasses }}" aria-label="Previous">
													<span aria-hidden="true">&laquo;</span>
													<span class="sr-only">Previous</span>
												</span>
										{% endif %}
										</li>

										{% for page, url in pageInfo.getPrevUrls(2) %}
											<li class="m-0 list-none">
												<a class="{{ linkBaseClasses }} {{ linkNormalClasses }}" href="{{ url }}">{{ page }}</a>
											</li>
										{% endfor %}

										<li class="m-0 list-none" aria-current="page">
											<span class="{{ linkBaseClasses }} {{ linkActiveClasses }}">{{ pageInfo.currentPage }}</span>
										</li>

										{% for page, url in pageInfo.getNextUrls(2) %}
											<li class="m-0 list-none">
												<a class="{{ linkBaseClasses }} {{ linkNormalClasses }}" href="{{ url }}">{{ page }}</a>
											</li>
										{% endfor %}

										<li class="m-0 list-none">
										{% if pageInfo.nextUrl %}
												<a class="{{ linkBaseClasses }} {{ linkNormalClasses }}" href="{{ pageInfo.nextUrl }}" aria-label="Next">
													<span aria-hidden="true">&raquo;</span>
													<span class="sr-only">Next</span>
												</a>
										{% else %}
												<span class="{{ linkBaseClasses }} {{ linkDisabledClasses }}" aria-label="Next">
													<span aria-hidden="true">&raquo;</span>
													<span class="sr-only">Next</span>
												</span>
										{% endif %}
										</li>
									</ul>
								</nav>
							{% endif %}

						{% else %}
							<div class="text-center py-16 bg-gray-50 rounded-2xl">
								<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-search text-gray-300 mb-6 mx-auto" viewbox="0 0 16 16">
									<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
								</svg>
								<h3 class="text-2xl font-bold text-gray-600 mb-4">No results found for "{{ searchQuery }}"</h3>
								<p class="text-gray-500 mb-0">Try checking your spelling or using more general terms.</p>
							</div>
						{% endif %}
					{% endif %}
				</div>
			</div>
		</div>
	{% endblock %}
