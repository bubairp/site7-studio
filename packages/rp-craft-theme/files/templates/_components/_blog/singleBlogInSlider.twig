{% import "_macros/images" as images %}
{% set shortDescriptionLength = getenv('DISPLAY_SHORT_DESCRIPTION_LENGTH') %}

<div class="swiper-slide h-auto pb-1">
	<article class="masonry-grid-item h-full">
		<div class="tw-card card-hover flex flex-col h-full group relative">
			{% if blog.image|length %}
				<a href="{{ blog.url }}" class="block overflow-hidden rounded-t-2xl md:rounded-t-3xl">
					<div>{{ images.singleImg(blog.image.0, 420, {'ratio': 1.55}, 'shrink-0 w-full object-cover transition-transform duration-500 group-hover:scale-105') }}</div>
				</a>
			{% endif %}
			<div class="tw-card-body flex-grow p-6">
				<div class="flex flex-wrap items-center gap-2 mb-4 text-xs font-semibold uppercase tracking-wider text-slate-500">
					{% set displayDate = blog.date ?? blog.postDate %}
					{% if displayDate %}
						<span>{{ displayDate|date('M d, Y') }}</span>
					{% endif %}
					{% set blogCats = blog.blogCategories.all() %}
					{% if blogCats|length %}
						<span class="opacity-30">&bull;</span>
						{% for cat in blogCats %}
							<a class="text-primary hover:underline relative z-20" href="/blogs?category={{ cat.slug }}">{{ cat.title }}</a>
						{% endfor %}
					{% endif %}
				</div>
				<h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
					<a href="{{ blog.url }}" class="text-inherit no-underline hover:text-primary transition-colors">{{ blog.title }}</a>
				</h3>
				<p class="tw-card-text text-sm leading-relaxed">
					{{ blog.shortDescription|slice(0, shortDescriptionLength) }}
					{% if blog.shortDescription|length > shortDescriptionLength %}...{% endif %}
				</p>
			</div>
			<div class="mt-auto px-6 pb-6 pt-4 flex justify-between items-center text-slate-500 border-t border-gray-50 dark:border-gray-800/40">
				<span class="text-xs font-semibold">By {{ blog.authorName }}</span>
				<span class="text-primary flex items-center gap-1 group-hover:text-dark dark:group-hover:text-white transition-colors">
					<span class="text-xs font-bold uppercase tracking-wider">Read Blog</span>
					<i class="ti ti-arrow-right text-base transform group-hover:translate-x-1 transition-transform"></i>
				</span>
			</div>
		</div>
	</article>
</div>
