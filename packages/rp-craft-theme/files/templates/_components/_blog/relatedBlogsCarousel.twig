{% import "_macros/utils" as utils %}
{% if generalEntry.relatedBlogs | length %}
	{% set relatedBlogs = craft.entries().section('blogs').relatedTo(entry.blogCategories).id('not ' ~ entry.id).with(['image', 'blogCategories', 'tags']).orderBy('postDate DESC').limit(12).all() %}
	{% if relatedBlogs | length %}
		<div class="flex items-center pb-4 mb-4 lg:mb-6 mt-2 2xl:mt-4">
			<h2 class="w-full text-3xl font-bold mb-0 text-{{ generalEntry.blogTextAlign.value|replace({'start': 'left', 'end': 'right'}) }}" style="color: {{ generalEntry.blogTitleColor.one().colorcode ?? '' }}">Related Blogs</h2>
		</div>

		<div class="swiper" data-swiper-options='{{ utils.swiperConfig(generalEntry.blogColumnPerRow.value, 24, true, true) }}'>
			<div class="swiper-wrapper">
				{% for blog in relatedBlogs %}
					{% include "_components/_blog/singleBlogInSlider.twig" with { blog: blog } %}
				{% endfor %}
			</div>
			<div class="swiper-pagination relative bottom-0 mt-4 pt-2"></div>
		</div>
	{% endif %}
{% endif %}
