{#
    ================================================================
    cardItem.twig – unified universal-card renderer
    ================================================================
    Replaces universalCardItem.twig + customUniversalCardItem.twig,
    which were ~90% identical (same padding/title/icon-size maps,
    aspect-ratio logic, look/corner classes, card class building) and
    differed only in where they read title/description/link/date/tags
    from. `isCustom` selects which source shape to read:

    isCustom = false (default) — a related CMS entry (blog/product/
    portfolio/casestudy/service/team/testimonial): title/shortDescription/
    url/postDate/tags come straight off the entry.

    isCustom = true — a Matrix "custom item" repeater row: plainText/
    Description/linkUrl (a Link field with .url/.urlSuffix/.target/.label)/
    switchOff (hides the button) instead.
    ================================================================
#}
{% import "_macros/images" as images %}
{% set isCustom = isCustom ?? false %}

{# Link Handling #}
{% if isCustom %}
	{% set link = item.linkUrl ?? null %}
	{% set hideButton = item.switchOff ?? false %}
	{% if link %}
		{% set href = link.url ~ (link.urlSuffix ?? '') %}
	{% endif %}
{% else %}
	{% set link = item.url ?? null %}
	{% set hideButton = false %}
{% endif %}
{% set tagName = link ? 'a' : 'div' %}

{# Styles & Variants #}
{% set styleClass = cardStyle ?? 'bg-gray-200' %}
{% set variant = cardVariant ?? 'default' %}
{% set look = cardLook ?? 'default' %}
{% set corner = cornerStyle ?? 'default' %}
{% set aspect = aspectRatio ?? 'default' %}
{% set align = cardAlignClass ?? 'text-left' %}
{% set mappedAlign = align|replace({'text-start': 'text-left', 'text-end': 'text-right', 'text-center': 'text-center'}) %}

{# Data Normalization & Truncation #}
{% set charLimit = (variant in ['imageTop', 'imageBottom', 'iconTop']) ? 120 : (variant in ['imageLeft', 'imageRight']) ? 160 : (variant == 'imageOverlay') ? 100 : (variant == 'minimal') ? 140 : 120 %}
{% set rawDescription = (isCustom ? (item.Description ?? '') : (item.shortDescription ?? ''))|striptags|trim %}
{% set truncatedDescription = rawDescription|length > charLimit ? (rawDescription|slice(0, charLimit) ~ '...') : rawDescription %}

{# Padding Mapping #}
{% set paddingMap = {
	'none': 'p-0',
	'sm': 'p-2',
	'md': 'p-3 md:p-4 md:p-6',
	'lg': 'p-4 md:p-6',
	'xl': 'p-6 md:p-8'
} %}
{% set cardPaddingClass = paddingMap[cardPadding] ?? '' %}

{# Title Size Mapping #}
{% set titleSizeMap = {
	'xs': 'text-base font-bold',
	'sm': 'text-lg font-bold',
	'md': 'text-xl font-bold',
	'lg': 'text-2xl font-bold',
	'xl': 'text-3xl font-bold',
	'default': 'text-xl font-bold'
} %}
{% set titleSizeClass = titleSizeMap[titleSize] ?? 'text-xl font-bold' %}

{# Icon Size Mapping #}
{% set iconSizeMap = {
	'small': 32,
	'medium': 48,
	'large': 64,
	'default': 48
} %}
{% set iconSizeValue = iconSizeMap[iconSize] ?? 48 %}

{# Button Logic #}
{% set showButton = (link and not hideButton) ? true : false %}

{% set itemData = {
	'title': isCustom ? item.plainText : item.title,
	'description': truncatedDescription,
	'image': item.image ?? [],
	'postDate': isCustom ? null : (item.postDate ?? null),
	'tags': isCustom ? [] : (item.tags ?? []),
	'url': isCustom ? (href ?? '#') : item.url,
	'linkText': isCustom ? (link.label|default(cardLinkLabel)|default('Read more'|t)) : (cardLinkLabel|default('Read more'|t))
} %}

{# Aspect Ratio Mapping #}
{% set ratioClass = '' %}
{% set numericRatio = 1 %}
{% if aspect == 'square' or aspect == '1:1' %}
	{% set ratioClass = 'aspect-square' %}
	{% set numericRatio = 1 %}
{% elseif aspect == 'fourThree' or aspect == '4:3' %}
	{% set ratioClass = 'aspect-4/3' %}
	{% set numericRatio = 4/3 %}
{% elseif aspect == 'sixteenNine' or aspect == '16:9' %}
	{% set ratioClass = 'aspect-video' %}
	{% set numericRatio = 16/9 %}
{% elseif (variant == 'imageLeft' or variant == 'imageRight') %}
	{% set ratioClass = 'aspect-square max-md:aspect-video' %}
	{% set numericRatio = 1 %}
{% elseif variant == 'imageOverlay' %}
	{% set ratioClass = 'aspect-square' %}
	{% set numericRatio = 1 %}
{% elseif variant in ['default', 'imageTop', 'imageBottom', 'iconTop'] %}
	{% set ratioClass = 'aspect-video' %}
	{% set numericRatio = 1.77 %}
{% endif %}

{# Map Styles to Classes #}
{% set lookClass = (look == 'softShadow') ? 'shadow-sm border-0' : (look == 'outlined' ? 'border' : (look == 'highlighted' ? 'border border-2 border-primary' : 'border-0')) %}
{% set cornerClass = (corner == 'normal') ? 'rounded-none' : (corner == 'slightlyRounded' ? 'rounded-sm' : 'rounded-xl') %}

{# Final Layout Refinements #}
{% set cardClass = 'relative flex flex-col h-full no-underline bg-white break-words bg-clip-border universal-card-premium overflow-hidden ' ~ lookClass ~ ' ' ~ cornerClass ~ ' ' ~ mappedAlign ~ ' ' ~ cardPaddingClass %}
{% if look == 'highlighted' %}
	{% set cardClass = cardClass ~ ' universalCard-premium-highlighted' %}
{% endif %}

{# Variant-specific background & layout #}
{% set cardClass = (variant in ['imageTop', 'imageBottom', 'iconTop']) ? (cardClass ~ ' bg-gray-100 border-0') : (variant == 'default' ? (cardClass ~ ' bg-transparent border-0') : (cardClass ~ ' ' ~ styleClass)) %}

{% if variant == 'imageLeft' or variant == 'imageRight' %}
	{% set cardClass = cardClass ~ ' flex flex-col md:flex-row' ~ (variant == 'imageRight' ? ' md:flex-row-reverse' : '') %}
{% elseif variant == 'imageOverlay' %}
	{% set cardClass = cardClass ~ ' text-white overflow-hidden border-0' %}
{% endif %}

{# Layout Inclusion Logic #}
{% set layoutFile = (variant in ['imageLeft', 'imageRight']) ? 'imageSide' : (variant in ['imageOverlay', 'imageTop', 'imageBottom', 'iconTop', 'minimal'] ? variant : 'default') %}

{% if itemData.image|length and variant != 'minimal' %}
	{% set imgHtml = images.singleImg(itemData.image.0, 600, {'ratio': numericRatio, 'class': 'w-full h-full object-cover'}, 'w-full h-full') %}
	{% set imgHtml = imgHtml|replace('<picture>', '<picture class="block w-full h-full">') %}
{% else %}
	{% set imgHtml = '' %}
{% endif %}

<{{tagName}} {% if link %} href="{{ itemData.url }}" {% if isCustom and link.target %} target="{{ link.target }}" {% endif %} {% endif %} class="{{ cardClass }}">

	{% include "_components/_universal-card/_variants/" ~ layoutFile ~ ".twig" %}

</{{tagName}}>
