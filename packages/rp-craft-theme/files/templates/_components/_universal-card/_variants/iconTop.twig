{% import "_macros/images" as images %}

<div class="p-4 flex-auto last-0">
	{% if itemData.image|length %}
		<div class="block {{ ('center' in mappedAlign) ? 'mx-auto' : (('right' in mappedAlign or 'end' in mappedAlign) ? 'ms-auto me-0' : 'ms-0 me-auto') }} mb-4" style="width: {{ iconSizeValue }}px;">{{ images.singleImg(itemData.image.0, iconSizeValue, {'ratio': 1}, 'shrink-0 w-full h-full object-contain') }}</div>
	{% endif %}
	<h3 class="{{ titleSizeClass }} universalCard-title tw-service-heading-title mb-2">{{ itemData.title }}</h3>
	{% if itemData.description|length %}
		<div class=" universalCard-content tw-service-content-style last-0">{{ itemData.description }}</div>
	{% endif %}

	{% if showButton %}
		<div class="mt-3">
			<div class="tw-btn {{ colorPalette }} rounded-full  after:absolute after:inset-0 after:z-10 after:content-['']">{{ itemData.linkText }}</div>
		</div>
	{% endif %}
</div>
