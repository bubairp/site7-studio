{% set ratioClass = ratioClass ?? 'aspect-square' %}

<div class="img-zoom-wrapper {{ ratioClass }}">{{ imgHtml|raw }}</div>
<div class="absolute inset-0 z-20 rounded-none flex flex-col justify-end p-4 md:p-6 last-0" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0) 100%);">
	<h3 class="{{ titleSizeClass }} universalCard-title tw-service-heading-title text-white mb-2 font-semibold">{{ itemData.title }}</h3>
	{% if itemData.description|length %}
		<div class=" universalCard-content tw-service-content-style last-0 opacity-80 text-white">{{ itemData.description }}</div>
	{% endif %}

	{% if showButton %}
		<div class="mt-3">
			<div class="tw-btn {{ colorPalette }} rounded-full after:absolute after:inset-0 after:z-10 after:content-['']">{{ itemData.linkText }}</div>
		</div>
	{% endif %}
</div>
