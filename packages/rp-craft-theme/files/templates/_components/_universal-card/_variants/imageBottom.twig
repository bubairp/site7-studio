{% set ratioClass = ratioClass ?? 'aspect-video' %}

<div
	class="p-4 flex-auto p-4 md:p-6 pb-4 last-0">
	{# Metadata for Blog-style parity #}
	{% if itemData.postDate is defined or itemData.tags is defined %}
		<div class="flex items-center mb-3 -mt-1 text-sm text-gray-500">
			{% if itemData.postDate %}
				<span class="text-sm text-gray-500">{{ itemData.postDate|date('M d, Y') }}</span>
			{% endif %}
			{% if itemData.tags|length %}
				<span class="text-xs opacity-20 mx-2">|</span>
				<span class="inline-flex items-center rounded px-2 py-1 text-xs border bg-white">{{ itemData.tags.one().title ?? '' }}</span>
			{% endif %}
		</div>
	{% endif %}

	<h3 class="{{ titleSizeClass }} universalCard-title tw-service-heading-title mb-2 font-semibold">{{ itemData.title }}</h3>
	{% if itemData.description|length %}
		<div class=" universalCard-content tw-service-content-style last-0 opacity-80">{{ itemData.description }}</div>
	{% endif %}

	{% if showButton %}
		<div class="mt-3">
			<div class="tw-btn {{ colorPalette }} rounded-full  after:absolute after:inset-0 after:z-10 after:content-['']">{{ itemData.linkText }}</div>
		</div>
	{% endif %}
</div>
<div class="img-zoom-wrapper {{ ratioClass }} overflow-hidden">{{ imgHtml|raw }}</div>
