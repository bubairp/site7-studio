{% set sideRoundedClass = (variant == 'imageLeft' ? 'md:rounded-l-xl md:rounded-r-none' : 'md:rounded-r-xl md:rounded-l-none') ~ ' rounded-t-xl md:rounded-t-none' %}
{% set ratioClass = ratioClass ?? 'aspect-square' %}

<div class="img-zoom-wrapper shrink-0 md:flex-none md:w-[40%]">
	<div class="h-full w-full {{ ratioClass }} {{ sideRoundedClass }} overflow-hidden">{{ imgHtml|raw }}</div>
</div>
<div class="p-4 md:p-6 flex-auto flex flex-col justify-center last-0">
	<h3 class="{{ titleSizeClass }} universalCard-title tw-service-heading-title mb-2 font-semibold">{{ itemData.title }}</h3>
	{% if itemData.description|length %}
		<div class=" universalCard-content tw-service-content-style last-0 opacity-80">{{ itemData.description }}</div>
	{% endif %}

	{% if showButton %}
		<div class="mt-3">
			<div class="tw-btn {{ colorPalette }} rounded-full  after:absolute after:inset-0 after:z-10 after:content-['']">{{ itemData.linkText }}</div>
		</div>
	{% endif %}
</div>
