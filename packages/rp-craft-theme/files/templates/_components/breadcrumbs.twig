{# Breadcrumbs #}

{% if generalEntry.showBreadcrumbsDefault is defined and generalEntry.showBreadcrumbsDefault|length %}
	{% set element = element ?? entry ?? null %}
	{% if not element %}
		{% exit %}
	{% endif %}

	{% set segs = craft.app.request.segments %}
	{% set isHome = segs|length == 0 or (element.uri ?? null) == '__home__' %}
	{% set hideHome = hideHome ?? false %}
	{% set hideSectionLink = hideSectionLink ?? false %}

	{% if not isHome %}
		<div class="w-full border-y border-solid border-gray-200 dark:border-gray-800">
			<div class="container mx-auto px-4">
				<nav aria-label="breadcrumb">
					<ol class="py-3 flex flex-wrap items-center list-none m-0 p-0 gap-y-1">

						{% if not hideHome %}
							<li class="flex items-center text-xs md:text-sm text-gray-600 dark:text-gray-400 before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden">
								<a href="{{ siteUrl }}" class="no-underline hover:text-primary transition-colors">{{ 'Home'|t }}
								</a>
							</li>
						{% endif %}

						{# 1. Check for Category Relationship (using Entry Structure 'productCategory') #}
						{% set productCategory = craft.entries.section('productCategory').relatedTo(element).one() %}

						{% if productCategory %}
							{% if not hideSectionLink %}
								<li class="flex items-center text-xs md:text-sm text-gray-600 dark:text-gray-400 before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden">
									<a href="{{ siteUrl('book-categories') }}" class="no-underline hover:text-primary transition-colors">{{ customBaseLabel ?? 'Book Categories'|t }}</a>
								</li>
							{% endif %}
							{% for c in productCategory.ancestors().all() %}
								<li class="flex items-center text-xs md:text-sm text-gray-600 dark:text-gray-400 before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden">
									<a href="{{ c.url }}" class="no-underline hover:text-primary transition-colors">{{ c.title }}</a>
								</li>
							{% endfor %}
							<li class="flex items-center text-xs md:text-sm text-gray-600 dark:text-gray-400 before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden">
								<a href="{{ productCategory.url }}" class="no-underline hover:text-primary transition-colors">{{ productCategory.title }}</a>
							</li>
							<li class="flex items-center text-xs md:text-sm font-semibold text-gray-900 dark:text-white before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden" aria-current="page">{{ element.title }}</li>

							{# 2. Standard Structures or Sections #}
						{% elseif (element.structureId ?? null) or (element.group is defined) %}
							{% set baseSeg = segs|length ? segs[0] : null %}
							{% set sectionName = (element.section.name ?? element.group.name ?? null)|t %}

							{% if not hideSectionLink %}
								{% if baseSeg and sectionName and sectionName != 'Standard Pages'|t and sectionName != element.title and (element.section.type ?? null) != 'single' %}
									<li class="flex items-center text-xs md:text-sm text-gray-600 dark:text-gray-400 before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden">
										<a href="{{ siteUrl(baseSeg) }}" class="no-underline hover:text-primary transition-colors">{{ customBaseLabel ?? sectionName ?? baseSeg|replace({'-':' '})|title|t }}</a>
									</li>
								{% endif %}
							{% endif %}

							{% for c in element.ancestors().all() %}
								<li class="flex items-center text-xs md:text-sm text-gray-600 dark:text-gray-400 before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden">
									<a href="{{ c.url }}" class="no-underline hover:text-primary transition-colors">{{ c.title }}</a>
								</li>
							{% endfor %}

							<li class="flex items-center text-xs md:text-sm font-semibold text-gray-900 dark:text-white before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden" aria-current="page">{{ element.title }}</li>

							{# 3. Everything else (Fallback Segment Builder) #}
						{% else %}
							{% set path = '' %}
							{% set crumbs = [] %}
							{% for s in segs %}
								{% set path = path ~ '/' ~ s %}
								{% set e = craft.entries().uri(path|trim('/')).siteId(currentSite.id).one() %}
								{% if e %}
									{% set crumbs = crumbs|merge([{ url: e.url, label: e.title }]) %}
								{% else %}
									{% set crumbs = crumbs|merge([{ url: siteUrl(path|trim('/')), label: s|t|title }]) %}
								{% endif %}
							{% endfor %}

							{% set startIdx = hideHome ? 1 : 0 %}
							{% set crumbs = crumbs|slice(startIdx) %}
							{% if hideSectionLink and crumbs|length > 1 %}
								{% set crumbs = [crumbs|first]|merge(crumbs|slice(2)) %}
							{% endif %}

							{% for c in crumbs|slice(0, -1) %}
								<li class="flex items-center text-xs md:text-sm text-gray-600 dark:text-gray-400 before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden">
									<a href="{{ c.url }}" class="no-underline hover:text-primary transition-colors">{{ c.label }}</a>
								</li>
							{% endfor %}

							<li class="flex items-center text-xs md:text-sm font-semibold text-gray-900 dark:text-white before:content-['/'] before:mx-2 before:text-gray-400 first:before:hidden" aria-current="page">{{ (crumbs|last).label ?? element.title }}</li>
						{% endif %}

					</ol>
				</nav>
			</div>
		</div>
	{% endif %}
{% endif %}
