{% import "_macros/images" as images %}
{% import "_macros/ratings" as ratings %}

<div class="group flex flex-col h-full p-6 lg:p-8 tw-card">
	<div class="flex items-center mb-6">
		{% if testimonial.image|length %}
			<div class="shrink-0 mr-4">
				{{ images.singleImg(testimonial.image.0, 64, {'ratio': 1}, 'w-16 h-16 rounded-full object-cover shadow-sm') }}
			</div>
		{% endif %}
		<div>
			<h4 class="text-lg font-bold text-gray-900 dark:text-white mb-0.5">{{ testimonial.authorName }}</h4>
			<p class="text-sm text-gray-500 dark:text-gray-400 mb-1">{{ testimonial.authorRole }}</p>
			<div class="flex items-center text-warning">
				{{ ratings.stars(testimonial.ratings, '14px') }}
			</div>
		</div>
	</div>
	<div class="relative">
		<i class="ti ti-quote absolute -top-2 -left-2 text-4xl text-gray-100 dark:text-gray-800 -z-10 transform -scale-x-100"></i>
		<p class="text-gray-700 dark:text-gray-300 font-light leading-relaxed italic z-10 relative">"{{ testimonial.comment }}"</p>
	</div>
</div>
