{% import "_macros/images" as images %}
<div class="group relative flex flex-col h-full tw-card card-hover">
	{% if team.image|length %}
		<div class="relative aspect-square overflow-hidden bg-gray-100 dark:bg-gray-800">
			{{ images.singleImg(team.image.0, 600, {'ratio': 1}, 'w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none', { alt: team.title }) }}
		</div>
	{% endif %}
	<div class="p-5 md:p-6 text-center flex flex-col flex-1">
		<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1">{{ team.title }}</h3>
		<p class="text-primary font-medium text-sm mb-4">{{ team.plainTextRole }}</p>

		{# A11Y-02: Social links use z-20 + main card link uses z-10 overlay — tab order is now logical
		   Social buttons come BEFORE the overlay, so they get focus first (correct UX).
		   The overlay is aria-hidden so it's skipped by screen readers; title h3 is the readable content. #}
		<div class="flex justify-center gap-2 mt-auto relative z-20">
			{% set socialMedia = team.socialMedia.all() %}
			{% if socialMedia|length %}
				{% for social in socialMedia %}
					{# A11Y-03: Dynamic aria-label based on platform name or URL #}
					<a href="{{ social.linkUrl }}"
					   class="w-9 h-9 rounded-full flex items-center justify-center bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:outline-none"
					   aria-label="{{ social.linkUrl|replace({'https://': '', 'http://': '', 'www.': ''})|split('.')|first|capitalize }} profile for {{ team.title }}"
					   target="_blank" rel="noopener noreferrer">
						{% if social.iconClass|length %}
							<i class="{{ social.iconClass }}" aria-hidden="true"></i>
						{% elseif social.iconImage|length %}
							{{ images.singleImg(social.iconImage.one(), 24, {}, 'w-4 h-4') }}
						{% endif %}
					</a>
				{% endfor %}
			{% endif %}
			{% if team.email %}
				<a href="mailto:{{ team.email }}"
				   class="w-9 h-9 rounded-full flex items-center justify-center bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:outline-none"
				   aria-label="Email {{ team.title }}">
					<i class="ti ti-mail" aria-hidden="true"></i>
				</a>
			{% endif %}
		</div>
	</div>
	{# A11Y-02: Overlay link is last in DOM + aria-hidden so it doesn't interfere with tab order #}
	<a href="{{ team.url }}" class="absolute inset-0 z-10" aria-hidden="true" tabindex="-1"></a>
</div>
