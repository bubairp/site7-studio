{# Trending Card Component #}
{# Expected variables: product (entry), rank (number) #}

{# Card output is identical for a given product+rank everywhere it appears, so cache
   it globally. The product entry is passed in (not queried here), so Craft can't tag
   this cache with it — meaning a changed cover image or title would NOT invalidate
   the card. Including product.dateUpdated in the key busts the cache on any product
   edit; re-uploading the same asset is still auto-invalidated via the image query. #}
{% cache globally using key 'trending-card-' ~ product.id ~ '-' ~ (rank ?? 1) ~ '-' ~ product.dateUpdated.timestamp %}
{# Pre-calculate rating info #}
{% set reviewQuery = craft.entries().section('productReview').relatedTo({ targetElement: product.id, field: 'singleSelect' }).status('live') %}
{% set reviewCount = reviewQuery.count() %}
{% set allReviews = reviewQuery.all() %}
{% set totalRate = 0 %}
	{% for r in allReviews %}
{% set totalRate = totalRate + (r.rate ?? 0) %}
{% endfor %}
{% set avgRating = reviewCount > 0 ? (totalRate / reviewCount)|number_format(1) : '0.0' %}

{% set category = product.productCategory.one() %}
{% set author = product.selectAuthor.one() %}

	<a href="{{ product.url }}" class="flex flex-row gap-4 items-center p-4 lg:p-6 no-underline h-full tw-card group relative"> 
	
	{# Rank Badge #}
	<div class="shrink-0 flex items-center justify-center rounded-xl font-bold text-xl bg-primary/10 text-primary leading-none" style="width: 48px; height: 48px;">
		#{{ rank ?? 1 }}
	</div>

	{# Content #}
	<div class="flex flex-col grow justify-center overflow-hidden w-full">
		<div class="flex justify-between items-center mb-1">
			{% if category %}
				<span class="inline-block px-2 py-1 text-[10px] font-bold tracking-wider uppercase rounded-full text-success bg-success/10">{{ category.title }}</span>
			{% else %}
				<span class="inline-block px-2 py-1 text-[10px] font-bold tracking-wider uppercase rounded-full text-success bg-success/10">{{ 'Popular'|t }}</span>
			{% endif %}

			<div class="flex items-center gap-1 font-bold text-gray-900 dark:text-white text-xs bg-gray-50 dark:bg-gray-800 px-2 py-1 rounded-full">
				<i class="ti ti-star-filled text-warning text-xs"></i>
				<span>{{ avgRating }}</span>
			</div>
		</div>

		<h3 class="text-base lg:text-lg font-bold text-gray-900 dark:text-white mb-1 truncate">{{ product.title }}</h3>

		<p class="text-xs text-gray-500 dark:text-gray-400 mb-0 font-medium">{{ author ? author.title : '' }}</p>

		<div class="flex items-center gap-3 mt-3">
			<div class="flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
				<i class="ti ti-users text-sm"></i>
				<span>{{ reviewCount }} {{ 'Reviews'|t }}</span>
			</div>
			<div class="flex items-center gap-1 text-xs text-primary font-bold">
				<i class="ti ti-trending-up text-sm"></i>
				<span>{{ 'Trending'|t }}</span>
			</div>
		</div>
	</div>
</a>
{% endcache %}
