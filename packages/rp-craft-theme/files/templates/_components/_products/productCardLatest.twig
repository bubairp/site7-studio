{% import '_macros/images' as images %}

{# Card output is identical for a given product everywhere it appears, so cache it
   globally. The product entry is passed in (not queried here), so Craft can't tag
   this cache with it — meaning a changed cover image or title would NOT invalidate
   the card. Including product.dateUpdated in the key busts the cache on any product
   edit; re-uploading the same asset is still auto-invalidated via the image query. #}
{% cache globally using key 'product-card-latest-' ~ product.id ~ '-' ~ product.dateUpdated.timestamp %}
{# Pre-calculate rating info #}
{% set reviewQuery = craft.entries().section('productReview').relatedTo({ targetElement: product.id, field: 'singleSelect' }).status('live') %}
{% set reviewCount = reviewQuery.count() %}
{% set allReviews = reviewQuery.all() %}
{% set totalRate = 0 %}
{% for r in allReviews %}
	{% set totalRate = totalRate + (r.rate ?? 0) %}
{% endfor %}
{% set avgRating = reviewCount >0 ? (totalRate / reviewCount)|number_format(1) : '0.0' %}<div class="relative tw-card group h-full">

	{# Top Gradient Overlay #}
	<div class="absolute inset-x-0 top-0 h-24 bg-linear-to-b from-black/60 to-transparent z-10 pointer-events-none"></div>

	{# Image Section #}
	<div class="relative h-full w-full overflow-hidden bg-gray-100 dark:bg-gray-800">
		{% if product.image|length %}
			<a href="{{ product.url }}" class="block w-full h-full">{{ images.singleImg(product.image.one(), 400, {'ratio': 300/424}, 'w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-105 motion-reduce:transform-none') }}</a>
		{% endif %}
	</div>

	{# Top Overlays: Category and Rating #}
	<div class="absolute top-0 left-0 right-0 p-6 flex justify-between items-center z-20">
		{% set category = product.productCategory.one() %}
		{% if category %}
			<span class="inline-block px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white bg-primary rounded-full">{{ category.title }}</span>
		{% endif %}

		<div class="flex items-center gap-1 text-white font-bold bg-black/30 backdrop-blur-md px-2 py-1 rounded-full">
			<i class="ti ti-star-filled text-warning text-xs"></i>
			<span class="text-xs">{{ avgRating }}</span>
		</div>
	</div>

	{# Bottom Overlay: Content and Button #}
	<div class="absolute bottom-0 left-0 right-0 p-6 pt-16 z-20 text-left bg-linear-to-t from-black/90 via-black/70 to-transparent backdrop-blur-[2px]">
		<div class="text-white mb-4">
			<h3 class="text-xl text-white mb-1 font-bold line-clamp-2">
				<a href="{{ product.url }}" class="text-inherit no-underline hover:text-primary transition-colors after:absolute after:inset-0">{{ product.title }}</a>
			</h3>
			{%- set author = product.selectAuthor.one() %}
			<p class="text-sm opacity-80 mb-0 line-clamp-1 font-light">{{ author ? author.title : '' }}</p>
		</div>
		<div class="flex items-center text-primary font-bold text-sm group-hover:translate-x-1 transition-transform relative z-30">
			{{ 'View Details'|t }} <i class="ti ti-arrow-right ml-1"></i>
		</div>
	</div>
</div>
{% endcache %}
