{% import '_macros/images' as images %}

{# Cache globally, busted on any product edit #}
{% cache globally using key 'product-card-' ~ product.id ~ '-' ~ product.dateUpdated.timestamp %}
{# Pre-calculate rating info #}
{% set reviewQuery = craft.entries().section('productReview').relatedTo({ targetElement: product.id, field: 'singleSelect' }).status('live') %}
{% set reviewCount = reviewQuery.count() %}
{% set allReviews = reviewQuery.all() %}
{% set totalRate = 0 %}
{% for r in allReviews %}
	{% set totalRate = totalRate + (r.rate ?? 0) %}
{% endfor %}
{% set avgRating = reviewCount > 0 ? (totalRate / reviewCount)|number_format(1) : '0.0' %}

{# B1: Use tw-card — removes duplicated card styles and aligns with design system #}
<div class="group relative flex flex-col h-full tw-card card-hover text-left">
	{# Product Image #}
	{% set category = product.productCategory ? product.productCategory.one() : null %}
	{% if product.image ? product.image|length : false %}
		{# B1/CARD-01: aspect-[400/268] replaces inline style="aspect-ratio:..." #}
		<div class="relative overflow-hidden aspect-[400/268] bg-gray-100 dark:bg-gray-800 w-full">
			{% if category %}
				{# RADIUS-03: tw-badge-category shared class #}
				<span class="absolute top-3 left-3 z-10 tw-badge-category bg-white/90 dark:bg-dark/90 backdrop-blur-sm shadow-sm">{{ category.title }}</span>
			{% endif %}
			<a href="{{ product.url }}" class="block w-full h-full" tabindex="-1" aria-hidden="true">
				{{ images.singleImg(product.image.one(), 400, {'ratio': 400/268}, 'w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none', { alt: product.title }) }}
			</a>
		</div>
	{% else %}
		<div class="relative overflow-hidden aspect-[400/268] bg-gray-100 dark:bg-gray-800 w-full">
			{% if category %}
				<span class="absolute top-3 left-3 z-10 tw-badge-category bg-white/90 dark:bg-dark/90 backdrop-blur-sm shadow-sm">{{ category.title }}</span>
			{% endif %}
		</div>
	{% endif %}

	<div class="p-5 md:p-6 flex flex-col grow">
		{# Title — A11Y-01: full title for screen readers via aria-label #}
		<h3 class="text-xl font-bold mb-2 text-gray-900 dark:text-white line-clamp-2">
			<a href="{{ product.url }}" class="text-inherit no-underline hover:text-primary transition-colors after:absolute after:inset-0" aria-label="{{ product.title }} — View Details">{{ product.title }}</a>
		</h3>

		{# Author / Description preview #}
		{% set author = product.selectAuthor ? product.selectAuthor.one() : null %}
		{% if author %}
			<p class="text-gray-500 dark:text-gray-400 text-sm mb-4 line-clamp-1">{{ author.title }}</p>
		{% elseif product.productDiscription %}
			{# TW-03: line-clamp-1 replaces truncate for single-line overflow #}
			<p class="text-gray-500 dark:text-gray-400 text-sm mb-4 line-clamp-1">{{ product.productDiscription|striptags|truncate(60) }}</p>
		{% endif %}

		{# Footer Row — CARD-04: unified border-gray-100 dark:border-gray-800 #}
		<div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100 dark:border-gray-800">
			<div class="flex items-center gap-1 bg-gray-50 dark:bg-gray-800 px-2.5 py-1 rounded-full border border-gray-100/50 dark:border-gray-700/50">
				<span class="text-warning flex items-center">
					<i class="ti ti-star-filled text-xs"></i>
				</span>
				<span class="font-extrabold text-xs text-gray-950 dark:text-white">{{ avgRating }}</span>
				{# TW-02: text-xs (12px) instead of text-[10px] — min accessible size #}
				<span class="text-gray-400 dark:text-gray-500 text-xs">({{ reviewCount }})</span>
			</div>
			<span class="text-primary text-sm font-bold flex items-center group-hover:translate-x-1 motion-reduce:transform-none transition-transform" aria-hidden="true">
				{{ 'Details'|t }} <i class="ti ti-arrow-right ml-1"></i>
			</span>
		</div>
	</div>
</div>
{% endcache %}
