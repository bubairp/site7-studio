{% if generalEntry.relatedProducts | length %}
	{% set relatedProducts = craft.entries().section('products').id('not ' ~ entry.id).with(['image', 'productCategory', 'selectAuthor']).orderBy('postDate DESC').limit(12).all() %}
	{% if relatedProducts | length %}
		<div class="swiper" data-swiper-options='
								{
								"spaceBetween": 24,
								"pagination": {
									"el": ".swiper-pagination",
									"clickable": true
								},
								"breakpoints": {
									"576": { "slidesPerView": 2 },
									"992": { "slidesPerView": {{ generalEntry.productColumnPerRow.value }} }
								},
								"autoplay": {
									"delay": 3000,
									"disableOnInteraction": false
								},
								"speed": 1000,
								"loop": true
								}
							'>
			<div class="swiper-wrapper">
				{% for product in relatedProducts %}
					{% include "_components/_products/singleProductInSlider.twig" with { product: product } %}
				{% endfor %}
			</div>
			<div class="swiper-pagination relative bottom-0 mt-4 pt-2"></div>
		</div>
	{% endif %}
{% endif %}
