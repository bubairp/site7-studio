{% extends "_layouts/entry" %}

{# Provide entry fallback for layout dependency #}
{% set entry = entry ?? craft.entries.section('general').one() %}
{% block content %}
	<div class="container mx-auto py-12  mt-12">
		<div class="flex justify-center">
			<div class="w-full md:w-1/2 text-center">
				<div class="tw-card p-12 text-center max-w-2xl mx-auto mt-12">
					<div class="mb-6">
						<i class="ti ti-info-circle text-warning" style="font-size: 80px;"></i>
					</div>
					<h1 class="font-bold mb-4">Payment Cancelled</h1>
					<p class="tw-text-muted mb-6 tw-text-lead">Your payment was cancelled and no charges were made to your account. You can try again anytime.</p>
					<div class="flex justify-center gap-4">
						<a href="/" class="tw-btn tw-btn-outline-dark tw-btn-lg px-6 font-bold">Back to Home</a>
						<a href="/price" class="tw-btn tw-btn-primary tw-btn-lg px-6 font-bold">View Plans</a>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
