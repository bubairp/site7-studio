{% macro stars(rating, size = '16px') %}
	{# Ensure rating is a number, handling Craft field objects if necessary #}
	{% set ratingValue = (rating.value is defined ? rating.value : rating)|default(0) %}
	{% set rating = ratingValue|number_format(0) %}
	{% set starFilled = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-star"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z" /></svg>' %}
	{% set starOutline = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-star"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" /></svg>' %}

	<div class="text-warning flex gap-1 items-center">
		{% for i in 1..5 %}
			<span style="width: {{ size }}; height: {{ size }}; display: inline-flex;">{{ (i <= rating ? starFilled : starOutline)|raw }}</span>
		{% endfor %}
	</div>
{% endmacro %}
