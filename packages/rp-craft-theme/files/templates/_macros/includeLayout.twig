{% macro includeLayout(folderName, layoutHandle, defaultLayout) %}
    {# Construct folder and file paths #}
    {% set folder = "_includes/" ~ folderName %}
    {% set filePath = folder ~ '/' ~ layoutHandle %}
    
    {# Get the absolute path to check existence #}
    {% set absolutePath = craft.app.path.siteTemplatesPath() %}
    {% set folderAbs = absolutePath ~ '/' ~ folder %}
    {% set filePathAbs = folderAbs ~ '/' ~ layoutHandle ~ '.twig' %}

    {# Check if file exists and include it #}
    {% if filePathAbs and craft.rplib.file_exists(filePathAbs) %}
       {#  {{ filePath }} #}
         {% set result = filePath %}
    {% else %}
{#         {% set defaultFilePath = folder ~ '/' ~ defaultLayout  %}
        {{ defaultFilePath }} #}
         {% set result = folder ~ '/' ~ defaultLayout %}
    {% endif %}
    {% include result %}
{% endmacro %}
