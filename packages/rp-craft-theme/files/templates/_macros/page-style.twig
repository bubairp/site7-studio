{#
    ================================================================
    pageStyleMacro.twig  –  Tailwind-first page style macros
    ================================================================
#}

{# ── 1. CLASS STRING ─────────────────────────────────────────────
   Outputs space-separated Tailwind classes resolved from pageStyle.
──────────────────────────────────────────────────────────────────── #}
{% macro psClasses(pageStyle) %}{% apply spaceless %}
{% if pageStyle is defined and pageStyle|length %}
{% set ps = pageStyle.one() ?? null %}
{% if ps %}

{# Background color #}
{% set bg = ps.getFieldValue('bgColor')|first %}
{% if bg and bg.colorcode %}bg-[var(--page-bg)] {% endif %}

{% endif %}
{% endif %}
{% endapply %}{% endmacro %}


{# ── 2. INLINE STYLE STRING ──────────────────────────────────────
   Outputs CSS custom properties for the style="" attribute.
──────────────────────────────────────────────────────────────────── #}
{% macro psStyle(pageStyle) %}{% apply spaceless %}
{% if pageStyle is defined and pageStyle|length %}
{% set ps = pageStyle.one() ?? null %}
{% if ps %}

	{% set bg = ps.getFieldValue('bgColor')|first %}
	{% if bg and bg.colorcode %}--page-bg:{{ bg.colorcode }};{% endif %}

	{% set title = ps.getFieldValue('titleColor')|first %}
	{% if title and title.colorcode %}--page-title-color:{{ title.colorcode }};{% endif %}

	{% set txt = ps.getFieldValue('textColor')|first %}
	{% if txt and txt.colorcode %}--page-text-color:{{ txt.colorcode }};{% endif %}

	{% set blk = ps.getFieldValue('blockBackgroundColor')|first %}
	{% if blk and blk.colorcode %}--page-block-bg-color:{{ blk.colorcode }};{% endif %}

{% endif %}
{% endif %}
{% endapply %}{% endmacro %}


{# ── 3. RESPONSIVE <style> TAG ───────────────────────────────────
   Outputs a <style> block for typography and block backgrounds.
──────────────────────────────────────────────────────────────────── #}
{% macro psResponsive(pageStyle, scopedSel) %}
{% if pageStyle is defined and pageStyle|length %}
{% set ps = pageStyle.one() ?? null %}
{% if ps %}

{% set _typCss = [] %}

{% set title = ps.getFieldValue('titleColor')|first %}
{% if title and title.colorcode %}
	{% set _typCss = _typCss|merge([
		scopedSel ~ ' .standard-txt .block-heading-title, ' ~
		scopedSel ~ ' .standard-txt h2, ' ~
		scopedSel ~ ' .standard-txt .h2, ' ~
		scopedSel ~ ' .standard-txt h1, ' ~
		scopedSel ~ ' .standard-txt .h3 { color: var(--page-title-color) !important; }'
	]) %}
{% endif %}

{% set txt = ps.getFieldValue('textColor')|first %}
{% if txt and txt.colorcode %}
	{% set _typCss = _typCss|merge([
		scopedSel ~ ' .standard-txt, ' ~
		scopedSel ~ ' .standard-txt p, ' ~
		scopedSel ~ ' .standard-txt h6, ' ~
		scopedSel ~ ' .standard-txt .tw-text-gray-900, ' ~
		scopedSel ~ ' .standard-txt .tw-text-xl, ' ~
		scopedSel ~ ' .standard-txt .tw-list-none li span, ' ~
		scopedSel ~ ' .standard-txt .tw-text-gray-800 { color: var(--page-text-color) !important; }'
	]) %}
{% endif %}

{% set blk = ps.getFieldValue('blockBackgroundColor')|first %}
{% if blk and blk.colorcode %}
	{% set _typCss = _typCss|merge([
		scopedSel ~ ' .block-bg-color { background: var(--page-block-bg-color) !important; }'
	]) %}
{% endif %}

{% if _typCss|length %}
{% css %}
{{ _typCss|join('\n')|raw }}
{% endcss %}
{% endif %}

{% endif %}
{% endif %}
{% endmacro %}
