{%- macro classes(blockStyle, contentData) -%}
	{%- set visibilityValues = [] -%}

	{#- Check Related Style Entry -#}
	{%- if blockStyle is defined and blockStyle and blockStyle.visibility is defined -%}
		{%- if blockStyle.visibility is iterable -%}
			{%- for opt in blockStyle.visibility -%}
				{%- set val = opt.value ?? opt -%}
				{%- set visibilityValues = visibilityValues|merge([val]) -%}
			{%- endfor -%}
		{%- endif -%}
	{%- endif -%}

	{#- Check Direct Field (Fallback) -#}
	{%- if visibilityValues is empty and contentData is defined and contentData.visibility is defined -%}
		{%- if contentData.visibility is iterable -%}
			{%- for opt in contentData.visibility -%}
				{%- set val = opt.value ?? opt -%}
				{%- set visibilityValues = visibilityValues|merge([val]) -%}
			{%- endfor -%}
		{%- endif -%}
	{%- endif -%}

	{%- if visibilityValues is empty -%}
		{%- set visibilityValues = ['mobile', 'tablet', 'desktop'] -%}
	{%- endif -%}

	{%- set showMobile = 'mobile' in visibilityValues -%}
	{%- set showTablet = 'tablet' in visibilityValues -%}
	{%- set showDesktop = 'desktop' in visibilityValues -%}

	{%- set visibilityClass = '' -%}

	{#- Base (Mobile) -#}
	{%- if showMobile -%}
		{%- set visibilityClass = visibilityClass ~ 'block' -%}
	{%- else -%}
		{%- set visibilityClass = visibilityClass ~ 'hidden' -%}
	{%- endif -%}

	{#- Tablet (MD) -#}
	{%- if showTablet != showMobile -%}
		{%- if showTablet -%}
			{%- set visibilityClass = visibilityClass ~ ' md:block' -%}
		{%- else -%}
			{%- set visibilityClass = visibilityClass ~ ' md:hidden' -%}
		{%- endif -%}
	{%- endif -%}

	{#- Desktop (LG) -#}
	{%- if showDesktop != showTablet -%}
		{%- if showDesktop -%}
			{%- set visibilityClass = visibilityClass ~ ' lg:block' -%}
		{%- else -%}
			{%- set visibilityClass = visibilityClass ~ ' lg:hidden' -%}
		{%- endif -%}
	{%- endif -%}

	{{- visibilityClass|trim -}}
{%- endmacro -%}
