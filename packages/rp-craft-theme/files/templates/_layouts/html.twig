{% apply spaceless %}
<!DOCTYPE html>
<html lang="{% block lang %}en-GB{% endblock %}">
	<head>
		{% block head %}
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="referrer" content="origin-when-cross-origin"/>

			{% block seo %}
				{% hook "seo" %}
			{% endblock %}

			{% block structured_data %}{% endblock %}

			{% block favicon %}
				{% if favicon is defined and favicon %}
					{% set url = favicon.getUrl('icon') %}
					<link rel="icon shortcut" href="{{ url }}">
					<link rel="icon" href="{{ url }}">
					<link rel="apple-touch-icon" href="{{ url }}">
				{% endif %}
			{% endblock %}

			{% block head_extra %}{% endblock %}

			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />

			{{ head() }}
			{% if craft.vite.devServerRunning() %}
				<!-- In Vite dev mode: load /styles.css dynamically to override Vite's runtime CSS injected styles -->
				<script>
					document.addEventListener('DOMContentLoaded', () => {
						const link = document.createElement('link');
						link.rel = 'stylesheet';
						link.href = '/styles.css?v={{ now | date("U") }}';
						document.head.appendChild(link);
					});
				</script>
			{% else %}
				<!-- In production mode: inline dynamic CSS -->
				<style>
					{% include "_dynamic-css" %}
				</style>
			{% endif %}
		{% endblock %}
	</head>
	{% block body %}{% endblock %}
</html>
{% endapply %}
