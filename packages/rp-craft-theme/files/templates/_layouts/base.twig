{% extends "_layouts/html" %}

{% block body %}
	<body {% if body_classes is defined %} class="{{ body_classes }}" {% endif %}>{{ beginBody() }}
		{% block after_body_tag %}{% endblock %}
		<header id="header" {% if header_classes is defined %} class="{{ header_classes }}" {% endif %}>
			{% block before_header %}{% endblock %}
			{% block header %}{% endblock %}
			{% block after_header %}{% endblock %}
		</header>
		<main id="content" {% if main_classes is defined %} class="{{ main_classes }}" {% endif %}>
			{% block before_content %}{% endblock %}
			{% block content %}{% endblock %}
			{% block after_content %}{% endblock %}
			<footer id="footer" {% if footer_classes is defined %} class="{{ footer_classes }}" {% endif %}>
				{% block before_footer %}{% endblock %}
				{% block footer %}{% endblock %}
				{% block after_footer %}{% endblock %}
			</footer>
		</main>
		{% block before_end_body_tag %}{% endblock %}
		{{ endBody() }}</body>
{% endblock %}
