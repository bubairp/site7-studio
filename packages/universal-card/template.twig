{% import "_macros/images" as images %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}
{% set headingAndContent = block.headingAndContent.one() %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}
{% set containerWidth = 'container' %}
{% set contentTypeField = block.contentType|default(null) %}
{% set contentType = (contentTypeField and contentTypeField is not iterable) ? (contentTypeField.value ?? contentTypeField) : '' %}

{% set entries = [] %}

{% if contentType == 'blogs' %}
	{% set relationQuery = block['selectBlogs'] ?? null %}
	{% set entries = relationQuery ? relationQuery.with(['image', 'tags']).all() : [] %}
	{% if not entries %}
		{% set entries = craft.entries.section('blogs').with(['image', 'tags']).all() %}
	{% endif %}
{% elseif contentType == 'caseStudies' %}
	{% set relationQuery = block['selectCaseStudies'] ?? null %}
	{% set entries = relationQuery ? relationQuery.with(['image', 'tags']).all() : [] %}
	{% if not entries %}
		{% set entries = craft.entries.section('casestudies').with(['image', 'tags']).all() %}
	{% endif %}
{% elseif contentType == 'portfolios' %}
	{% set relationQuery = block['selectPortfolios'] ?? null %}
	{% set entries = relationQuery ? relationQuery.with(['image', 'tags']).all() : [] %}
	{% if not entries %}
		{% set entries = craft.entries.section('portfolios').with(['image', 'tags']).all() %}
	{% endif %}
{% elseif contentType == 'services' %}
	{% set relationQuery = block['selectServices'] ?? null %}
	{% set entries = relationQuery ? relationQuery.with(['image']).all() : [] %}
	{% if not entries %}
		{% set entries = craft.entries.section('services').with(['image']).all() %}
	{% endif %}
{% endif %}

{% set customItems = block.customItems ?? [] %}

{% set blockCssClasses = '' %}
{% set themeSwitche = '' %}
{% set cardAlignClass = 'text-left' %}
{% set serviceBackgroundColorClass = '' %}
{% set cardLinkLabel = '' %}
{% set cardLinkColor = '' %}
{% set cardLinkColorEntry = null %}

{% if entries or customItems %}
	{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
	{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
	{% set themeSwitche = null %}

	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% if blockStyleData.background is defined %}
			{% set backgroundEntry = blockStyleData.background.one() %}
			{% set themeSwitche = backgroundEntry.themeDark ?? null %}
		{% endif %}
	{% endif %}

	{# Fetch Card Style Entry #}
	{% set styleField = block['cardStyle'] ?? block['serviceStyle'] ?? block['servicesStyle'] ?? null %}
	{% set cardStyleEntry = null %}
	{% if styleField is defined and styleField and styleField.one is defined %}
		{% set cardStyleEntry = styleField.one() %}
	{% endif %}

	{% set cardStyle = null %}
	{% if cardStyleEntry %}
		{% set cardStyle = cardStyleEntry.slug %}
	{% elseif styleField and styleField is string %}
		{% set cardStyle = styleField %}
	{% endif %}

	{# Dynamic CSS from Card Style #}
	{% set itemThemeSwitche = cardStyleEntry.themeDark ?? null %}

	{% set cardVariant = 'default' %}
	{% set cardLook = 'default' %}
	{% set cornerStyle = 'default' %}
	{% set aspectRatio = 'default' %}
	{% set cardPadding = 'default' %}
	{% set titleSize = 'default' %}
	{% set iconSize = 'default' %}

	{% if cardStyleEntry %}
		{% set vField = cardStyleEntry.cardVariant %}
		{% set cardVariant = (vField and vField is not iterable) ? (vField.value ?? vField|string) : (vField.one() ? vField.one().slug : 'default') %}

		{% set lField = cardStyleEntry.cardLook %}
		{% set cardLook = (lField and lField is not iterable) ? (lField.value ?? lField|string) : (lField.one() ? lField.one().slug : 'default') %}

		{% set cField = cardStyleEntry.cornerStyle %}
		{% set cornerStyle = (cField and cField is not iterable) ? (cField.value ?? cField|string) : (cField.one() ? cField.one().slug : 'default') %}

		{% set aField = cardStyleEntry.aspectRatio %}
		{% set aspectRatio = (aField and aField is not iterable) ? (aField.value ?? aField|string) : (aField.one() ? aField.one().slug : 'default') %}

		{# preferred fetching from related Style Entry #}
		{% set cardLinkLabel = cardStyleEntry.cardLinkLabel ?? cardLinkLabel %}

		{% set pField = cardStyleEntry.cardPadding ?? null %}
		{% set cardPadding = (pField and pField is not iterable) ? (pField.value ?? pField|string) : (pField.one() ? pField.one().slug : 'default') %}

		{% set tsField = cardStyleEntry.titleSize ?? null %}
		{% set titleSize = (tsField and tsField is not iterable) ? (tsField.value ?? tsField|string) : (tsField.one() ? tsField.one().slug : 'default') %}

		{% set isField = cardStyleEntry.iconSize ?? null %}
		{% set iconSize = (isField and isField is not iterable) ? (isField.value ?? isField|string) : (isField.one() ? isField.one().slug : 'default') %}

		{# Handle Color relationship or direct hex #}
		{% set lColorField = cardStyleEntry.cardLinkColor ?? null %}
		{% if lColorField %}
			{% if lColorField.one is defined %}
				{% set cardLinkColorEntry = lColorField.one() %}
				{% set cardLinkColor = cardLinkColorEntry.colorcode ?? cardLinkColor %}
			{% else %}
				{% set cardLinkColor = lColorField|string %}
			{% endif %}
		{% endif %}
	{% endif %}

	{# Fallback to Matrix Block fields if entry is empty or user put them on the block instead #}
	{% set cardLinkLabel = block.cardLinkLabel|default(cardLinkLabel) %}
	{% set titleSize = (block.titleSize.value ?? null)|default(titleSize) %}
	{% set iconSize = (block.iconSize.value ?? null)|default(iconSize) %}

	{% set bColorField = block.cardLinkColor ?? null %}
	{% if bColorField %}
		{% if bColorField.one is defined %}
			{% set bColorEntry = bColorField.one() %}
			{% set cardLinkColor = bColorEntry.colorcode ?? cardLinkColor %}
		{% else %}
			{% set cardLinkColor = bColorField|string %}
		{% endif %}
	{% endif %}

	{# Map dropdown handles to Bootstrap classes #}
	{% set paletteClassMap = {
		'primary': 'tw-btn-primary',
		'secondary': 'tw-btn-secondary',
		'light': 'tw-btn-light',
		'dark': 'tw-btn-dark'
	} %}
	{% set colorPalette = paletteClassMap[cardLinkColor] ?? 'tw-btn-outline-primary' %}

	{% set textPaletteMap = {
		'primary': 'text-primary',
		'secondary': 'text-secondary',
		'light': 'text-light',
		'dark': 'text-gray-900'
	} %}
	{% set textColorPalette = textPaletteMap[cardLinkColor] ?? 'text-primary' %}

	{# Display View and Grid Logic #}
	{% set dvField = block.displayView|default(null) %}
	{% set displayView = (dvField and dvField is not iterable) ? (dvField.value ?? dvField) : 'gridView' %}

	{% set rItemsField = block['itemsPerRow']|default(null) %}
	{% set rawItems = (rItemsField and rItemsField is not iterable) ? (rItemsField.value ?? rItemsField) : null %}
	{% set itemsPerRow = 3 %}
	{% if rawItems %}
		{% if rawItems == '1' %}
			{% set itemsPerRow = 1 %}
		{% elseif rawItems == '2' %}
			{% set itemsPerRow = 2 %}
		{% elseif rawItems == '4' %}
			{% set itemsPerRow = 4 %}
		{% endif %}
	{% endif %}
	{% set rowColsClass = 'grid-cols-1 md:grid-cols-' ~ itemsPerRow %}
	{% if itemsPerRow > 1 %}
		{% set rowColsClass = 'grid-cols-1 sm:grid-cols-2 md:grid-cols-' ~ itemsPerRow %}
	{% endif %}
	{% if displayView == 'listView' %}
		{% set rowColsClass = 'grid-cols-1' %}
	{% endif %}

	{% set bgEntry = cardStyleEntry ? cardStyleEntry.cardBackground.one() : null %}
	{% set serviceBackgroundColorClass = bgEntry ? (bgEntry.colorcode ?? '') : '' %}

	{% set tcEntry = cardStyleEntry ? cardStyleEntry.titleColor.one() : null %}
	{% set titleColorClass = tcEntry ? (tcEntry.colorcode ?? '') : '' %}

	{% set conEntry = cardStyleEntry ? cardStyleEntry.contentColor.one() : null %}
	{% set textColorClass = conEntry ? (conEntry.plainText ?? '') : '' %}

	{% set borEntry = cardStyleEntry ? cardStyleEntry.borderColor.one() : null %}
	{% set borderColorClass = borEntry ? (borEntry.colorcode ?? '') : '' %}

	{% if serviceBackgroundColorClass or titleColorClass or textColorClass or borderColorClass %}
		{% css %}
		{% if serviceBackgroundColorClass %}
			.{{ blockType }}{{ blockTypeUid }}-style .universal-card-premium {
																background:{{ serviceBackgroundColorClass|raw }}!important;
															}
		{% endif %}
		{% if titleColorClass %}
			.{{ blockType }}{{ blockTypeUid }}-style .universalCard-title {
																color:{{ titleColorClass|raw }}!important;
															}
		{% endif %}
		{% if textColorClass %}
			.{{ blockType }}{{ blockTypeUid }}-style .universalCard-content {
																color:{{ textColorClass|raw }}!important;
															}
		{% endif %}
		{% if borderColorClass %}
			.{{ blockType }}{{ blockTypeUid }}-style .universal-card-premium {
																border-color:{{ borderColorClass|raw }}!important;
															}
		{% endif %}
		{% endcss %}
	{% endif %}

	{% css %}
	.universal-card-premium {
																																	position: relative;
																																	z-index: 1;
																																}
																																.universal-card-premium.shadow-sm {
																																	/* Standard shadow */
																																}
																																.universal-card-premium .img-zoom-wrapper {
																																	position: relative;
																																	overflow: hidden;
																																	display: block;
																																}
																																.universal-card-premium .img-zoom-wrapper img {
																																	width: 100%;
																																	height: 100%;
																																	object-fit: cover;
																																}
																																.universal-card-premium .btn-premium-icon {
																																	transform: scale(0.9);
																																	opacity: 0.8;
																																}
																																.universal-card-premium .universalCard-title {
																																	/* Title styles */
																																}
																																.universalCard-premium-highlighted {
																																	box-shadow: 0 0 0 2px var(--bs-primary);
																																}
																																@media (max-width: 767.98px) {
																																	.ratio-16x9-mobile {
																																		--aspect-ratio: 56.25%;
																																	}
																																}
	{% endcss %}

	{# Set alignment class #}
	{% set alignClassMap = {
		'start': 'text-left',
		'center': 'text-center',
		'end': 'text-right'
	} %}
	{% set textAlignVal = (cardStyleEntry and cardStyleEntry.textAlign is defined and cardStyleEntry.textAlign) ? (cardStyleEntry.textAlign.value ?? cardStyleEntry.textAlign) : 'start' %}
	{% set cardAlignClass = alignClassMap[textAlignVal] ?? 'text-left' %}

	{{ bsResponsive(blockStyle, scopedSel) }}
	<div class="py-10 md:py-12 lg:py-16 {{ blockType }}{{blockTypeUid}}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}">
		<div class="{{ containerWidth }}">
			{% if headingAndContent %}
				{% if headingAndContent.heading|length or headingAndContent.Description|length %}
					{% include "_components/header-content-block" %}
				{% endif %}
			{% endif %}

			{% if displayView == 'sliderView' %}
				<div class="swiper" data-swiper-options='
																																																																																																																																																																																																																																																																																																																																																																																																														      				              {
																																																																																																																																																																																																																																																																																																																																																																																																																      		              "spaceBetween": 24,
																																																																																																																																																																																																																																																																																																																																																																																																												      						              "pagination": {
																																																																																																																																																																																																																																																																																																																																																																																																								      										                  "el": ".swiper-pagination",
																																																																																																																																																																																																																																																																																																																																																																																																												      						                  "clickable": true
																																																																																																																																																																																																																																																																																																																																																																																																																      		              },
																																																																																																																																																																																																																																																																																																																																																																																																																		                    "breakpoints": {
																																																																																																																																																																																																																																																																																																																																																																																																						      												                  "576": { "slidesPerView": 2 },
																																																																																																																																																																																																																																																																																																																																																																																																										      								                  "992": { "slidesPerView": {{ itemsPerRow }} }
																																																																																																																																																																																																																																																																																																																																																																																																												      						              }
																																																																																																																																																																																																																																																																																																																																																																																																																      		              }
																																																																																																																																																																																																																																																																																																																																																																																																																		                '>
					<div class="swiper-wrapper" data-theme="{{ (itemThemeSwitche ?? themeSwitche) ? 'dark' : 'light' }}">
						{% for item in entries %}
							<div class="swiper-slide h-auto">
								{% include "_components/_universal-card/cardItem" with { isCustom: false, item: item, type: contentType, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
							</div>
						{% endfor %}
						{% for index, item in customItems %}
							<div class="swiper-slide h-auto">
								{% include "_components/_universal-card/cardItem" with { isCustom: true, index: index, item: item, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
							</div>
						{% endfor %}
					</div>
					<div class="swiper-pagination relative bottom-0 mt-2 pt-4"></div>
				</div>
			{% elseif displayView == 'masonryView' %}
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-{{ itemsPerRow }} gap-6 masonry-grid" data-theme="{{ (itemThemeSwitche ?? themeSwitche) ? 'dark' : 'light' }}">
					{% for item in entries %}
						<div class="masonry-grid-item">
							{% include "_components/_universal-card/cardItem" with { isCustom: false, item: item, type: contentType, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
						</div>
					{% endfor %}
					{% for index, item in customItems %}
						<div class="masonry-grid-item">
							{% include "_components/_universal-card/cardItem" with { isCustom: true, index: index, item: item, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
						</div>
					{% endfor %}
				</div>
			{% elseif displayView == 'listView' %}
				{# Forces single column layout #}
				<div class="grid grid-cols-1 gap-y-6" data-theme="{{ (itemThemeSwitche ?? themeSwitche) ? 'dark' : 'light' }}">
					{% for item in entries %}
						<div>
							{% include "_components/_universal-card/cardItem" with { isCustom: false, item: item, type: contentType, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
						</div>
					{% endfor %}
					{% for index, item in customItems %}
						<div>
							{% include "_components/_universal-card/cardItem" with { isCustom: true, index: index, item: item, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
						</div>
					{% endfor %}
				</div>

			{% else %}
				<div class="grid {{ rowColsClass }} gap-6" data-theme="{{ (itemThemeSwitche ?? themeSwitche) ? 'dark' : 'light' }}">
					{% for item in entries %}
						<div>
							{% include "_components/_universal-card/cardItem" with { isCustom: false, item: item, type: contentType, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
						</div>
					{% endfor %}
					{% for index, item in customItems %}
						<div>
							{% include "_components/_universal-card/cardItem" with { isCustom: true, index: index, item: item, cardStyle: cardStyle, cardVariant: cardVariant, cardLook: cardLook, cornerStyle: cornerStyle, aspectRatio: aspectRatio, cardAlignClass: cardAlignClass, cardLinkLabel: cardLinkLabel|default(''), colorPalette: colorPalette, textColorPalette: textColorPalette, cardPadding: cardPadding|default('default'), titleSize: titleSize|default('default'), iconSize: iconSize|default('default') } %}
						</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</div>
{% endif %}
