{% import "_macros/images" as images %}
{% import "_components/ctaButton" as ctaButtons %}
{% from '_macros/block-style' import bsClasses, bsStyle, bsResponsive, bsContainer %}

{% set headingAndContent = block.headingAndContent.one() %}
{% set ourProcessItems = block.processItems.all() ?? [] %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? 'ourProcess' %}
{% set blockTypeUid = block.uid  ?? '' %}

{# Get Process Specific Style & Layout #}
{% set processStyleBlock = block.processStyle.one() ?? null %}
{% set layout = 'timeline' %}
{% set stepBg = null %}
{% set stepTitleColor = null %}
{% set stepContentColor = null %}
{% set stepAlign = null %}

{% if processStyleBlock and processStyleBlock.type.handle == 'processStyle' %}
	{% set layout = processStyleBlock.processLayout.value ?? 'timeline' %}
	{% set itemsField = processStyleBlock['itemsPerRow'] ?? null %}
	{% set rawItems = itemsField ? (itemsField.value ?? (itemsField ~ '')) : null %}
	{% set itemsPerRow = 4 %}
	{% if rawItems %}
		{% if rawItems == '2' %}
			{% set itemsPerRow = 2 %}
		{% endif %}
		{% if rawItems == '3' %}
			{% set itemsPerRow = 3 %}
		{% endif %}
		{% if rawItems == '4' %}
			{% set itemsPerRow = 4 %}
		{% endif %}
		{% if rawItems == '6' %}
			{% set itemsPerRow = 6 %}
		{% endif %}
	{% endif %}
	{% set stepBg = processStyleBlock.stepBackground.one() ?? null %}
	{% set cardBg = processStyleBlock.cardBackground.one() ?? null %}
	{% set lineColor = processStyleBlock.timelineBorderColor.one() ?? null %}
	{% set stepTitleColor = processStyleBlock.titleColor.one() ?? null %}
	{% set stepContentColor = processStyleBlock.contentColor.one() ?? null %}
	{% set stepColor = processStyleBlock.stepColor.one() ?? null %}
	{% set stepAlign = processStyleBlock.textAlign.value ?? 'center' %}
{% endif %}

{# Styles moved to _ourProcess.scss #}

{% set scopedSel = '.' ~ blockType ~ blockTypeUid ~ '-style' %}
{% set themeSwitche = null %}

{% if ourProcessItems %}
	{% set containerWidth = bsContainer(blockStyle, 'container mx-auto px-4') %}
	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% if blockStyleData.background is defined %}
			{% set backgroundEntry = blockStyleData.background.one() %}
			{% set themeSwitche = backgroundEntry.themeDark ?? null %}
		{% endif %}
	{% endif %}

	{% set processStyleVars = '' %}
	{# Always provide primary and line color variables, using theme defaults if CMS is empty #}
	{% set processStyleVars = processStyleVars ~ '--step-bg: ' ~ (stepBg ? stepBg.colorcode.getHex() : 'var(--primary)') ~ ';' %}
	{% set processStyleVars = processStyleVars ~ '--line-color: ' ~ (lineColor ? lineColor.colorcode.getHex() : 'var(--primary)') ~ ';' %}
	{% set processStyleVars = processStyleVars ~ '--step-indicator-color: ' ~ (stepColor ? stepColor.colorcode.getHex() : 'var(--white)') ~ ';' %}

	{% if stepTitleColor %}
		{% set processStyleVars = processStyleVars ~ '--step-title-color: ' ~ (stepTitleColor.colorcode.getHex() ?? 'var(--bs-body-color)') ~ ';' %}
	{% endif %}
	{% if stepContentColor %}
		{% set processStyleVars = processStyleVars ~ '--step-desc-color: ' ~ (stepContentColor.colorcode.getHex() ?? 'var(--bs-secondary-color)') ~ ';' %}
	{% endif %}
	{% if cardBg %}
		{% set processStyleVars = processStyleVars ~ '--card-bg: ' ~ (cardBg.colorcode.getHex() ?? 'var(--bs-body-bg)') ~ ';' %}
	{% endif %}
	{% if stepAlign %}
		{% set processStyleVars = processStyleVars ~ '--step-align: ' ~ stepAlign ~ ';' %}
	{% endif %}

	{{ bsResponsive(blockStyle, scopedSel) }}
	<section class="py-10 md:py-12 lg:py-16 {{ blockType }}{{ block.uid }}-style {{ bsClasses(blockStyle) }}" data-theme="{{ themeSwitche ? 'dark' : 'light' }}" style="{{ bsStyle(blockStyle) }}{{ processStyleVars }}" data-debug-itemsperrow="{{ itemsPerRow }}">
		<div class="{{ containerWidth }}">
			{% if headingAndContent %}
				{% if headingAndContent.heading|length or headingAndContent.Description|length %}
					{% include "_components/header-content-block" %}
				{% endif %}
			{% endif %}

			{# Set layout specific container classes #}
			{% set containerClasses = 'relative w-full' %}
			{% if layout in ['verticalSteps', 'zigzagLayout'] %}
				{% set containerClasses = containerClasses ~ ' text-left before:absolute before:top-0 before:bottom-0 before:w-[3px] before:bg-[var(--line-color)] before:opacity-40 before:z-0' %}
				{% if layout == 'verticalSteps' %}
					{% set containerClasses = containerClasses ~ ' before:left-[2.25rem] max-lg:before:left-[2.25rem]' %}
				{% else %}
					{% set containerClasses = containerClasses ~ ' before:left-[2.25rem] lg:before:left-1/2 lg:before:-ml-[1.5px] max-lg:before:left-[2.25rem]' %}
				{% endif %}
			{% endif %}
			<div class="{{ containerClasses }}">
				{% if layout == 'timeline' %}
					<div class="swiper" data-swiper-options='{"spaceBetween": 0,"watchOverflow": true,"pagination": {"el": ".swiper-pagination","clickable": true},"breakpoints": {"0": { "slidesPerView": 1 },"576": { "slidesPerView": 2 },"992": { "slidesPerView": {{ itemsPerRow > 3 ? 3 : itemsPerRow }} },"1200": { "slidesPerView": {{ itemsPerRow }} }}}'>
						<div class="swiper-wrapper">
							{% for item in ourProcessItems %}
								{% set isLinkEnabled = item.switchOff ?? false %}
								{% set itemUrl = item.linkUrl ?? '#' %}
								<div class="swiper-slide h-auto px-2 text-center overflow-visible relative before:absolute before:top-[50px] before:left-0 before:right-0 before:h-[3px] before:bg-[var(--line-color,theme(colors.primary.DEFAULT))] before:opacity-30 before:z-0 first:before:left-1/2 last:before:right-1/2">
									{% if isLinkEnabled %}
										<a href="{{ itemUrl }}" class="no-underline text-gray-800">
										{% endif %}
										<div class="w-20 h-20 flex items-center justify-center rounded-xl shadow-md relative mx-auto mt-2 mb-6 z-10 border-4 border-white transition-all duration-300 ease-in-out hover:shadow-xl bg-primary" {% if stepBg %} style="background: {{ stepBg.colorcode.getHex() }} !important;" {% endif %}>
											{% if item.image|length %}
												<div class="absolute top-0 right-0 translate-x-[35%] -translate-y-[35%] w-[30px] h-[30px] bg-white border-2 rounded-full flex items-center justify-center font-bold text-[0.8rem] shadow-sm" style="color: var(--step-indicator-color, var(--primary)); border-color: var(--step-indicator-color, var(--primary));">{{ loop.index }}</div>
											{% endif %}
											{% if item.image|length %}
												<div class="w-12 h-12 flex items-center justify-center">{{ images.singleImg(item.image.0, 80, {'ratio': 1}, 'w-full h-full object-contain') }}</div>
											{% else %}
												<div class="w-12 h-12 flex items-center justify-center">
													<span class="text-2xl font-bold text-white" style="color: var(--step-indicator-color, #fff) !important;">{{ loop.index }}</span>
												</div>
											{% endif %}
										</div>

										<h4 class="step-title text-lg mb-2 font-bold text-gray-900" {% if stepTitleColor %} style="color: var(--step-title-color) !important;" {% endif %}>{{ item.plainText }}</h4>

										{% if item.Description|length %}
											<div class="step-description text-sm mb-3 text-gray-800" {% if stepContentColor %} style="color: var(--step-desc-color) !important;" {% endif %}>{{ item.Description|raw }}</div>
										{% endif %}

										{% if item.duration|length %}
											<div class="mt-auto text-xs font-semibold rounded-full px-[1.2rem] py-[0.4rem] inline-block bg-gray-100 border border-gray-200" style="color: var(--step-indicator-color, var(--primary));">{{ item.duration }}</div>
										{% endif %}
										{% if isLinkEnabled %}
										</a>
									{% endif %}
								</div>
							{% endfor %}
						</div>
						<!-- Pagination (bullets) -->
						<div class="swiper-pagination relative bottom-0 mt-2 pt-4"></div>
					</div>
				{% else %}
					<div class="process-container-inner {{ layout == 'horizontalCards' ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-' ~ itemsPerRow ~ ' gap-6' : '' }}">
						{% for item in ourProcessItems %}
							{% set isLinkEnabled = item.switchOff ?? false %}
							{% set itemUrl = item.linkUrl ?? '#' %}

							{% if layout == 'horizontalCards' %}
								<div class="text-center">
									<div class="flex flex-col h-full border border-gray-200 rounded-2xl p-6 text-center bg-white shadow-sm transition-all duration-300 ease-in-out hover:shadow-xl" {% if cardBg %} style="background-color: {{ cardBg.colorcode.getHex() }} !important;" {% endif %}>
										{% if isLinkEnabled %}
											<a href="{{ itemUrl }}" class="no-underline text-gray-800">
											{% endif %}
											<div class="w-20 h-20 flex items-center justify-center rounded-xl shadow-md relative mx-auto mb-6 z-10 border-4 border-white transition-all duration-300 ease-in-out hover:shadow-xl bg-primary mt-0" {% if stepBg %} style="background: {{ stepBg.colorcode.getHex() }} !important;" {% endif %}>
												{% if item.image|length %}
													<div class="absolute top-0 right-0 translate-x-[35%] -translate-y-[35%] w-[30px] h-[30px] bg-white border-2 rounded-full flex items-center justify-center font-bold text-[0.8rem] shadow-sm" style="color: var(--step-indicator-color, var(--primary)); border-color: var(--step-indicator-color, var(--primary));">{{ loop.index }}</div>
												{% endif %}
												{% if item.image|length %}
													<div class="w-12 h-12 flex items-center justify-center">{{ images.singleImg(item.image.0, 80, {'ratio': 1}, 'w-full h-full object-contain') }}</div>
												{% else %}
													<div class="w-12 h-12 flex items-center justify-center">
														<span class="text-2xl font-bold text-white" style="color: var(--step-indicator-color, #fff) !important;">{{ loop.index }}</span>
													</div>
												{% endif %}
											</div>
											<div class="process-content">
												<h4 class="step-title text-lg mb-2 font-bold text-gray-900" {% if stepTitleColor %} style="color: var(--step-title-color) !important;" {% endif %}>{{ item.plainText }}</h4>
												{% if item.Description|length %}
													<div class="step-description text-sm mb-3 text-gray-800" {% if stepContentColor %} style="color: var(--step-desc-color) !important;" {% endif %}>{{ item.Description|raw }}</div>
												{% endif %}

												{% if item.duration|length %}
													<div class="text-xs font-semibold rounded-full px-[1.2rem] py-[0.4rem] inline-block bg-gray-100 border border-gray-200" style="color: var(--step-indicator-color, var(--primary));">{{ item.duration }}</div>
												{% endif %}
											</div>
											{% if isLinkEnabled %}
											</a>
										{% endif %}
									</div>
								</div>

							{% else %}
								{# Vertical or Zigzag Layout #}
								{% set verticalItemClasses = 'relative flex flex-row items-start justify-start mb-14 z-10 pl-[5.5rem] lg:pl-0 w-full last:mb-0 max-lg:pl-[5.5rem]' %}
								{% set indicatorClasses = 'w-[4.5rem] h-[4.5rem] shrink-0 bg-white border-[3px] rounded-xl flex items-center justify-center shadow-md z-20 absolute left-0 top-0 max-lg:left-0 max-lg:translate-x-0' %}
								{% set cardClasses = 'w-full border border-gray-200 rounded-xl p-7 shadow-sm relative text-left transition-all duration-300 hover:shadow-lg bg-white' %}

								{% if layout == 'zigzagLayout' %}
									{% set verticalItemClasses = verticalItemClasses ~ ' lg:justify-center' %}
									{% set indicatorClasses = indicatorClasses ~ ' lg:left-1/2 lg:-translate-x-1/2' %}
									{% set cardClasses = cardClasses ~ ' lg:w-[calc(50%-5rem)]' %}
									{% if loop.index is even %}
										{% set verticalItemClasses = verticalItemClasses ~ ' lg:flex-row-reverse' %}
										{% set cardClasses = cardClasses ~ ' lg:ml-0 lg:mr-auto' %}
									{% else %}
										{% set cardClasses = cardClasses ~ ' lg:ml-auto lg:mr-0' %}
									{% endif %}
								{% else %}
									{% set cardClasses = cardClasses ~ ' lg:w-[calc(100%-7rem)] lg:ml-[7rem]' %}
								{% endif %}

								{% if loop.last %}
									{% set cardClasses = cardClasses ~ ' border-dashed border-2' %}
								{% endif %}

								<div
									class="{{ verticalItemClasses }}">
									{# Icon Indicator #}
									<div class="{{ indicatorClasses }}" style="border-color: var(--step-indicator-color, var(--line-color, var(--primary))) !important;">
										{% if item.image|length %}
											{{ images.singleImg(item.image.0, 80, {'ratio': 1}, 'w-10 h-10 object-contain') }}
										{% else %}
											<span class="text-xl font-bold" style="color: var(--step-indicator-color, var(--primary)) !important;">{{ loop.index }}</span>
										{% endif %}
									</div>

									{# Content Card #}
									<div class="{{ cardClasses }}" {% if cardBg %} style="background-color: {{ cardBg.colorcode.getHex() }} !important;" {% endif %}>
										{% if item.duration|length %}
											<span class="absolute top-5 right-5 text-[0.7rem] font-bold uppercase tracking-wide px-4 py-1.5 rounded-lg bg-gray-100 border border-gray-200" style="color: var(--step-indicator-color, var(--primary));">{{ item.duration }}</span>
										{% endif %}


										<h4 class="text-[1.35rem] font-bold mb-3 flex items-center text-gray-900" {% if stepTitleColor %} style="color: {{ stepTitleColor.colorcode.getHex() }} !important;" {% endif %}>
											<span class="font-extrabold mr-2" style="color: var(--step-indicator-color, var(--primary)) !important;">{{ loop.index|format('%02d') }}.</span>
											{{ item.plainText }}</h4>

										{% if item.Description|length %}
											<div class="text-base leading-relaxed mb-6 opacity-85 text-gray-800" {% if stepContentColor %} style="color: {{ stepContentColor.colorcode.getHex() }} !important;" {% endif %}>{{ item.Description|raw }}</div>
										{% endif %}

										{# Optional Card Content (Placeholder for images/progress from mockup) #}
										{% if item.image|length >1 %}
											<div class="card-footer-content mt-3">
												{% for img in item.image.all()|slice(1, 3) %}
													{{ images.singleImg(img, 120, {'ratio': 1.5}, 'rounded-lg shadow-sm') }}
												{% endfor %}
											</div>
										{% endif %}

										{% if isLinkEnabled %}
											{% set mockBtn = {
												'linkUrl': item.linkUrl ?? null,
												'colorPalette': 'primary',
												'displayIcon': true,
												'textAlign': 'end',
												'buttonIconClasses': 'bi bi-stars'
											} %}
											<div class="mt-4 pt-4 pb-2">{{ ctaButtons.renderButton([mockBtn], {}, 'w-full') }}</div>
										{% endif %}
									</div>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>
	</section>
{% endif %}
