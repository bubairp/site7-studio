# Always LF in the working tree, on every OS: the plugin runs on Linux
# servers, and Windows git would otherwise convert every file to CRLF.
* text=auto eol=lf

# Library packages are kept byte for byte: updates compare a package's
# files with the copies installed on each site, so git must never convert them.
packages/** -text

# Binary files: never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.s7pkg binary

# Left out of downloaded archives (Composer dist, GitHub zip): what a
# customer site doesn't need. The Library comes from Commerce24.
/packages export-ignore
/tests export-ignore
/docs export-ignore
/.claude export-ignore
/CLAUDE.md export-ignore
/codeception.yml export-ignore
/phpunit.xml.dist export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
