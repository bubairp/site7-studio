{#
 # Marketplace - Repository tab.
 # Params: repositories (MarketplaceRepositoryInterface[] keyed by handle),
 #         listingsByRepository (array<string, MarketplaceListing[]> keyed by repository handle -
 #         fetched once in the controller, not here, since listAvailablePackages() can mean
 #         real I/O per repository), commerceOwnership (array<string, {label, color, plans}> keyed
 #         by handle - Commerce24 listings only, see MarketplaceController::buildCommerceOwnership()),
 #         onSite (array<string, {version, status, newerIn?: array<repositoryHandle, true>}> keyed by
 #         handle - this site's package records, and which repositories list a newer version)
 #}
<p class="light">
    {{ "Every repository registered through MarketplaceRepositoryInterface is listed below with the packages it currently has available to pull. The Local Repository reads .s7pkg files from a folder on this server; Commerce24 reads its catalog live over the network once configured on the Commerce settings tab."|t('site7-studio') }}
</p>

{% set anyListings = listingsByRepository|filter(l => l|length)|length %}
{% if anyListings %}
    <div class="search-container texticon" style="max-width: 320px; margin-bottom: 16px;">
        <span class="texticon-icon search icon" aria-hidden="true"></span>
        <input type="text" class="clearable text fullwidth" id="site7-repo-search" placeholder="{{ 'Search packages...'|t('site7-studio') }}" aria-label="{{ 'Search'|t('site7-studio') }}">
    </div>
{% endif %}

{% for repositoryHandle, repository in repositories %}
    {% set listings = listingsByRepository[repositoryHandle] ?? [] %}
    <section class="site7-detail-section site7-repo-section" style="margin-bottom: 24px;">
        <h2>{{ repository.getName() }}</h2>
        {% if listings|length %}
            {# Fixed column widths, identical across every repository's table
             # (not just within one), so Package/Type/.../Action line up from
             # section to section instead of each table auto-sizing off its
             # own content - Local's long timestamped filenames vs.
             # Commerce24's short ones otherwise push the columns apart. #}
            <table class="data fullwidth" style="table-layout: fixed;">
                <colgroup>
                    <col style="width: 16%;">
                    <col style="width: 9%;">
                    <col style="width: 8%;">
                    <col style="width: 19%;">
                    <col style="width: 15%;">
                    <col style="width: 16%;">
                    <col style="width: 17%;">
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">{{ "Package"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Type"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Version"|t('site7-studio') }}</th>
                        <th scope="col">{{ "File"|t('site7-studio') }}</th>
                        <th scope="col">{{ "On this site"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Ownership"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Action"|t('site7-studio') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for listing in listings %}
                        {% set ownership = repositoryHandle == 'commerce24' ? ((commerceOwnership|default({}))[listing.handle] ?? null) : null %}
                        <tr>
                            <th scope="row" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{ listing.handle }}">{{ listing.handle }}</th>
                            <td>{{ listing.type|title }}</td>
                            <td>v{{ listing.version }}</td>
                            <td class="light" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{ listing.fileName }}">{{ listing.fileName }}</td>
                            {% set local = onSite[listing.handle] ?? null %}
                            {# "available" = in this site's Library, not installed (docs/51). #}
                            {% set installed = local and local.status != 'available' %}
                            {% set newer = local and (local.newerIn[repositoryHandle] ?? false) %}
                            <td>
                                {% if not local %}
                                    <span class="light">{{ "Not installed"|t('site7-studio') }}</span>
                                {% elseif installed %}
                                    <span class="status-label teal"><span class="status teal"></span><span class="status-label-text">{{ "Installed"|t('site7-studio') }} v{{ local.version }}</span></span>
                                {% else %}
                                    <span class="light">{{ "In Library"|t('site7-studio') }} v{{ local.version }}</span>
                                {% endif %}
                                {% if newer %}
                                    <div class="smalltext" style="color: var(--blue-600, #2563eb);">{{ "Newer here"|t('site7-studio') }}: v{{ listing.version }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if ownership %}
                                    <span class="status-label {{ ownership.color }}"><span class="status {{ ownership.color }}"></span><span class="status-label-text">{{ ownership.label|t('site7-studio') }}</span></span>
                                    {% if ownership.label == 'Locked' and ownership.plans|length %}
                                        <div class="light">{{ ownership.plans|join(', ') }}</div>
                                    {% endif %}
                                {% else %}
                                    <span class="light">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if ownership and ownership.label == 'Locked' %}
                                    <a href="{{ url('site7-studio/commerce', {tab: 'subscription'}) }}" class="btn small">{{ "View Plans"|t('site7-studio') }}</a>
                                {% elseif installed and newer %}
                                    {# Updates keep local edits (docs/53): send them to the screen that does that. #}
                                    <a href="{{ repositoryHandle == 'commerce24' ? url('site7-studio/update') : url('site7-studio/marketplace', {tab: 'updates'}) }}" class="btn small submit">{{ "Update"|t('site7-studio') }}</a>
                                {% else %}
                                    {# Reinstall stays available: it's how a backup in the Local Repository is restored. #}
                                    <form method="post" accept-charset="UTF-8">
                                        {{ csrfInput() }}
                                        <input type="hidden" name="action" value="site7-studio/marketplace/install-from-repository">
                                        <input type="hidden" name="repositoryHandle" value="{{ repository.getHandle() }}">
                                        <input type="hidden" name="handle" value="{{ listing.handle }}">
                                        <button type="submit" class="btn small"
                                            onclick="return confirm('{{ installed ? 'Reinstall' : 'Install' }} {{ listing.handle|e('js') }} v{{ listing.version|e('js') }} from {{ repository.getName()|e('js') }}? If it already exists locally with different content, this will overwrite it.');">
                                            {{ (installed ? 'Reinstall' : 'Install')|t('site7-studio') }}
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% elseif repository.unavailableReason ?? null %}
            <p class="warning">{{ repository.unavailableReason }}</p>
        {% else %}
            {% include "site7-studio/_components/empty-state" with {
                message: 'No packages available from ' ~ repository.getName() ~ ' yet.',
                subtext: 'Export a package from the Export tab and copy it into storage/site7-studio/marketplace-repo/ (Local), or publish it to Commerce24 from the Publishing wizard, to make it pullable from here.',
                icon: '🗄️'
            } only %}
        {% endif %}
    </section>
{% endfor %}

<script>
(function() {
    var input = document.getElementById('site7-repo-search');
    if (!input) return;
    var sections = document.querySelectorAll('.site7-repo-section');
    input.addEventListener('input', function() {
        var q = input.value.trim().toLowerCase();
        sections.forEach(function(section) {
            var table = section.querySelector('table');
            if (!table) return;
            var anyVisible = false;
            table.querySelectorAll('tbody tr').forEach(function(row) {
                var match = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
                row.style.display = match ? '' : 'none';
                if (match) anyVisible = true;
            });
            section.style.display = anyVisible ? '' : 'none';
        });
    });
})();
</script>
