{% extends "_layouts/cp" %}
{% set title = "Install a Starter Kit"|t('site7-studio') %}
{% set selectedSubnavItem = "install" %}

{% do view.registerAssetBundle("site7\\studio\\assetbundles\\InstallWizardBundle") %}

{% macro fit(kitTheme, installedTheme, siteHasStructure) %}
    {%- if installedTheme -%}
        {%- if kitTheme == installedTheme -%}
            <br><span class="light">{{ "Adds its pages to this site (same Theme). Pages already here are kept."|t('site7-studio') }}</span>
        {%- else -%}
            <br><span class="warning">{{ "Needs a fresh site: it uses the Theme {kitTheme}, this site has {installedTheme}."|t('site7-studio', {kitTheme: kitTheme, installedTheme: installedTheme}) }}</span>
        {%- endif -%}
    {%- elseif siteHasStructure -%}
        <br><span class="warning">{{ "Needs a fresh site: this site already has its own content structure."|t('site7-studio') }}</span>
    {%- endif -%}
{% endmacro %}
{% from _self import fit %}

{% set content %}
{# ---------------------------------------------------- Library Starter Kits (docs/51) #}
<div class="pane">
    <h2>{{ "Library Starter Kits"|t('site7-studio') }}</h2>
    <p class="light">{{ "A Library Starter Kit sets up the whole site on a fresh Craft install: its Theme (structure, templates, frontend, plugins, settings), every page with its blocks, menus and demo content."|t('site7-studio') }}</p>
    {% if libraryKits is empty and remoteKits is empty %}
        <p>{{ craft.app.plugins.getPlugin('site7-studio').commerceClient.isConfigured() ? "No Library Starter Kit in this site's Library or from Commerce24."|t('site7-studio') : "No Library Starter Kit in this site's Library. Connect Commerce24 (Settings → Commerce) to install one from the Site7 Library."|t('site7-studio') }}</p>
    {% else %}
        <table class="data fullwidth">
            <thead><tr><th>{{ "Starter Kit"|t('site7-studio') }}</th><th>{{ "Includes"|t('site7-studio') }}</th><th>{{ "Status"|t('site7-studio') }}</th><th></th></tr></thead>
            <tbody>
            {% for kit in remoteKits %}
                {% set m = kit.metadata.library ?? {} %}
                <tr>
                    <td><strong>{{ kit.name }}</strong> <span class="light">v{{ kit.version }}</span><br><span class="light">{{ kit.description }}</span></td>
                    <td>
                        {{ "Theme"|t('site7-studio') }} <code>{{ m.theme ?? '?' }}</code><br>
                        {{ "{pages} pages, {menuItems} menu items, {entries} demo entries"|t('site7-studio', {pages: m.templates ?? '?', menuItems: m.content.counts.simplerpmenu_items ?? 0, entries: m.content.counts.entries ?? 0}) }}
                    </td>
                    <td>
                        <span class="status blue"></span>Commerce24{% if kit.pricingType != 'free' %} · {{ kit.pricingType|title }}{% endif %}
                        {% if kit.entitled is defined and not kit.entitled %}<br><span class="error">{{ "Not in your plan"|t('site7-studio') }}</span>{% endif %}
                        {{ fit(m.theme ?? null, installedTheme, siteHasStructure) }}
                    </td>
                    <td class="thin nowrap">
                        {% set fits = installedTheme ? (m.theme ?? null) == installedTheme : not siteHasStructure %}
                        {% if fits %}
                        <form method="post" class="inline">
                            {{ csrfInput() }}
                            {{ actionInput('site7-studio/install-wizard/check-library-kit') }}
                            {{ hiddenInput('handle', kit.handle) }}
                            <button type="submit" class="btn">{{ "Check"|t('site7-studio') }}</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            {% for kit in libraryKits %}
                <tr>
                    <td><strong>{{ kit.name }}</strong> <span class="light">v{{ kit.version }}</span><br><span class="light">{{ kit.description }}</span></td>
                    <td>
                        {{ "Theme"|t('site7-studio') }} <code>{{ kit.meta.theme }}</code><br>
                        {{ "{pages} pages, {menuItems} menu items, {entries} demo entries"|t('site7-studio', {pages: kit.meta.templates, menuItems: kit.meta.content.counts.simplerpmenu_items ?? 0, entries: kit.meta.content.counts.entries ?? 0}) }}
                    </td>
                    {# Installed once it set up the site, even if it was disabled before Disable was taken away. #}
                    {% set installed = kit.status in ['enabled', 'disabled'] %}
                    {% set fits = installedTheme ? kit.meta.theme == installedTheme : not siteHasStructure %}
                    <td>{% if installed %}<span class="status green"></span>{{ "Installed"|t('site7-studio') }}{% else %}<span class="status"></span>{{ "Not installed"|t('site7-studio') }}{{ fit(kit.meta.theme, installedTheme, siteHasStructure) }}{% endif %}</td>
                    <td class="thin nowrap">
                        {% if not installed and fits %}
                            <form method="post" class="inline">
                                {{ csrfInput() }}
                                {{ actionInput('site7-studio/install-wizard/check-library-kit') }}
                                {{ hiddenInput('handle', kit.handle) }}
                                <button type="submit" class="btn">{{ "Check"|t('site7-studio') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if kitCheck %}
        <hr>
        <h3>{{ "Check: {handle}"|t('site7-studio', {handle: kitCheck.handle}) }}</h3>
        {% if kitCheck.errors %}
            <ul class="errors">{% for e in kitCheck.errors %}<li>{{ e }}</li>{% endfor %}</ul>
        {% else %}
            <p class="success">✓ {{ "Ready to install."|t('site7-studio') }}
                {% if kitCheck.remote ?? false %}{{ "Downloads {count} packages ({size}) from Commerce24, each checked against its signature."|t('site7-studio', {count: kitCheck.download|length, size: kitCheck.downloadSize|filesize}) }}{% endif %}
                {{ kitCheck.themeInstalled
                    ? "The Theme {theme} is already installed."|t('site7-studio', {theme: kitCheck.theme})
                    : "Installs the Theme {theme}: Composer packages, plugins, structure and its design."|t('site7-studio', {theme: kitCheck.theme}) }}
                {{ "Then {pages} pages, menus and demo content."|t('site7-studio', {pages: kitCheck.meta.templates ?? ''}) }}</p>
        {% endif %}
        {% for w in kitCheck.warnings %}<p class="warning">{{ w }}</p>{% endfor %}
        {% if not kitCheck.errors %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('site7-studio/install-wizard/install-library-kit') }}
                {{ hiddenInput('handle', kitCheck.handle) }}
                <button type="submit" class="btn submit">{{ "Install"|t('site7-studio') }}</button>
                {% if not kitCheck.themeInstalled %}<span class="light">{{ "Takes a few minutes. Composer files, config/ and templates/ are backed up to storage/site7-studio/site-kit-backups/ first."|t('site7-studio') }}</span>{% endif %}
            </form>
        {% endif %}
    {% endif %}
</div>

{# Blueprint Starter Kits (docs/32) are the older kit system: Dev Mode only. #}
{% if kits is not empty and craft.app.config.general.devMode %}
<h2>Blueprint Starter Kits</h2>
<div id="s7-install-wizard" data-summary-url-template="{{ url('site7-studio/install/summary/__UID__') }}">

    <ol class="s7-wizard-steps">
        <li data-step="select" class="s7-wizard-step-indicator is-active">1. Select Starter Kit</li>
        <li data-step="validate" class="s7-wizard-step-indicator">2. Environment Validation</li>
        <li data-step="preview" class="s7-wizard-step-indicator">3. Installation Preview</li>
        <li data-step="execute" class="s7-wizard-step-indicator">4. Execute Installation</li>
        <li data-step="summary" class="s7-wizard-step-indicator">5. Summary</li>
    </ol>

    <section class="s7-wizard-panel" data-panel="select">
        <div class="pane">
            {% if kits is empty %}
                <p>No Starter Kit packages were found in this installation's <code>packages/</code> directory.</p>
            {% else %}
                <p>Select a Starter Kit to install on this Craft installation.</p>
                <div class="s7-kit-list">
                    {% for kit in kits %}
                        <div class="s7-kit-card{% if not kit.installable %} is-disabled{% endif %}" data-handle="{{ kit.handle }}">
                            <h2>{{ kit.name }} <span class="light">v{{ kit.version }}</span></h2>
                            <p>{{ kit.description }}</p>
                            <ul class="s7-kit-meta">
                                <li><strong>Craft:</strong> {{ kit.minimumCraftVersion ?: 'Not specified' }}</li>
                                <li><strong>PHP:</strong> {{ kit.minimumPhpVersion }}+</li>
                                <li><strong>Plugins:</strong> {{ kit.requiredPlugins|length }} required</li>
                            </ul>
                            {% if kit.notes is not empty %}
                                <ul class="s7-kit-notes">
                                    {% for note in kit.notes %}<li>{{ note }}</li>{% endfor %}
                                </ul>
                            {% endif %}
                            {% if kit.installable %}
                                <button type="button" class="btn s7-select-kit">Select</button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    <section class="s7-wizard-panel" data-panel="validate" hidden>
        <div class="pane">
            <h2>Environment Validation - <span data-bind="selectedKitName"></span></h2>
            <label class="s7-dry-run-toggle">
                <input type="checkbox" id="s7-dry-run" checked>
                Dry Run - validate and preview only, do not modify this Craft installation
            </label>
            <button type="button" class="btn submit" id="s7-run-validation">Validate Environment</button>
            <div id="s7-validation-results"></div>
        </div>
    </section>

    <section class="s7-wizard-panel" data-panel="preview" hidden>
        <div class="pane">
            <h2>Installation Preview</h2>
            <div id="s7-plan-preview"></div>
            <div class="buttons">
                <button type="button" class="btn" data-back-to="select">Back</button>
                <button type="button" class="btn submit" id="s7-start-install">Continue</button>
            </div>
        </div>
    </section>

    <section class="s7-wizard-panel" data-panel="execute" hidden>
        <div class="pane">
            <h2>Installing...</h2>
            <div class="s7-progress-bar"><div class="s7-progress-bar-fill" id="s7-progress-fill"></div></div>
            <ul id="s7-progress-log" class="s7-progress-log"></ul>
        </div>
    </section>

</div>
{% endif %}
{% endset %}
