{% extends "_layouts/cp" %}
{% set title = "Dashboard" %}
{% set selectedSubnavItem = "dashboard" %}

{% block content %}
    {% include "site7-studio/_components/plan-disabled-notice" %}
    <div class="site7-stat-grid">
        {% include "site7-studio/_components/stat-card" with {
            value: byType.section ?? 0,
            label: 'Sections',
            url: url('site7-studio/library', {type: 'section'}),
        } only %}
        {% include "site7-studio/_components/stat-card" with {
            value: byType.template ?? 0,
            label: 'Templates',
            url: url('site7-studio/library', {type: 'template'}),
        } only %}
        {% include "site7-studio/_components/stat-card" with {
            value: byType['starter-kit'] ?? 0,
            label: 'Starter Kits',
            url: url('site7-studio/library', {type: 'starter-kit'}),
        } only %}
    </div>

    <div class="pane">
        <h2>{{ "Platform Status"|t('site7-studio') }}</h2>
        <div class="meta">
            <div class="field">
                <div class="heading"><label>{{ "Page Builder"|t('site7-studio') }}</label></div>
                <div class="input">
                    {% if pageBuilder %}
                        <span class="status-label green"><span class="status green"></span><span class="status-label-text">{{ pageBuilder.name }}</span></span>
                    {% else %}
                        <span class="status-label red"><span class="status red"></span><span class="status-label-text">{{ "Not set"|t('site7-studio') }}</span></span>
                    {% endif %}
                </div>
            </div>
            <div class="field">
                <div class="heading"><label>{{ "Total Packages"|t('site7-studio') }}</label></div>
                <div class="input">{{ totalPackages ?? 0 }}</div>
            </div>
            <div class="field">
                <div class="heading"><label>{{ "Enabled"|t('site7-studio') }}</label></div>
                <div class="input">{{ byStatus.enabled ?? 0 }}</div>
            </div>
            {% if (byStatus.available ?? 0) > 0 %}
                <div class="field">
                    <div class="heading"><label>{{ "Available to Install"|t('site7-studio') }}</label></div>
                    <div class="input">{{ byStatus.available }}</div>
                </div>
            {% endif %}
            <div class="field">
                <div class="heading"><label>{{ "Plugin Version"|t('site7-studio') }}</label></div>
                <div class="input">{{ version ?? '1.0.0' }}</div>
            </div>
        </div>

        {% if not isSetupComplete %}
            <div class="site7-notice site7-notice--warning">
                <strong>{{ "No page builder yet."|t('site7-studio') }}</strong> {{ "Install a Starter Kit: its Theme brings the page builder."|t('site7-studio') }}
                {% if hasMatrixFields %}{{ "This site has its own Matrix field, so you can choose it as the page builder in Settings instead."|t('site7-studio') }}{% endif %}
                <br><br>
                <a href="{{ url('site7-studio/install') }}" class="btn submit">{{ "Install a Starter Kit"|t('site7-studio') }}</a>
                {% if hasMatrixFields %}
                    <a href="{{ url('site7-studio/settings') }}" class="btn">{{ "Choose in Settings"|t('site7-studio') }}</a>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <div class="site7-quick-actions">
        <h3>{{ "Quick Actions"|t('site7-studio') }}</h3>
        <div class="flex">
            <a href="{{ url('site7-studio/library') }}" class="btn submit">{{ "Browse Library"|t('site7-studio') }}</a>
            <a href="{{ url('site7-studio/library', {type: 'template'}) }}" class="btn">{{ "Templates"|t('site7-studio') }}</a>
            {% if isSetupComplete and craft.app.config.general.devMode %}
                <button type="button" class="btn" id="site7-save-as-starter-kit-btn">{{ "Save Current Site as Starter Kit"|t('site7-studio') }}</button>
            {% endif %}
            <a href="{{ url('site7-studio/settings') }}" class="btn">{{ "Settings"|t('site7-studio') }}</a>
        </div>
    </div>
{% endblock %}
