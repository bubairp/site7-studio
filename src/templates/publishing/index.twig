{% extends "_layouts/cp" %}
{% set selectedSubnavItem = "publishing" %}
{% set title = "Publishing"|t('site7-studio') %}

{% import "_includes/forms" as forms %}

{% block content %}
    {# The CP side of `site7-studio/library/publish` (docs/52, docs/53). #}
    {% if craft.app.config.general.devMode %}
        <section class="site7-detail-section" style="margin-bottom: 24px;">
            <h2>{{ "Publish the Library to Commerce24"|t('site7-studio') }}</h2>
            <p class="light">{{ "Publishes every Library package that changed since its last release, each as its own signed archive, with a new version. Unchanged packages are skipped."|t('site7-studio') }}</p>
            {% if not commerceConfigured %}
                <p class="warning">{{ "Commerce24 isn't connected."|t('site7-studio') }} <a href="{{ url('site7-studio/settings') }}#commerce">{{ "Set it up in Settings →"|t('site7-studio') }}</a></p>
            {% else %}
                <form method="post" accept-charset="UTF-8">
                    {{ csrfInput() }}
                    {{ actionInput('site7-studio/package-publisher/publish-library') }}
                    {{ forms.selectField({
                        label: 'Version bump'|t('site7-studio'),
                        instructions: 'How much to raise the version of each changed package.'|t('site7-studio'),
                        name: 'bump',
                        options: {patch: 'Patch (1.0.0 → 1.0.1)', minor: 'Minor (1.0.0 → 1.1.0)', major: 'Major (1.0.0 → 2.0.0)'},
                        value: 'patch',
                    }) }}
                    {{ forms.textareaField({
                        label: 'Release notes'|t('site7-studio'),
                        instructions: 'Shown to customers on their Updates screen.'|t('site7-studio'),
                        name: 'notes',
                        rows: 3,
                    }) }}
                    {{ forms.lightswitchField({
                        label: 'Publish unchanged packages too'|t('site7-studio'),
                        name: 'force',
                    }) }}
                    <button type="submit" class="btn submit">{{ "Publish Library"|t('site7-studio') }}</button>
                </form>
            {% endif %}
        </section>
    {% endif %}

    <section class="site7-detail-section" style="margin-bottom: 24px;">
        <h2>{{ "Repositories"|t('site7-studio') }}</h2>
        <p class="light">{{ "Where packages published from this site can go. Other repositories (private, enterprise) can be added the same way later."|t('site7-studio') }}</p>
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ "Repository"|t('site7-studio') }}</th>
                    <th scope="col">{{ "Status"|t('site7-studio') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for handle, target in targets %}
                    <tr>
                        <td>{{ target.getName() }}</td>
                        <td>
                            {% if target.supportsPublish() %}
                                <span class="status-label teal"><span class="status teal"></span><span class="status-label-text">{{ "Available"|t('site7-studio') }}</span></span>
                            {% else %}
                                <span class="status-label gray"><span class="status gray"></span><span class="status-label-text">{{ "Not Configured"|t('site7-studio') }}</span></span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="site7-detail-section">
        <h2>{{ "Publish History"|t('site7-studio') }}</h2>
        {% if history|length %}
            <table class="data fullwidth big">
                <thead>
                    <tr>
                        <th scope="col">{{ "Package"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Repository"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Version"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Status"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Downloads"|t('site7-studio') }}</th>
                        <th scope="col">{{ "Published"|t('site7-studio') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for publication in history %}
                        {% set pkg = publication.package %}
                        {% set statusColor = {published: 'teal', failed: 'red', unpublished: 'gray'}[publication.status] ?? 'gray' %}
                        <tr>
                            <th scope="row">
                                {% if pkg %}
                                    <a href="{{ url('site7-studio/library/package/' ~ pkg.handle) }}">{{ pkg.name }}</a>
                                    <div class="light smalltext"><code>{{ pkg.handle }}</code></div>
                                {% else %}
                                    <span class="light">{{ "Deleted package"|t('site7-studio') }}</span>
                                {% endif %}
                            </th>
                            <td>{{ publication.repositoryHandle }}</td>
                            <td>v{{ publication.version }}</td>
                            <td><span class="status-label {{ statusColor }}"><span class="status {{ statusColor }}"></span><span class="status-label-text">{{ publication.status|title }}</span></span></td>
                            <td class="light">{{ publication.downloadCount }}</td>
                            <td class="light">{{ publication.publishedAt }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if historyTotalPages > 1 %}
                <div class="flex pagination" style="margin-top: 12px;">
                    {% if historyPage > 1 %}
                        <a class="btn" href="{{ url('site7-studio/publishing', {page: historyPage - 1}) }}">← {{ "Newer"|t('site7-studio') }}</a>
                    {% endif %}
                    <span class="light">{{ "{first}–{last} of {total}"|t('site7-studio', {
                        first: (historyPage - 1) * historyPerPage + 1,
                        last: min(historyPage * historyPerPage, historyTotal),
                        total: historyTotal,
                    }) }}</span>
                    {% if historyPage < historyTotalPages %}
                        <a class="btn" href="{{ url('site7-studio/publishing', {page: historyPage + 1}) }}">{{ "Older"|t('site7-studio') }} →</a>
                    {% endif %}
                </div>
            {% endif %}
        {% else %}
            {% include "site7-studio/_components/empty-state" with {
                message: 'Nothing published yet.',
                subtext: 'Open a package in the Library and click Publish to get started.',
                icon: '🚀'
            } only %}
        {% endif %}
    </section>
{% endblock %}
